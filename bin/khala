#!/usr/bin/env bash
set -u

umask 077

if [ "${KHALA_HOME+x}" = x ]; then
    if [ -z "$KHALA_HOME" ]; then
        printf '%s\n' 'khala: KHALA_HOME is empty' >&2
        exit 1
    fi
    KHALA_ROOT=$KHALA_HOME
else
    if [ -z "${HOME-}" ]; then
        printf '%s\n' 'khala: HOME is not set' >&2
        exit 1
    fi
    KHALA_ROOT=$HOME/.khala
fi

CONFIG=$KHALA_ROOT/config
TMP_DIR=$KHALA_ROOT/tmp
SYNC_FAILED=0
EPOCH_DATE_STYLE=
LOCK_HELD_PATHS=()
TTL_LINK=12
# Display-only semantic freshness; storage lifetime remains config retain.
MIND_FRESH_SECONDS=3600
KHALA_VERSION=0.8.2
TAB=$(printf '\t')
LC_ALL=C
export LC_ALL
PRESERVE_CONFIG_LOADED=0
PRESERVER_ENABLED=0
PRESERVE_CONFIG_INVALID=0
PRESERVE_STREAMS=
PRESERVER_DEGRADED=0
PRESERVER_READY=0
SYNC_DIR_STYLE=

error() {
    printf 'khala: %s\n' "$*" >&2
}

usage() {
    case "${1-}" in
        version) printf '%s\n' 'usage: khala version'; return 0 ;;
        init) printf '%s\n' 'usage: khala init <node>'; return 0 ;;
        invite)
            printf '%s\n' 'usage: khala invite <ssh-target> --name <alias> [--mailbox-coord <user@host>]'
            return 0
            ;;
        send)
            printf '%s\n' 'usage: khala send <session@node> [-s|--subject subject] [-e seconds] [-m|--message|--body message] [--reply-to Id] [--later] [--as session]'
            return 0
            ;;
        notify)
            printf '%s\n' 'usage: khala notify <session@node> --as <watcher> [-s|--subject subject] [--urgent] [-e seconds]'
            return 0
            ;;
        say)
            printf '%s\n' 'usage: khala say [stream] [-s|--subject subject] [-r ref-id] [-m|--message|--body message]'
            return 0
            ;;
        join) printf '%s\n' 'usage: khala join <stream> [--from-start] [--quiet]'; return 0 ;;
        leave) printf '%s\n' 'usage: khala leave <stream>'; return 0 ;;
        streams) printf '%s\n' 'usage: khala streams'; return 0 ;;
        stream) printf '%s\n' 'usage: khala stream cat <stream> [-n N]'; return 0 ;;
        mind) printf '%s\n' 'usage: khala mind (-m focus [--stance stance] | --clear)'; return 0 ;;
        profile)
            printf '%s\n' 'usage: khala profile [--model model] [--effort effort] [--role role] [--charge charge]'
            return 0
            ;;
        minds) printf '%s\n' 'usage: khala minds'; return 0 ;;
        watcher)
            printf '%s\n' 'usage: khala watcher declare <name> --cadence <seconds> --owner <session@node>'
            printf '%s\n' '       khala watcher beat <name>'
            printf '%s\n' '       khala watcher list'
            printf '%s\n' '       khala watcher retire <name>'
            return 0
            ;;
        retire) printf '%s\n' 'usage: khala retire <session>'; return 0 ;;
        reconcile) printf '%s\n' 'usage: khala reconcile'; return 0 ;;
        sync) printf '%s\n' 'usage: khala sync'; return 0 ;;
        link)
            printf '%s\n' 'usage: khala link [restart] [--max-object-bytes bytes]'
            printf '%s\n' '       khala link --serve [--max-object-bytes bytes]'
            return 0
            ;;
        watch)
            printf '%s\n' 'usage: khala watch [--session session] [--interval seconds] [--max-wait seconds]'
            return 0
            ;;
        inbox)
            printf '%s\n' 'usage: khala inbox [list | read <Id> | --drain [--max-n N] [--max-bytes B] [--max-notices N] [--max-notice-bytes B] [--mail-only|--notices-only]]'
            return 0
            ;;
        presence) printf '%s\n' 'usage: khala presence [--watchers]'; return 0 ;;
    esac
    cat >&2 <<'EOF'
usage:
  khala version
  khala init <node>
  khala invite <ssh-target> --name <alias> [--mailbox-coord <user@host>]
  khala send <session@node> [-s|--subject subject] [-e seconds] [-m|--message|--body message] [--reply-to Id] [--later] [--as session]
  khala notify <session@node> --as <watcher> [-s|--subject subject] [--urgent] [-e seconds]
  khala say [stream] [-s|--subject subject] [-r ref-id] [-m|--message|--body message]
  khala join <stream> [--from-start] [--quiet]
  khala leave <stream>
  khala streams
  khala stream cat <stream> [-n N]
  khala mind (-m focus [--stance stance] | --clear)
  khala profile [--model model] [--effort effort] [--role role] [--charge charge]
  khala minds
  khala watcher declare <name> --cadence <seconds> --owner <session@node>
  khala watcher beat <name>
  khala watcher list
  khala watcher retire <name>
  khala retire <session>
  khala reconcile
  khala sync
  khala link [restart] [--max-object-bytes bytes]
  khala link --serve [--max-object-bytes bytes]
  khala watch [--session session] [--interval seconds] [--max-wait seconds]
  khala inbox [list | read <Id> | --drain [--max-n N] [--max-bytes B] [--max-notices N] [--max-notice-bytes B] [--mail-only|--notices-only]]
  khala presence [--watchers]
EOF
}

require_config() {
    if [ ! -f "$CONFIG" ]; then
        error "설정이 없습니다. khala init 먼저 실행하세요."
        return 1
    fi
    return 0
}

valid_name() {
    case "$1" in
        ''|-*|*[!a-z0-9-]*) return 1 ;;
    esac
    return 0
}

valid_address() {
    case "$1" in
        *@*@*) return 1 ;;
        *@*) ;;
        *) return 1 ;;
    esac
    valid_name "${1%%@*}" && valid_name "${1#*@}"
}

valid_message_id() {
    case "$1" in
        *.*.*.*@*) ;;
        *) return 1 ;;
    esac
    message_id_rest=$1
    message_id_epoch=${message_id_rest%%.*}
    message_id_rest=${message_id_rest#*.}
    message_id_counter=${message_id_rest%%.*}
    message_id_rest=${message_id_rest#*.}
    message_id_pid=${message_id_rest%%.*}
    message_id_rest=${message_id_rest#*.}
    positive_or_zero_integer "$message_id_epoch" && \
        positive_or_zero_integer "$message_id_counter" && \
        positive_or_zero_integer "$message_id_pid" && \
        valid_address "$message_id_rest"
}

positive_or_zero_integer() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

positive_integer() {
    positive_or_zero_integer "$1" || return 1
    [ "$1" -gt 0 ] 2>/dev/null
}

# The helpers below run inside reconcile loops that visit every file on every
# pass (0.8.1: a pass is a hot path, once a second under the link). They are
# pure shell on purpose: one fork per value, times a few values per file, times
# hundreds of files, is what held the brain lock for whole seconds. LC_ALL=C is
# pinned above, so the bracket ranges in these case patterns are ASCII.
normalize_integer() {
    normalized=$1
    while case "$normalized" in 0?*) true ;; *) false ;; esac; do
        normalized=${normalized#0}
    done
    if [ -z "$normalized" ]; then
        normalized=0
    fi
    printf '%s\n' "$normalized"
}

# A digits-only check is not enough for shell arithmetic: a 40-digit value
# passes positive_or_zero_integer and then wraps or errors inside $((...)).
# Bound every epoch, cadence, and lifetime the 0.8.0 code adds to 18 digits.
bounded_integer() {
    positive_or_zero_integer "$1" || return 1
    bounded_value=$(normalize_integer "$1")
    [ "${#bounded_value}" -le 18 ]
}

retain_days() {
    retained=$(sed -n 's/^retain //p' "$CONFIG")
    if [ -z "$retained" ]; then
        retained=30
    fi
    if ! positive_or_zero_integer "$retained"; then
        error "config의 retain이 0 이상의 정수가 아닙니다"
        return 1
    fi
    normalize_integer "$retained"
}

# Age-out sweeps (expired notices, aged cur/acked/dead, delivered log, and the
# retention deletions of streams, minds and presence) answer "older than N
# days?" — a question whose answer does not change between two passes a second
# apart. 0.8.0 ran them on every reconcile, and the link reconciles once a
# second while fresh; on a node with a few hundred letters that held
# brain.lock.d for 6-8 s of every 10, and every drain/notify on the node waited
# out its 60 attempts (2026-09-02). Delivery, acks, dead-man, expiry of
# outbox/new, preserve capture, validation/quarantine and the mind generation
# GC stay on every pass; only the age-out sweeps wait for `retention-interval`
# seconds (300 by default; 0 = every pass) measured from run/retention.stamp.
retention_interval_seconds() {
    retention_interval=$(sed -n 's/^retention-interval //p' "$CONFIG")
    if [ -z "$retention_interval" ]; then
        retention_interval=300
    fi
    if ! bounded_integer "$retention_interval"; then
        error "config의 retention-interval이 0 이상 18자리 이하의 정수가 아닙니다"
        return 1
    fi
    normalize_integer "$retention_interval"
}

# True when the age-out sweeps are due; stamps the pass so the next one waits.
# A missing or unreadable stamp means due (a fresh node prunes on its first
# pass); a stamp from the future (clock step) also means due, never a lockout.
retention_due() {
    retention_due_interval=$1
    retention_stamp=$KHALA_ROOT/run/retention.stamp
    if [ "$retention_due_interval" -gt 0 ] && [ -f "$retention_stamp" ]; then
        retention_now=$(date +%s) || return 0
        retention_last=$(file_mtime "$retention_stamp") || retention_last=
        if bounded_integer "${retention_last-}" && \
            [ "$retention_last" -le "$retention_now" ] && \
            [ "$((retention_now - retention_last))" -lt "$retention_due_interval" ]; then
            return 1
        fi
    fi
    touch "$retention_stamp" 2>/dev/null || :
    return 0
}

file_mtime() {
    mtime_path=$1
    mtime_value=$(stat -c %Y "$mtime_path" 2>/dev/null) || mtime_value=
    if positive_or_zero_integer "$mtime_value"; then
        printf '%s\n' "$mtime_value"
        return 0
    fi
    mtime_value=$(stat -f %m "$mtime_path" 2>/dev/null) || mtime_value=
    if positive_or_zero_integer "$mtime_value"; then
        printf '%s\n' "$mtime_value"
        return 0
    fi
    return 1
}

self_node() {
    node=$(sed -n 's/^self //p' "$CONFIG")
    if ! valid_name "$node"; then
        error "config의 self 항목이 없거나 잘못되었습니다"
        return 1
    fi
    printf '%s\n' "$node"
}

session_name() {
    explicit=${1-}
    explicit_set=${2-0}
    if [ "$explicit_set" -eq 1 ]; then
        session=$explicit
    elif [ "${KHALA_SESSION+x}" = x ] && [ -n "$KHALA_SESSION" ]; then
        session=$KHALA_SESSION
    else
        if [ "${KHALA_SESSION+x}" = x ]; then
            printf '%s\n' 'khala: KHALA_SESSION이 비어 있어 설정되지 않은 것으로 취급합니다' >&2
        fi
        if [ -n "${PWD-}" ] && [ -f "$PWD/.khala-session" ] && \
        session_file=$(sed -n '1p' "$PWD/.khala-session") && \
        [ "$(wc -l < "$PWD/.khala-session" | tr -d ' ')" -le 1 ] && \
        valid_name "$session_file"; then
        # The checkout's declared identity: the same one-line .khala-session
        # the hooks read. Without this step a bare CLI send in a hook-managed
        # checkout silently completes under the directory basename instead.
            session=$session_file
        else
            error "세션 이름을 정할 수 없습니다; KHALA_SESSION을 설정하거나 .khala-session을 만들거나 --as를 지정하세요"
            return 1
        fi
    fi
    if ! valid_name "$session"; then
        error "잘못된 세션 이름: $session"
        return 1
    fi
    printf '%s\n' "$session"
}

# Every "Key: value" line of the header block (up to the first empty line),
# in file order, values only. A file without a trailing newline still yields
# its last line.
header_value() {
    key=$1
    file=$2
    while IFS= read -r header_line || [ -n "$header_line" ]; do
        [ -n "$header_line" ] || break
        case "$header_line" in
            "$key: "*) printf '%s\n' "${header_line#"$key: "}" ;;
        esac
    done < "$file"
}

# Number of lines anywhere in the file (header and body) starting with the
# literal prefix — the fork-free twin of `grep -c "^prefix"`.
line_prefix_count() {
    prefix=$1
    file=$2
    prefix_count=0
    while IFS= read -r prefix_line || [ -n "$prefix_line" ]; do
        case "$prefix_line" in
            "$prefix"*) prefix_count=$((prefix_count + 1)) ;;
        esac
    done < "$file"
    printf '%s\n' "$prefix_count"
}

atomic_copy() {
    source_file=$1
    destination_file=$2
    copy_tmp=$(mktemp "$TMP_DIR/copy.XXXXXX") || return 1
    if ! cp "$source_file" "$copy_tmp"; then
        rm -f "$copy_tmp"
        return 1
    fi
    if ln "$copy_tmp" "$destination_file" 2>/dev/null; then
        rm -f "$copy_tmp"
        return 0
    fi
    if [ -e "$destination_file" ]; then
        rm -f "$copy_tmp"
        return 0
    fi
    rm -f "$copy_tmp"
    error "$destination_file: 원자 no-clobber 설치에 실패했습니다"
    return 1
}

atomic_line() {
    line_destination=$1
    line_value=$2
    line_kind=$3
    line_parent=$(dirname "$line_destination") || return 1
    if ! mkdir -p "$line_parent"; then
        return 1
    fi
    line_tmp=$(mktemp "$TMP_DIR/$line_kind.XXXXXX") || return 1
    if ! printf '%s\n' "$line_value" > "$line_tmp"; then
        rm -f "$line_tmp"
        return 1
    fi
    if ! mv "$line_tmp" "$line_destination"; then
        rm -f "$line_tmp"
        return 1
    fi
    return 0
}

read_watcher_marker() {
    watcher_read_file=$1
    [ -f "$watcher_read_file" ] || return 1
    # Exactly five or six newline-terminated lines (a partial trailing line is
    # ignored, as `wc -l` would have ignored it); read in one pass, no forks —
    # this runs for every marker on every reconcile.
    watcher_read_n=0
    watcher_read_1= watcher_read_2= watcher_read_3= watcher_read_4= watcher_read_5=
    watcher_read_6=
    while IFS= read -r watcher_read_line; do
        watcher_read_n=$((watcher_read_n + 1))
        case "$watcher_read_n" in
            1) watcher_read_1=$watcher_read_line ;;
            2) watcher_read_2=$watcher_read_line ;;
            3) watcher_read_3=$watcher_read_line ;;
            4) watcher_read_4=$watcher_read_line ;;
            5) watcher_read_5=$watcher_read_line ;;
            6) watcher_read_6=$watcher_read_line ;;
            *) return 1 ;;
        esac
    done < "$watcher_read_file"
    [ "$watcher_read_n" -eq 5 ] || [ "$watcher_read_n" -eq 6 ] || return 1
    watcher_read_retired=0
    case "$watcher_read_1" in
        retired\ *)
            watcher_read_declared=${watcher_read_1#retired }
            watcher_read_retired=1
            ;;
        *) watcher_read_declared=$watcher_read_1 ;;
    esac
    bounded_integer "$watcher_read_declared" || return 1
    bounded_integer "$watcher_read_2" || return 1
    case "$watcher_read_3" in
        -) ;;
        *) valid_address "$watcher_read_3" || valid_name "$watcher_read_3" || return 1 ;;
    esac
    bounded_integer "$watcher_read_4" || return 1
    case "$watcher_read_5" in
        active)
            [ "$watcher_read_n" -eq 6 ] || watcher_read_6=$watcher_read_declared
            ;;
        silent\ *)
            watcher_read_silent_since=${watcher_read_5#silent }
            bounded_integer "$watcher_read_silent_since" || return 1
            [ "$watcher_read_n" -eq 6 ] || watcher_read_6=$watcher_read_silent_since
            ;;
        *) return 1 ;;
    esac
    bounded_integer "$watcher_read_6" || return 1
    watcher_read_declared_normalized=$(normalize_integer "$watcher_read_declared")
    watcher_read_cadence=$(normalize_integer "$watcher_read_2")
    watcher_read_last_notify=$(normalize_integer "$watcher_read_4")
    watcher_read_state_since=$(normalize_integer "$watcher_read_6")
    WATCHER_L1=$watcher_read_1
    WATCHER_L2=$watcher_read_2
    WATCHER_L3=$watcher_read_3
    WATCHER_L4=$watcher_read_4
    WATCHER_L5=$watcher_read_5
    WATCHER_L6=$watcher_read_6
    WATCHER_RETIRED=$watcher_read_retired
    WATCHER_DECLARED=$watcher_read_declared_normalized
    WATCHER_CADENCE=$watcher_read_cadence
    WATCHER_LAST_NOTIFY=$watcher_read_last_notify
    WATCHER_STATE_SINCE=$watcher_read_state_since
    return 0
}

write_watcher_marker() {
    watcher_write_file=$1
    watcher_write_l1=$2
    watcher_write_l2=$3
    watcher_write_l3=$4
    watcher_write_l4=$5
    watcher_write_l5=$6
    watcher_write_l6=$7
    watcher_write_tmp=$(mktemp "$TMP_DIR/watcher.XXXXXX") || return 1
    if ! printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$watcher_write_l1" "$watcher_write_l2" \
        "$watcher_write_l3" "$watcher_write_l4" "$watcher_write_l5" "$watcher_write_l6" \
        > "$watcher_write_tmp"; then
        rm -f "$watcher_write_tmp"
        return 1
    fi
    if ! mv "$watcher_write_tmp" "$watcher_write_file"; then
        rm -f "$watcher_write_tmp"
        return 1
    fi
    return 0
}

watcher_marker_non_retired() {
    watcher_live_file=$1
    [ -f "$watcher_live_file" ] || return 1
    watcher_live_l1=$(sed -n '1p' "$watcher_live_file")
    case "$watcher_live_l1" in
        retired*) return 1 ;;
        *) return 0 ;;
    esac
}

detect_epoch_date_style() {
    [ -z "$EPOCH_DATE_STYLE" ] || return 0
    epoch_probe=$(date -u -r 0 '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || epoch_probe=
    if [ "$epoch_probe" = 1970-01-01T00:00:00Z ]; then
        EPOCH_DATE_STYLE=bsd
        return 0
    fi
    epoch_probe=$(date -u -d @0 '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || epoch_probe=
    if [ "$epoch_probe" = 1970-01-01T00:00:00Z ]; then
        EPOCH_DATE_STYLE=gnu
        return 0
    fi
    error "date가 epoch→ISO8601 변환의 BSD/GNU 형식을 지원하지 않습니다"
    return 1
}

epoch_to_iso() {
    epoch_value=$1
    case "$EPOCH_DATE_STYLE" in
        bsd) date -u -r "$epoch_value" '+%Y-%m-%dT%H:%M:%SZ' ;;
        gnu) date -u -d "@$epoch_value" '+%Y-%m-%dT%H:%M:%SZ' ;;
        *) error "epoch→ISO8601 플랫폼 형식을 먼저 감지하지 않았습니다"; return 1 ;;
    esac
}

acquire_lock() {
    lock_path=$1
    lock_stale_after=$2
    lock_what=$3
    lock_attempt_limit=240
    lock_retry_delay=0.25
    if [ "$lock_what" = reconcile ]; then
        lock_attempt_limit=60
        lock_retry_delay=1
        if [ "${KHALA_LINK_SCAN_GATE-}" = 1 ]; then
            lock_attempt_limit=3
        fi
    fi
    if ! mkdir -p "$KHALA_ROOT/run" || ! chmod 700 "$KHALA_ROOT/run"; then
        error "$KHALA_ROOT/run: lock 디렉터리를 준비하지 못했습니다"
        return 1
    fi
    lock_attempt=0
    while [ "$lock_attempt" -lt "$lock_attempt_limit" ]; do
        if mkdir "$lock_path" 2>/dev/null; then
            lock_now=$(date +%s) || {
                rmdir "$lock_path" 2>/dev/null || :
                return 1
            }
            lock_owner_tmp=$lock_path/owner.tmp.$$
            if ! printf '%s\npid %s %s\n' "$lock_now" "$$" "$lock_what" \
                > "$lock_owner_tmp" || ! mv "$lock_owner_tmp" "$lock_path/owner"; then
                rm -f "$lock_owner_tmp"
                rmdir "$lock_path" 2>/dev/null || :
                error "$lock_path: lock owner를 기록하지 못했습니다"
                return 1
            fi
            lock_held_index=${#LOCK_HELD_PATHS[@]}
            LOCK_HELD_PATHS[$lock_held_index]=$lock_path
            return 0
        fi
        lock_now=$(date +%s) || return 1
        lock_owner_epoch=$(sed -n '1p' "$lock_path/owner" 2>/dev/null)
        lock_owner_line=$(sed -n '2p' "$lock_path/owner" 2>/dev/null)
        set -- $lock_owner_line
        lock_owner_pid=${2-unknown}
        if positive_or_zero_integer "$lock_owner_epoch" && \
            [ "$((lock_now - lock_owner_epoch))" -gt "$lock_stale_after" ]; then
            if ! rm -rf -- "$lock_path"; then
                error "$lock_path: stale lock을 회수하지 못했습니다"
                return 1
            fi
            error "reclaimed stale lock from pid $lock_owner_pid"
            continue
        fi
        lock_attempt=$((lock_attempt + 1))
        [ "$lock_attempt" -lt "$lock_attempt_limit" ] || break
        sleep "$lock_retry_delay"
    done
    error "$lock_path: ${lock_attempt_limit}회 시도 후에도 lock을 얻지 못했습니다"
    return 1
}

release_lock() {
    release_path=$1
    release_held_count=${#LOCK_HELD_PATHS[@]}
    if [ "$release_held_count" -eq 0 ]; then
        error "$release_path: 소유하지 않은 lock을 해제하려 했습니다"
        return 1
    fi
    release_held_index=$((release_held_count - 1))
    if [ "${LOCK_HELD_PATHS[$release_held_index]}" != "$release_path" ]; then
        error "$release_path: 소유하지 않은 lock을 해제하려 했습니다"
        return 1
    fi
    release_owner_line=$(sed -n '2p' "$release_path/owner" 2>/dev/null)
    set -- $release_owner_line
    release_owner_pid=${2-}
    if [ "$release_owner_pid" != "$$" ]; then
        error "$release_path: 다른 process의 lock은 해제할 수 없습니다"
        return 1
    fi
    if ! rm -f "$release_path/owner" || ! rmdir "$release_path"; then
        error "$release_path: lock을 해제하지 못했습니다"
        return 1
    fi
    unset 'LOCK_HELD_PATHS[release_held_index]'
    return 0
}

release_held_locks() {
    lock_cleanup_failed=0
    while [ "${#LOCK_HELD_PATHS[@]}" -gt 0 ]; do
        lock_cleanup_index=$((${#LOCK_HELD_PATHS[@]} - 1))
        lock_cleanup_path=${LOCK_HELD_PATHS[$lock_cleanup_index]}
        if ! release_lock "$lock_cleanup_path"; then
            unset 'LOCK_HELD_PATHS[lock_cleanup_index]'
            lock_cleanup_failed=1
        fi
    done
    [ "$lock_cleanup_failed" -eq 0 ]
}

lock_exit_cleanup() {
    lock_cleanup_status=$?
    release_held_locks || :
    return "$lock_cleanup_status"
}

lock_signal_cleanup() {
    lock_cleanup_signal=$1
    release_held_locks || :
    trap - "$lock_cleanup_signal"
    case "$lock_cleanup_signal" in
        INT) exit 130 ;;
        TERM) exit 143 ;;
        PIPE) exit 141 ;;
    esac
}

trap 'lock_exit_cleanup' EXIT
trap 'lock_signal_cleanup INT' INT
trap 'lock_signal_cleanup TERM' TERM
trap 'lock_signal_cleanup PIPE' PIPE

heartbeat() {
    heartbeat_session=$1
    heartbeat_node=$(self_node) || return 1
    heartbeat_tmp=$(mktemp "$TMP_DIR/heartbeat.XXXXXX") || return 1
    if ! date +%s > "$heartbeat_tmp"; then
        rm -f "$heartbeat_tmp"
        return 1
    fi
    if ! mv "$heartbeat_tmp" "$KHALA_ROOT/presence/$heartbeat_session@$heartbeat_node"; then
        rm -f "$heartbeat_tmp"
        return 1
    fi
    return 0
}

refresh_watching_marker() {
    watching_tmp=$(mktemp "$TMP_DIR/watching.XXXXXX") || return 1
    watching_epoch=$(date +%s) || {
        rm -f "$watching_tmp"
        return 1
    }
    if ! printf '%s\n%s\n' "$watching_epoch" "$watch_interval" > "$watching_tmp"; then
        rm -f "$watching_tmp"
        return 1
    fi
    if ! mv "$watching_tmp" "$watch_marker"; then
        rm -f "$watching_tmp"
        return 1
    fi
    return 0
}

refresh_watch_lock() {
    watch_lock_now=$(date +%s) || return 1
    watch_lock_tmp=$watch_lock/owner.tmp.$$
    if ! printf '%s\npid %s watch\n%s\n' "$watch_lock_now" "$$" \
        "$watch_interval" > "$watch_lock_tmp"; then
        rm -f "$watch_lock_tmp"
        return 1
    fi
    if ! mv "$watch_lock_tmp" "$watch_lock/owner"; then
        rm -f "$watch_lock_tmp"
        return 1
    fi
    return 0
}

acquire_watch_lock() {
    if ! mkdir -p "$KHALA_ROOT/run" || ! chmod 700 "$KHALA_ROOT/run"; then
        error "$KHALA_ROOT/run: watch lock 디렉터리를 준비하지 못했습니다"
        return 1
    fi
    watch_lock_attempt=0
    while [ "$watch_lock_attempt" -lt 3 ]; do
        if mkdir "$watch_lock" 2>/dev/null; then
            if ! refresh_watch_lock; then
                rm -f "$watch_lock/owner"
                rmdir "$watch_lock" 2>/dev/null || :
                error "$watch_lock: watch lock owner를 기록하지 못했습니다"
                return 1
            fi
            return 0
        fi
        watch_owner_epoch=$(sed -n '1p' "$watch_lock/owner" 2>/dev/null)
        watch_owner_line=$(sed -n '2p' "$watch_lock/owner" 2>/dev/null)
        watch_owner_interval=$(sed -n '3p' "$watch_lock/owner" 2>/dev/null)
        set -- $watch_owner_line
        watch_owner_pid=${2-}
        if ! positive_or_zero_integer "$watch_owner_epoch" || \
            ! positive_or_zero_integer "$watch_owner_pid" || \
            ! positive_integer "$watch_owner_interval"; then
            error "$watch_lock: 잘못된 watch lock owner"
            return 1
        fi
        watch_lock_now=$(date +%s) || return 1
        watch_stale_after=$((2 * (watch_owner_interval + watch_ttl)))
        if [ "$((watch_lock_now - watch_owner_epoch))" -gt "$watch_stale_after" ]; then
            if ! rm -rf -- "$watch_lock"; then
                error "$watch_lock: stale watch lock을 회수하지 못했습니다"
                return 1
            fi
            error "reclaimed stale watch lock from pid $watch_owner_pid"
            watch_lock_attempt=$((watch_lock_attempt + 1))
            continue
        fi
        printf '이미 감시 중: %s (pid %s)\n' "$watch_session" "$watch_owner_pid"
        return 2
    done
    error "$watch_lock: watch lock 획득 경쟁에서 이기지 못했습니다"
    return 1
}

watch_marker_cleanup() {
    watch_cleanup_status=$?
    watch_cleanup_event=$1
    trap - EXIT INT TERM
    if ! release_held_locks; then
        error "watch 종료 중 brain lock을 해제하지 못했습니다"
    fi
    if ! rm -f "$watch_marker"; then
        error "$watch_marker: watching marker를 지우지 못했습니다"
    fi
    if ! rm -f "$watch_lock/owner" || ! rmdir "$watch_lock"; then
        error "$watch_lock: watch lock을 지우지 못했습니다"
    fi
    case "$watch_cleanup_event" in
        INT) exit 130 ;;
        TERM) exit 143 ;;
    esac
    return "$watch_cleanup_status"
}

watching_status() {
    watching_file=$1
    watching_now=$2
    watching_ttl=$3
    if [ ! -f "$watching_file" ]; then
        printf '%s\n' '-'
        return 0
    fi
    watching_marker_epoch=$(sed -n '1p' "$watching_file")
    watching_marker_interval=$(sed -n '2p' "$watching_file")
    if ! positive_or_zero_integer "$watching_marker_epoch" || \
        ! positive_integer "$watching_marker_interval"; then
        error "$watching_file: 잘못된 watching marker"
        printf '%s\n' '-'
        return 0
    fi
    watching_marker_epoch=$(normalize_integer "$watching_marker_epoch")
    watching_marker_interval=$(normalize_integer "$watching_marker_interval")
    if [ "$((watching_now - watching_marker_epoch))" -le \
        "$((watching_marker_interval + watching_ttl))" ]; then
        printf '%s\n' yes
    else
        printf '%s\n' '-'
    fi
    return 0
}

new_message_id() {
    id_from=$1
    id_now=$(date +%s) || return 1
    printf '%s.%s.%s.%s\n' "$id_now" "$$" "$RANDOM" "$id_from"
}

valid_generation() {
    case "$1" in
        *.*.*) return 1 ;;
        *.*) ;;
        *) return 1 ;;
    esac
    for generation_part in "${1%%.*}" "${1#*.}"; do
        case "$generation_part" in
            0) ;;
            [1-9]*) positive_or_zero_integer "$generation_part" || return 1 ;;
            *) return 1 ;;
        esac
    done
    return 0
}

valid_mind_value() {
    case "$1" in
        *'
'*|*'
'*) return 1 ;;
        *) return 0 ;;
    esac
}

validate_mind_file() {
    mind_file=$1
    mind_expected_node=$2
    mind_expected_session=$3
    mind_expected_generation=$4
    if ! valid_name "$mind_expected_node" || ! valid_name "$mind_expected_session" || \
        ! valid_generation "$mind_expected_generation"; then
        return 1
    fi
    # One pass over the whole file (it runs for every mind generation on every
    # reconcile): a header value comes from the block before the first empty
    # line, while every line of the file — body included — counts toward the
    # exactly-once rule, as the grep -c this replaces did.
    mind_in_header=1
    mind_generation= mind_session= mind_node= mind_state=
    mind_declared_state= mind_declared_model= mind_declared_effort= mind_declared_role=
    mind_declared_charge= mind_declared_focus= mind_declared_stance=
    mind_n_generation=0 mind_n_session=0 mind_n_node=0 mind_n_state=0 mind_n_model=0
    mind_n_effort=0 mind_n_role=0 mind_n_charge=0 mind_n_focus=0 mind_n_stance=0
    mind_n_declared_state=0 mind_n_declared_model=0 mind_n_declared_effort=0
    mind_n_declared_role=0 mind_n_declared_charge=0 mind_n_declared_focus=0
    mind_n_declared_stance=0
    while IFS= read -r mind_line || [ -n "$mind_line" ]; do
        if [ -z "$mind_line" ]; then
            mind_in_header=0
            continue
        fi
        case "$mind_line" in
            "Generation: "*)
                mind_n_generation=$((mind_n_generation + 1))
                [ "$mind_in_header" -eq 0 ] || mind_generation=${mind_line#"Generation: "} ;;
            "Session: "*)
                mind_n_session=$((mind_n_session + 1))
                [ "$mind_in_header" -eq 0 ] || mind_session=${mind_line#"Session: "} ;;
            "Node: "*)
                mind_n_node=$((mind_n_node + 1))
                [ "$mind_in_header" -eq 0 ] || mind_node=${mind_line#"Node: "} ;;
            "State: "*)
                mind_n_state=$((mind_n_state + 1))
                [ "$mind_in_header" -eq 0 ] || mind_state=${mind_line#"State: "} ;;
            "Model: "*) mind_n_model=$((mind_n_model + 1)) ;;
            "Effort: "*) mind_n_effort=$((mind_n_effort + 1)) ;;
            "Role: "*) mind_n_role=$((mind_n_role + 1)) ;;
            "Charge: "*) mind_n_charge=$((mind_n_charge + 1)) ;;
            "Focus: "*) mind_n_focus=$((mind_n_focus + 1)) ;;
            "Stance: "*) mind_n_stance=$((mind_n_stance + 1)) ;;
            "Declared-State: "*)
                mind_n_declared_state=$((mind_n_declared_state + 1))
                [ "$mind_in_header" -eq 0 ] || mind_declared_state=${mind_line#"Declared-State: "} ;;
            "Declared-Model: "*)
                mind_n_declared_model=$((mind_n_declared_model + 1))
                [ "$mind_in_header" -eq 0 ] || mind_declared_model=${mind_line#"Declared-Model: "} ;;
            "Declared-Effort: "*)
                mind_n_declared_effort=$((mind_n_declared_effort + 1))
                [ "$mind_in_header" -eq 0 ] || mind_declared_effort=${mind_line#"Declared-Effort: "} ;;
            "Declared-Role: "*)
                mind_n_declared_role=$((mind_n_declared_role + 1))
                [ "$mind_in_header" -eq 0 ] || mind_declared_role=${mind_line#"Declared-Role: "} ;;
            "Declared-Charge: "*)
                mind_n_declared_charge=$((mind_n_declared_charge + 1))
                [ "$mind_in_header" -eq 0 ] || mind_declared_charge=${mind_line#"Declared-Charge: "} ;;
            "Declared-Focus: "*)
                mind_n_declared_focus=$((mind_n_declared_focus + 1))
                [ "$mind_in_header" -eq 0 ] || mind_declared_focus=${mind_line#"Declared-Focus: "} ;;
            "Declared-Stance: "*)
                mind_n_declared_stance=$((mind_n_declared_stance + 1))
                [ "$mind_in_header" -eq 0 ] || mind_declared_stance=${mind_line#"Declared-Stance: "} ;;
        esac
    done < "$mind_file"
    for mind_count in "$mind_n_generation" "$mind_n_session" "$mind_n_node" "$mind_n_state" \
        "$mind_n_model" "$mind_n_effort" "$mind_n_role" "$mind_n_charge" "$mind_n_focus" \
        "$mind_n_stance" "$mind_n_declared_state" "$mind_n_declared_model" \
        "$mind_n_declared_effort" "$mind_n_declared_role" "$mind_n_declared_charge" \
        "$mind_n_declared_focus" "$mind_n_declared_stance"; do
        [ "$mind_count" -eq 1 ] || return 1
    done
    [ "$mind_generation" = "$mind_expected_generation" ] || return 1
    [ "$mind_session" = "$mind_expected_session" ] || return 1
    [ "$mind_node" = "$mind_expected_node" ] || return 1
    case "$mind_state" in
        active|cleared) ;;
        *) return 1 ;;
    esac
    for mind_declared in "$mind_declared_state" "$mind_declared_model" "$mind_declared_effort" \
        "$mind_declared_role" "$mind_declared_charge" "$mind_declared_focus" "$mind_declared_stance"; do
        positive_or_zero_integer "$mind_declared" || return 1
    done
    return 0
}

current_mind_generation() {
    current_mind_node=$1
    current_mind_session=$2
    current_mind_dir=$KHALA_ROOT/minds/$current_mind_node/$current_mind_session
    current_mind_found=0
    current_mind_epoch=0
    current_mind_counter=0
    current_mind_path=
    for current_candidate in "$current_mind_dir"/*; do
        [ -f "$current_candidate" ] || continue
        current_generation=${current_candidate##*/}
        if ! valid_generation "$current_generation" || \
            ! validate_mind_file "$current_candidate" "$current_mind_node" \
                "$current_mind_session" "$current_generation"; then
            error "$current_candidate: 잘못된 mind generation"
            return 1
        fi
        current_epoch=$(normalize_integer "${current_generation%%.*}")
        current_counter=$(normalize_integer "${current_generation#*.}")
        if [ "$current_mind_found" -eq 0 ] || [ "$current_epoch" -gt "$current_mind_epoch" ] || \
            { [ "$current_epoch" -eq "$current_mind_epoch" ] && \
                [ "$current_counter" -gt "$current_mind_counter" ]; }; then
            current_mind_found=1
            current_mind_epoch=$current_epoch
            current_mind_counter=$current_counter
            current_mind_path=$current_candidate
        fi
    done
    printf '%s\n' "$current_mind_path"
}

reset_mind_update() {
    MIND_SET_STATE=0
    MIND_STATE=
    MIND_SET_MODEL=0
    MIND_MODEL=
    MIND_SET_EFFORT=0
    MIND_EFFORT=
    MIND_SET_ROLE=0
    MIND_ROLE=
    MIND_SET_CHARGE=0
    MIND_CHARGE=
    MIND_SET_FOCUS=0
    MIND_FOCUS=
    MIND_SET_STANCE=0
    MIND_STANCE=
}

write_mind_generation() {
    write_mind_session=$1
    write_mind_node=$2
    write_mind_dir=$KHALA_ROOT/minds/$write_mind_node/$write_mind_session
    if ! mkdir -p "$write_mind_dir"; then
        error "$write_mind_dir: mind shard를 만들지 못했습니다"
        return 1
    fi
    write_mind_current=$(current_mind_generation "$write_mind_node" "$write_mind_session") || return 1
    write_mind_now=$(date +%s) || {
        error "현재 시각을 읽지 못했습니다"
        return 1
    }
    if [ -n "$write_mind_current" ]; then
        write_mind_previous=$(basename "$write_mind_current")
        write_mind_previous_epoch=$(normalize_integer "${write_mind_previous%%.*}")
        write_mind_previous_counter=$(normalize_integer "${write_mind_previous#*.}")
    else
        write_mind_previous_epoch=0
        write_mind_previous_counter=0
    fi
    if [ -n "$write_mind_current" ] && [ "$write_mind_now" -le "$write_mind_previous_epoch" ]; then
        write_mind_epoch=$write_mind_previous_epoch
        write_mind_counter=$((write_mind_previous_counter + 1))
    else
        write_mind_epoch=$write_mind_now
        write_mind_counter=0
    fi
    write_mind_generation=$write_mind_epoch.$write_mind_counter

    write_state=active
    write_model=
    write_effort=
    write_role=
    write_charge=
    write_focus=
    write_stance=
    write_declared_state=0
    write_declared_model=0
    write_declared_effort=0
    write_declared_role=0
    write_declared_charge=0
    write_declared_focus=0
    write_declared_stance=0
    # AMBIGUOUS: Which epoch represents a field never declared before the
    # first family-specific generation? Epoch 0 means "not yet declared".
    if [ -n "$write_mind_current" ]; then
        write_state=$(header_value State "$write_mind_current")
        write_model=$(header_value Model "$write_mind_current")
        write_effort=$(header_value Effort "$write_mind_current")
        write_role=$(header_value Role "$write_mind_current")
        write_charge=$(header_value Charge "$write_mind_current")
        write_focus=$(header_value Focus "$write_mind_current")
        write_stance=$(header_value Stance "$write_mind_current")
        write_declared_state=$(header_value Declared-State "$write_mind_current")
        write_declared_model=$(header_value Declared-Model "$write_mind_current")
        write_declared_effort=$(header_value Declared-Effort "$write_mind_current")
        write_declared_role=$(header_value Declared-Role "$write_mind_current")
        write_declared_charge=$(header_value Declared-Charge "$write_mind_current")
        write_declared_focus=$(header_value Declared-Focus "$write_mind_current")
        write_declared_stance=$(header_value Declared-Stance "$write_mind_current")
    fi
    if [ "$MIND_SET_STATE" -eq 1 ]; then
        write_state=$MIND_STATE
        write_declared_state=$write_mind_epoch
    fi
    if [ "$MIND_SET_MODEL" -eq 1 ]; then
        write_model=$MIND_MODEL
        write_declared_model=$write_mind_epoch
    fi
    if [ "$MIND_SET_EFFORT" -eq 1 ]; then
        write_effort=$MIND_EFFORT
        write_declared_effort=$write_mind_epoch
    fi
    if [ "$MIND_SET_ROLE" -eq 1 ]; then
        write_role=$MIND_ROLE
        write_declared_role=$write_mind_epoch
    fi
    if [ "$MIND_SET_CHARGE" -eq 1 ]; then
        write_charge=$MIND_CHARGE
        write_declared_charge=$write_mind_epoch
    fi
    if [ "$MIND_SET_FOCUS" -eq 1 ]; then
        write_focus=$MIND_FOCUS
        write_declared_focus=$write_mind_epoch
    fi
    if [ "$MIND_SET_STANCE" -eq 1 ]; then
        write_stance=$MIND_STANCE
        write_declared_stance=$write_mind_epoch
    fi

    write_mind_tmp=$(mktemp "$TMP_DIR/mind.XXXXXX") || return 1
    if ! {
        printf 'Generation: %s\n' "$write_mind_generation"
        printf 'Session: %s\n' "$write_mind_session"
        printf 'Node: %s\n' "$write_mind_node"
        printf 'State: %s\n' "$write_state"
        printf 'Model: %s\n' "$write_model"
        printf 'Effort: %s\n' "$write_effort"
        printf 'Role: %s\n' "$write_role"
        printf 'Charge: %s\n' "$write_charge"
        printf 'Focus: %s\n' "$write_focus"
        printf 'Stance: %s\n' "$write_stance"
        printf 'Declared-State: %s\n' "$write_declared_state"
        printf 'Declared-Model: %s\n' "$write_declared_model"
        printf 'Declared-Effort: %s\n' "$write_declared_effort"
        printf 'Declared-Role: %s\n' "$write_declared_role"
        printf 'Declared-Charge: %s\n' "$write_declared_charge"
        printf 'Declared-Focus: %s\n' "$write_declared_focus"
        printf 'Declared-Stance: %s\n\n' "$write_declared_stance"
    } > "$write_mind_tmp"; then
        rm -f "$write_mind_tmp"
        return 1
    fi
    write_mind_destination=$write_mind_dir/$write_mind_generation
    if ! ln "$write_mind_tmp" "$write_mind_destination" 2>/dev/null; then
        rm -f "$write_mind_tmp"
        error "$write_mind_destination: mind generation을 no-clobber 설치하지 못했습니다"
        return 1
    fi
    rm -f "$write_mind_tmp"
    printf '%s\n' "$write_mind_generation"
    return 0
}

quarantine_mind_file() {
    quarantine_mind_file_path=$1
    quarantine_mind_node=$2
    quarantine_mind_session=$3
    quarantine_mind_generation=$4
    quarantine_mind_reason=$5
    quarantine_mind_dir=$KHALA_ROOT/spool/dead
    if ! mkdir -p "$quarantine_mind_dir"; then
        error "$quarantine_mind_file_path: mind quarantine 디렉터리를 만들지 못했습니다"
        return 1
    fi
    quarantine_mind_destination=$quarantine_mind_dir/mind.$quarantine_mind_node.$quarantine_mind_session.$quarantine_mind_generation
    if [ -e "$quarantine_mind_destination" ] && \
        ! cmp -s "$quarantine_mind_file_path" "$quarantine_mind_destination"; then
        quarantine_mind_destination=$quarantine_mind_destination.$$.conflict
    fi
    if [ -e "$quarantine_mind_destination" ]; then
        rm -f "$quarantine_mind_file_path" || return 1
    elif ! mv "$quarantine_mind_file_path" "$quarantine_mind_destination"; then
        error "$quarantine_mind_file_path: mind generation을 quarantine으로 옮기지 못했습니다"
        return 1
    fi
    error "$quarantine_mind_generation: $quarantine_mind_reason — spool/dead로 격리했습니다"
    return 0
}

install_pulled_minds() {
    install_minds_root=$1
    install_minds_now=$(date +%s) || return 1
    install_minds_days=$(retain_days) || return 1
    install_minds_seconds=$((install_minds_days * 86400))
    install_minds_failed=0
    for install_mind_file in "$install_minds_root"/*/*/*; do
        [ -f "$install_mind_file" ] || continue
        install_mind_node=$(basename "$(dirname "$(dirname "$install_mind_file")")")
        install_mind_session=$(basename "$(dirname "$install_mind_file")")
        install_mind_generation=$(basename "$install_mind_file")
        if ! valid_name "$install_mind_node" || ! valid_name "$install_mind_session" || \
            ! valid_generation "$install_mind_generation" || \
            ! validate_mind_file "$install_mind_file" "$install_mind_node" \
                "$install_mind_session" "$install_mind_generation"; then
            quarantine_mind_file "$install_mind_file" "$install_mind_node" \
                "$install_mind_session" "$install_mind_generation" \
                "잘못된 pull mind generation" || return 1
            install_minds_failed=1
            continue
        fi
        install_mind_epoch=$(normalize_integer "${install_mind_generation%%.*}")
        if [ "$install_mind_epoch" -gt "$((install_minds_now + 86400))" ]; then
            quarantine_mind_file "$install_mind_file" "$install_mind_node" \
                "$install_mind_session" "$install_mind_generation" \
                "하루를 넘는 미래 epoch" || return 1
            install_minds_failed=1
            continue
        fi
        # Minds are age-governed alongside streams and presence: an expired
        # generation is not eligible for installation even before local GC.
        if [ "$((install_mind_epoch + install_minds_seconds))" -lt "$install_minds_now" ]; then
            rm -f "$install_mind_file" || return 1
            continue
        fi
        install_mind_dir=$KHALA_ROOT/minds/$install_mind_node/$install_mind_session
        install_mind_destination=$install_mind_dir/$install_mind_generation
        mkdir -p "$install_mind_dir" || return 1
        if [ -f "$install_mind_destination" ]; then
            if ! cmp -s "$install_mind_file" "$install_mind_destination"; then
                quarantine_mind_file "$install_mind_file" "$install_mind_node" \
                    "$install_mind_session" "$install_mind_generation" \
                    "같은 generation의 digest 불일치" || return 1
                install_minds_failed=1
            fi
            continue
        fi
        if ! atomic_copy "$install_mind_file" "$install_mind_destination"; then
            return 1
        fi
        if ! cmp -s "$install_mind_file" "$install_mind_destination"; then
            quarantine_mind_file "$install_mind_file" "$install_mind_node" \
                "$install_mind_session" "$install_mind_generation" \
                "설치 경주 중 같은 generation의 digest 불일치" || return 1
            install_minds_failed=1
        fi
    done
    [ "$install_minds_failed" -eq 0 ]
}

pull_minds_from_endpoint() {
    mind_endpoint=$1
    mind_stage=$(mktemp -d "$TMP_DIR/minds-pull.XXXXXX") || return 1
    if ! mailbox_rsync "$mind_endpoint" pull "$mind_stage/" minds/ 0; then
        rm -rf -- "$mind_stage"
        return 1
    fi
    if ! install_pulled_minds "$mind_stage"; then
        rm -rf -- "$mind_stage"
        return 1
    fi
    rm -rf -- "$mind_stage"
    return 0
}

push_owned_minds() {
    mind_endpoint=$1
    mind_self=$2
    mind_shard=$KHALA_ROOT/minds/$mind_self
    [ -d "$mind_shard" ] || return 0
    mailbox_rsync "$mind_endpoint" push "$mind_shard/" "minds/$mind_self/" 0 1 1
}

load_preserve_config() {
    if [ "$PRESERVE_CONFIG_LOADED" -eq 1 ]; then
        [ "$PRESERVE_CONFIG_INVALID" -eq 0 ]
        return
    fi
    PRESERVE_CONFIG_LOADED=1
    PRESERVER_ENABLED=0
    PRESERVE_CONFIG_INVALID=0
    PRESERVE_STREAMS=
    preserve_line_count=0
    while IFS= read -r preserve_line || [ -n "$preserve_line" ]; do
        case "$preserve_line" in
            preserve|preserve[[:space:]]*) ;;
            *) continue ;;
        esac
        preserve_line_count=$((preserve_line_count + 1))
        case $- in
            *f*) preserve_restore_glob=0 ;;
            *) preserve_restore_glob=1; set -f ;;
        esac
        set -- $preserve_line
        [ "$preserve_restore_glob" -eq 0 ] || set +f
        shift
        if [ "$#" -eq 0 ]; then
            error "config의 preserve에 stream이 없습니다"
            PRESERVE_CONFIG_INVALID=1
            continue
        fi
        for preserve_name in "$@"; do
            if [ "$preserve_name" != all ] && ! valid_name "$preserve_name"; then
                error "config의 preserve stream 이름이 잘못되었습니다: $preserve_name"
                PRESERVE_CONFIG_INVALID=1
                continue
            fi
            case " $PRESERVE_STREAMS " in
                *" $preserve_name "*) ;;
                *) PRESERVE_STREAMS="$PRESERVE_STREAMS $preserve_name" ;;
            esac
        done
    done < "$CONFIG"
    if [ "$preserve_line_count" -gt 1 ]; then
        error "config에는 preserve 줄을 하나만 둘 수 있습니다"
        PRESERVE_CONFIG_INVALID=1
    fi
    if [ "$preserve_line_count" -eq 1 ] && [ "$PRESERVE_CONFIG_INVALID" -eq 0 ]; then
        PRESERVER_ENABLED=1
    fi
    [ "$PRESERVE_CONFIG_INVALID" -eq 0 ]
}

preserve_stream_selected() {
    preserve_wanted=$1
    [ "$PRESERVER_ENABLED" -eq 1 ] || return 1
    case " $PRESERVE_STREAMS " in
        *' all '*) return 0 ;;
        *" $preserve_wanted "*) return 0 ;;
        *) return 1 ;;
    esac
}

file_device() {
    device_path=$1
    device_value=$(stat -c %d "$device_path" 2>/dev/null) || device_value=
    if positive_or_zero_integer "$device_value"; then
        printf '%s\n' "$device_value"
        return 0
    fi
    device_value=$(stat -f %d "$device_path" 2>/dev/null) || device_value=
    if positive_or_zero_integer "$device_value"; then
        printf '%s\n' "$device_value"
        return 0
    fi
    return 1
}

sync_directory() {
    sync_dir=$1
    case "$SYNC_DIR_STYLE" in
        dash-d) sync -d "$sync_dir" ;;
        global) sync ;;
        *)
            if sync -d "$sync_dir" 2>/dev/null; then
                SYNC_DIR_STYLE=dash-d
                return 0
            fi
            SYNC_DIR_STYLE=global
            sync
            ;;
    esac
}

archive_path_for() {
    archive_stream=$1
    archive_node=$2
    archive_id=$3
    archive_epoch=$(normalize_integer "${archive_id%%.*}")
    detect_epoch_date_style || return 1
    case "$EPOCH_DATE_STYLE" in
        bsd) archive_month=$(date -u -r "$archive_epoch" '+%Y/%m') || return 1 ;;
        gnu) archive_month=$(date -u -d "@$archive_epoch" '+%Y/%m') || return 1 ;;
        *) return 1 ;;
    esac
    printf '%s/archive/streams/%s/%s/%s/%s\n' \
        "$KHALA_ROOT" "$archive_stream" "$archive_node" "$archive_month" "$archive_id"
}

prepare_preserver() {
    [ "$PRESERVER_ENABLED" -eq 1 ] || return 0
    PRESERVER_READY=0
    if ! mkdir -p "$KHALA_ROOT/archive/streams"; then
        error "preserver degraded: $KHALA_ROOT/archive/streams를 만들지 못했습니다"
        PRESERVER_DEGRADED=1
        return 1
    fi
    if ! preserve_live_device=$(file_device "$KHALA_ROOT/streams") || \
        ! preserve_archive_device=$(file_device "$KHALA_ROOT/archive/streams"); then
        error "preserver degraded: live/archive filesystem을 확인하지 못했습니다"
        PRESERVER_DEGRADED=1
        return 1
    fi
    if [ "$preserve_live_device" != "$preserve_archive_device" ]; then
        error "preserver degraded: live와 archive가 다른 filesystem입니다; cross-FS는 v1 범위 밖입니다"
        PRESERVER_DEGRADED=1
        return 1
    fi
    PRESERVER_READY=1
    return 0
}

quarantine_preserver_conflict() {
    preserve_conflict_file=$1
    preserve_conflict_stream=$2
    preserve_conflict_node=$3
    preserve_conflict_id=$4
    preserve_conflict_dir=$KHALA_ROOT/spool/dead
    # AMBIGUOUS: Which immutable side should move on a live/archive digest
    # conflict? Keep both paths fail-closed and quarantine a live-byte copy.
    preserve_conflict_destination=$preserve_conflict_dir/preserver.$preserve_conflict_stream.$preserve_conflict_node.$preserve_conflict_id
    if ! mkdir -p "$preserve_conflict_dir"; then
        error "preserver degraded: conflict quarantine 디렉터리를 만들지 못했습니다"
        return 1
    fi
    if [ -e "$preserve_conflict_destination" ]; then
        cmp -s "$preserve_conflict_file" "$preserve_conflict_destination" || {
            preserve_conflict_destination=$preserve_conflict_destination.$$.conflict
            atomic_copy "$preserve_conflict_file" "$preserve_conflict_destination" || return 1
        }
    elif ! atomic_copy "$preserve_conflict_file" "$preserve_conflict_destination"; then
        return 1
    fi
    error "preserver degraded: $preserve_conflict_id live/archive digest 불일치 — live를 보존하고 conflict를 격리했습니다"
    return 0
}

archive_stream_file() {
    archive_live=$1
    archive_stream_name=$2
    archive_node_name=$3
    archive_stream_id=$4
    archive_destination=$(archive_path_for "$archive_stream_name" "$archive_node_name" \
        "$archive_stream_id") || return 1
    # Already settled: the archive entry is this very inode (the hardlink made
    # on an earlier pass). Nothing to create, compare or sync — and this is the
    # common case on every pass of a preserving node.
    [ "$archive_live" -ef "$archive_destination" ] && return 0
    archive_destination_dir=${archive_destination%/*}
    if ! mkdir -p "$archive_destination_dir"; then
        error "preserver degraded: $archive_destination_dir를 만들지 못했습니다"
        return 1
    fi
    if [ -e "$archive_destination" ]; then
        if ! cmp -s "$archive_live" "$archive_destination"; then
            quarantine_preserver_conflict "$archive_live" "$archive_stream_name" \
                "$archive_node_name" "$archive_stream_id" || :
            return 1
        fi
    elif ! ln "$archive_live" "$archive_destination" 2>/dev/null; then
        if [ -e "$archive_destination" ]; then
            if ! cmp -s "$archive_live" "$archive_destination"; then
                quarantine_preserver_conflict "$archive_live" "$archive_stream_name" \
                    "$archive_node_name" "$archive_stream_id" || :
                return 1
            fi
        else
            error "preserver degraded: $archive_stream_id archive hardlink 정착에 실패했습니다"
            return 1
        fi
    fi
    if ! sync_directory "$archive_destination_dir"; then
        error "preserver degraded: $archive_destination_dir directory sync에 실패했습니다"
        return 1
    fi
    return 0
}

capture_preserved_streams() {
    [ "$PRESERVER_ENABLED" -eq 1 ] || return 0
    prepare_preserver || return 1
    capture_failed=0
    capture_now=$(date +%s) || return 1
    for capture_file in "$KHALA_ROOT"/streams/*/*/*; do
        [ -f "$capture_file" ] || continue
        capture_node_dir=${capture_file%/*}
        capture_node=${capture_node_dir##*/}
        capture_stream_dir=${capture_node_dir%/*}
        capture_stream=${capture_stream_dir##*/}
        capture_id=${capture_file##*/}
        preserve_stream_selected "$capture_stream" || continue
        if ! valid_name "$capture_stream" || ! valid_name "$capture_node" || \
            ! validate_stream_file "$capture_file" "$capture_stream" "$capture_node"; then
            quarantine_stream_file "$capture_file" "$capture_stream" "$capture_node" \
                "$capture_id" "잘못된 preserve 대상 stream 항목" || capture_failed=1
            continue
        fi
        capture_epoch=$(normalize_integer "${capture_id%%.*}")
        if [ "$capture_epoch" -gt "$((capture_now + 86400))" ]; then
            quarantine_stream_file "$capture_file" "$capture_stream" "$capture_node" \
                "$capture_id" "하루를 넘는 미래 epoch" || capture_failed=1
            continue
        fi
        if ! archive_stream_file "$capture_file" "$capture_stream" "$capture_node" "$capture_id"; then
            capture_failed=1
            PRESERVER_DEGRADED=1
        fi
    done
    [ "$capture_failed" -eq 0 ]
}

validate_stream_file() {
    stream_file=$1
    stream_expected=$2
    stream_node_expected=$3
    stream_id=$(header_value Id "$stream_file")
    stream_from=$(header_value From "$stream_file")
    stream_name=$(header_value Stream "$stream_file")
    stream_date=$(header_value Date "$stream_file")
    stream_type=$(header_value Type "$stream_file")
    stream_refs=$(header_value Refs "$stream_file")
    if ! valid_message_id "$stream_id" || [ "${stream_file##*/}" != "$stream_id" ]; then
        return 1
    fi
    if ! valid_address "$stream_from" || [ "${stream_from#*@}" != "$stream_node_expected" ]; then
        return 1
    fi
    stream_id_address=${stream_id#*.*.*.}
    if [ "$stream_id_address" != "$stream_from" ]; then
        return 1
    fi
    if [ "$stream_name" != "$stream_expected" ] || [ -z "$stream_date" ] || \
        [ "$stream_type" != entry ]; then
        return 1
    fi
    if [ "$(header_value Khala "$stream_file")" != 0.1 ] || \
        [ "$(line_prefix_count 'Expires:' "$stream_file")" -ne 0 ]; then
        return 1
    fi
    if [ -n "$stream_refs" ] && ! valid_message_id "$stream_refs"; then
        return 1
    fi
    return 0
}

quarantine_stream_file() {
    quarantine_file=$1
    quarantine_stream=$2
    quarantine_node=$3
    quarantine_id=$4
    quarantine_reason=$5
    quarantine_dir=$KHALA_ROOT/spool/dead
    if ! mkdir -p "$quarantine_dir"; then
        error "$quarantine_file: stream quarantine 디렉터리를 만들지 못했습니다"
        return 1
    fi
    # AMBIGUOUS: D13 requires reuse of the existing quarantine machinery but
    # does not name an encoding for stream/node provenance in spool/dead.
    quarantine_destination=$quarantine_dir/stream.$quarantine_stream.$quarantine_node.$quarantine_id
    if [ -e "$quarantine_destination" ] && ! cmp -s "$quarantine_file" "$quarantine_destination"; then
        quarantine_destination=$quarantine_destination.$$.conflict
    fi
    if [ -e "$quarantine_destination" ]; then
        if ! rm -f "$quarantine_file"; then
            error "$quarantine_file: 중복 quarantine 원본을 지우지 못했습니다"
            return 1
        fi
    elif ! mv "$quarantine_file" "$quarantine_destination"; then
        error "$quarantine_file: stream 항목을 quarantine으로 옮기지 못했습니다"
        return 1
    fi
    error "$quarantine_id: $quarantine_reason — spool/dead로 격리했습니다"
    return 0
}

collect_stream_entries() {
    collect_stream=$1
    collect_output=$2
    collect_unsorted=$(mktemp "$TMP_DIR/stream-list.XXXXXX") || return 1
    : > "$collect_unsorted" || {
        rm -f "$collect_unsorted"
        return 1
    }
    for collect_file in "$KHALA_ROOT/streams/$collect_stream"/*/*; do
        [ -f "$collect_file" ] || continue
        collect_id=$(basename "$collect_file")
        collect_epoch=${collect_id%%.*}
        if ! positive_or_zero_integer "$collect_epoch"; then
            continue
        fi
        printf '%s\t%s\t%s\n' "$collect_epoch" "$collect_id" "$collect_file" >> "$collect_unsorted" || {
            rm -f "$collect_unsorted"
            return 1
        }
    done
    if ! sort -k1,1n -k2,2 "$collect_unsorted" > "$collect_output"; then
        rm -f "$collect_unsorted"
        return 1
    fi
    rm -f "$collect_unsorted"
    return 0
}

collect_cat_stream_entries() {
    cat_collect_stream=$1
    cat_collect_output=$2
    cat_collect_unsorted=$(mktemp "$TMP_DIR/stream-cat-list.XXXXXX") || return 1
    cat_collect_sorted=$(mktemp "$TMP_DIR/stream-cat-sorted.XXXXXX") || {
        rm -f "$cat_collect_unsorted"
        return 1
    }
    : > "$cat_collect_unsorted" || {
        rm -f "$cat_collect_unsorted" "$cat_collect_sorted"
        return 1
    }
    for cat_collect_file in "$KHALA_ROOT/streams/$cat_collect_stream"/*/* \
        "$KHALA_ROOT/archive/streams/$cat_collect_stream"/*/*/*/*; do
        [ -f "$cat_collect_file" ] || continue
        cat_collect_id=$(basename "$cat_collect_file")
        cat_collect_epoch=${cat_collect_id%%.*}
        case "$cat_collect_file" in
            "$KHALA_ROOT"/streams/*)
                cat_collect_node=$(basename "$(dirname "$cat_collect_file")")
                ;;
            "$KHALA_ROOT"/archive/streams/*)
                cat_collect_node=$(basename "$(dirname "$(dirname "$(dirname "$cat_collect_file")")")")
                ;;
            *) continue ;;
        esac
        if ! positive_or_zero_integer "$cat_collect_epoch" || \
            ! valid_name "$cat_collect_node" || \
            ! validate_stream_file "$cat_collect_file" "$cat_collect_stream" "$cat_collect_node"; then
            error "$cat_collect_file: 잘못된 live/archive stream 항목"
            rm -f "$cat_collect_unsorted" "$cat_collect_sorted"
            return 1
        fi
        printf '%s\t%s\t%s\t%s\n' "$cat_collect_epoch" "$cat_collect_id" \
            "$cat_collect_node" "$cat_collect_file" >> "$cat_collect_unsorted" || {
            rm -f "$cat_collect_unsorted" "$cat_collect_sorted"
            return 1
        }
    done
    if ! sort -k1,1n -k2,2 -k3,3 "$cat_collect_unsorted" > "$cat_collect_sorted"; then
        rm -f "$cat_collect_unsorted" "$cat_collect_sorted"
        return 1
    fi
    : > "$cat_collect_output" || {
        rm -f "$cat_collect_unsorted" "$cat_collect_sorted"
        return 1
    }
    cat_collect_previous_key=
    cat_collect_previous_path=
    while IFS="$TAB" read -r cat_collect_epoch cat_collect_id cat_collect_node cat_collect_path; do
        [ -n "${cat_collect_epoch-}" ] || continue
        cat_collect_key=$cat_collect_node/$cat_collect_id
        if [ "$cat_collect_key" = "$cat_collect_previous_key" ]; then
            if ! cmp -s "$cat_collect_previous_path" "$cat_collect_path"; then
                error "preserver degraded: $cat_collect_stream/$cat_collect_key live/archive digest 불일치"
                : > "$cat_collect_output"
                rm -f "$cat_collect_unsorted" "$cat_collect_sorted"
                return 1
            fi
            continue
        fi
        printf '%s\t%s\t%s\n' "$cat_collect_epoch" "$cat_collect_id" \
            "$cat_collect_path" >> "$cat_collect_output" || {
            rm -f "$cat_collect_unsorted" "$cat_collect_sorted"
            return 1
        }
        cat_collect_previous_key=$cat_collect_key
        cat_collect_previous_path=$cat_collect_path
    done < "$cat_collect_sorted"
    rm -f "$cat_collect_unsorted" "$cat_collect_sorted"
    return 0
}

latest_stream_id() {
    latest_stream=$1
    latest_list=$(mktemp "$TMP_DIR/stream-latest.XXXXXX") || return 1
    if ! collect_stream_entries "$latest_stream" "$latest_list"; then
        rm -f "$latest_list"
        return 1
    fi
    latest_id=$(tail -n 1 "$latest_list" | cut -f 2)
    rm -f "$latest_list"
    printf '%s\n' "$latest_id"
}

build_unread_stream_entries() {
    unread_session=$1
    unread_stream=$2
    unread_output=$3
    unread_state_file=$KHALA_ROOT/join/$unread_session/$unread_stream
    [ -f "$unread_state_file" ] || {
        : > "$unread_output"
        return 0
    }
    IFS=' ' read -r unread_state unread_join_epoch unread_extra < "$unread_state_file"
    case "$unread_state" in
        joined|quiet) ;;
        *) : > "$unread_output"; return 0 ;;
    esac
    if ! positive_or_zero_integer "$unread_join_epoch" || [ -n "${unread_extra-}" ]; then
        error "$unread_state_file: 잘못된 join 상태"
        return 1
    fi
    unread_cursor_file=$KHALA_ROOT/cursor/$unread_session/$unread_stream
    unread_cursor=
    unread_cursor_epoch=
    if [ -f "$unread_cursor_file" ]; then
        unread_cursor=$(sed -n '1p' "$unread_cursor_file")
        if ! valid_message_id "$unread_cursor"; then
            error "$unread_cursor_file: 잘못된 stream cursor"
            return 1
        fi
        unread_cursor_epoch=${unread_cursor%%.*}
    fi
    unread_retain_days=$(retain_days) || return 1
    unread_now=$(date +%s) || {
        error "현재 시각을 읽지 못했습니다"
        return 1
    }
    unread_retain_seconds=$((unread_retain_days * 86400))
    unread_all=$(mktemp "$TMP_DIR/stream-unread-all.XXXXXX") || return 1
    if ! collect_stream_entries "$unread_stream" "$unread_all"; then
        rm -f "$unread_all"
        return 1
    fi
    : > "$unread_output" || {
        rm -f "$unread_all"
        return 1
    }
    while IFS="$TAB" read -r unread_epoch unread_id unread_path; do
        [ -n "${unread_epoch-}" ] || continue
        unread_epoch_normalized=$(normalize_integer "$unread_epoch")
        if [ "$((unread_epoch_normalized + unread_retain_seconds))" -lt "$unread_now" ]; then
            continue
        fi
        unread_include=0
        if [ -n "$unread_cursor" ]; then
            if [ "$unread_epoch" -gt "$unread_cursor_epoch" ] || \
                { [ "$unread_epoch" -eq "$unread_cursor_epoch" ] && [ "$unread_id" \> "$unread_cursor" ]; }; then
                unread_include=1
            fi
        elif [ "$unread_epoch" -ge "$unread_join_epoch" ]; then
            unread_include=1
        fi
        if [ "$unread_include" -eq 1 ]; then
            printf '%s\t%s\t%s\n' "$unread_epoch" "$unread_id" "$unread_path" >> "$unread_output" || {
                rm -f "$unread_all"
                return 1
            }
        fi
    done < "$unread_all"
    rm -f "$unread_all"
    return 0
}

infrastructure_message_id() {
    infra_id_type=$1
    infra_id_ref=$2
    infra_id_from=$3
    infra_id_epoch=${infra_id_ref%%.*}
    infra_id_rest=${infra_id_ref#*.}
    infra_id_pid=${infra_id_rest%%.*}
    infra_id_checksum=$(printf '%s' "$infra_id_type:$infra_id_ref" | cksum) || return 1
    infra_id_rand=${infra_id_checksum%% *}
    if ! positive_or_zero_integer "$infra_id_epoch" || \
        ! positive_or_zero_integer "$infra_id_pid"; then
        return 1
    fi
    printf '%s.%s.%s.%s\n' "$infra_id_epoch" "$infra_id_pid" \
        "$infra_id_rand" "$infra_id_from"
}

write_generated_message() {
    generated_type=$1
    generated_from=$2
    generated_to=$3
    generated_ref=$4
    generated_body=$5
    generated_destination=$6
    generated_id=$7
    generated_ref_epoch=${generated_ref%%.*}
    if ! positive_or_zero_integer "$generated_ref_epoch"; then
        error "$generated_ref: infra Refs의 epoch가 잘못되었습니다"
        return 1
    fi
    generated_expires=$((generated_ref_epoch + 2592000))
    detect_epoch_date_style || return 1
    generated_date=$(epoch_to_iso "$generated_ref_epoch") || return 1
    generated_tmp=$(mktemp "$TMP_DIR/message.XXXXXX") || return 1
    if ! {
        printf 'Khala: 0.1\n'
        printf 'Id: %s\n' "$generated_id"
        printf 'From: %s\n' "$generated_from"
        printf 'To: %s\n' "$generated_to"
        printf 'Date: %s\n' "$generated_date"
        printf 'Type: %s\n' "$generated_type"
        printf 'Refs: %s\n' "$generated_ref"
        printf 'Expires: %s\n' "$generated_expires"
        printf '\n%s\n' "$generated_body"
    } > "$generated_tmp"; then
        rm -f "$generated_tmp"
        return 1
    fi
    if ln "$generated_tmp" "$generated_destination" 2>/dev/null; then
        rm -f "$generated_tmp"
        return 0
    fi
    if [ -e "$generated_destination" ]; then
        rm -f "$generated_tmp"
        return 0
    fi
    rm -f "$generated_tmp"
    error "$generated_destination: infra 메시지 원자 설치에 실패했습니다"
    return 1
}

queue_infrastructure_message() {
    infra_type=$1
    infra_from=$2
    infra_to=$3
    infra_ref=$4
    infra_body=$5
    infra_id=$(infrastructure_message_id "$infra_type" "$infra_ref" "$infra_from") || return 1
    infra_node=${infra_to#*@}
    infra_dir=$KHALA_ROOT/spool/for/$infra_node
    if ! mkdir -p "$infra_dir"; then
        return 1
    fi
    write_generated_message "$infra_type" "$infra_from" "$infra_to" \
        "$infra_ref" "$infra_body" "$infra_dir/$infra_id" "$infra_id"
}

queue_notice() {
    notice_from=$1
    notice_to=$2
    notice_urgency=$3
    notice_subject=$4
    notice_expires=$5
    notice_body_file=$6
    NOTICE_ID=$(new_message_id "$notice_from") || return 1
    notice_node=${notice_to#*@}
    notice_dir=$KHALA_ROOT/spool/for/$notice_node
    if ! mkdir -p "$notice_dir"; then
        return 1
    fi
    notice_date=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || return 1
    notice_tmp=$(mktemp "$TMP_DIR/notice.XXXXXX") || return 1
    if ! {
        printf 'Khala: 0.1\n'
        printf 'Id: %s\n' "$NOTICE_ID"
        printf 'From: %s\n' "$notice_from"
        printf 'To: %s\n' "$notice_to"
        printf 'Date: %s\n' "$notice_date"
        printf 'Type: notice\n'
        printf 'Urgency: %s\n' "$notice_urgency"
        if [ -n "$notice_subject" ]; then
            printf 'Subject: %s\n' "$notice_subject"
        fi
        printf 'Expires: %s\n' "$notice_expires"
        printf '\n'
        cat "$notice_body_file"
    } > "$notice_tmp"; then
        rm -f "$notice_tmp"
        return 1
    fi
    if ln "$notice_tmp" "$notice_dir/$NOTICE_ID" 2>/dev/null; then
        rm -f "$notice_tmp"
        return 0
    fi
    rm -f "$notice_tmp"
    if [ -e "$notice_dir/$NOTICE_ID" ]; then
        error "$NOTICE_ID: 이미 존재하는 Id라 notice를 덮어쓰지 않습니다"
    else
        error "$NOTICE_ID: notice를 spool에 원자적으로 안착시키지 못했습니다"
    fi
    return 1
}

delivered_before() {
    wanted_id=$1
    while IFS=' ' read -r dedup_read_epoch dedup_read_id dedup_read_extra; do
        if [ "${dedup_read_id-}" = "$wanted_id" ]; then
            return 0
        fi
    done < "$KHALA_ROOT/log/delivered"
    return 1
}

record_delivered() {
    delivered_id=$1
    if delivered_before "$delivered_id"; then
        return 0
    fi
    delivered_now=$(date +%s) || return 1
    delivered_tmp=$(mktemp "$TMP_DIR/delivered.XXXXXX") || return 1
    if ! cp "$KHALA_ROOT/log/delivered" "$delivered_tmp"; then
        rm -f "$delivered_tmp"
        return 1
    fi
    if ! printf '%s %s\n' "$delivered_now" "$delivered_id" >> "$delivered_tmp"; then
        rm -f "$delivered_tmp"
        return 1
    fi
    if ! mv "$delivered_tmp" "$KHALA_ROOT/log/delivered"; then
        rm -f "$delivered_tmp"
        return 1
    fi
    return 0
}

delivered_or_inbox() {
    delivered_session=$1
    delivered_id=$2
    if delivered_before "$delivered_id"; then
        return 0
    fi
    if [ -f "$KHALA_ROOT/inbox/$delivered_session/new/$delivered_id" ] || \
        [ -f "$KHALA_ROOT/inbox/$delivered_session/cur/$delivered_id" ]; then
        if ! record_delivered "$delivered_id"; then
            sync_error "$delivered_id: inbox에 있는 배달의 dedup 로그를 수리하지 못했습니다"
            return 2
        fi
        error "$delivered_id: inbox에서 기존 배달을 찾아 dedup 로그를 수리했습니다"
        return 0
    fi
    return 1
}

sync_error() {
    SYNC_FAILED=1
    error "$*"
}

mailbox_rsync() {
    rsync_endpoint=$1
    rsync_direction=$2
    rsync_local_path=$3
    rsync_mailbox_path=$4
    rsync_remove_source=$5
    rsync_ignore_existing=${6-0}
    rsync_ensure_destination=${7-0}

    case "$rsync_endpoint" in
        /*)
            rsync_mailbox_root=$rsync_endpoint
            rsync_remote=0
            ;;
        *)
            # AMBIGUOUS: §9.6 gives only an SSH destination, not a remote
            # KHALA_HOME override, so use the documented default root.
            rsync_mailbox_root='~/.khala'
            rsync_remote=1
            ;;
    esac

    if [ "$rsync_direction" = push ]; then
        rsync_source=$rsync_local_path
        rsync_destination=$rsync_mailbox_root/$rsync_mailbox_path
        if [ "$rsync_remote" -eq 1 ]; then
            rsync_destination=$rsync_endpoint:$rsync_destination
            if [ "$rsync_ensure_destination" -eq 1 ] && \
                ! ssh -o ConnectTimeout=5 -o BatchMode=yes "$rsync_endpoint" \
                "test -d $rsync_mailbox_root && mkdir -p $rsync_mailbox_root/$rsync_mailbox_path"; then
                return 1
            fi
        elif [ "$rsync_ensure_destination" -eq 1 ] && ! mkdir -p "$rsync_destination"; then
            return 1
        fi
    else
        rsync_source=$rsync_mailbox_root/$rsync_mailbox_path
        rsync_destination=$rsync_local_path
        if [ "$rsync_remote" -eq 1 ]; then
            rsync_source=$rsync_endpoint:$rsync_source
        fi
        if [ "$rsync_remote" -eq 1 ]; then
            if ! ssh -o ConnectTimeout=5 -o BatchMode=yes "$rsync_endpoint" \
                "test -d $rsync_mailbox_root && mkdir -p $rsync_mailbox_root/$rsync_mailbox_path"; then
                return 1
            fi
        else
            [ -d "$rsync_mailbox_root" ] || return 1
            if ! mkdir -p "$rsync_mailbox_root/$rsync_mailbox_path"; then
                return 1
            fi
        fi
    fi

    set -- --timeout=20 -a
    if [ "$rsync_remove_source" -eq 1 ]; then
        set -- "$@" --remove-source-files
    fi
    if [ "$rsync_ignore_existing" -eq 1 ]; then
        set -- "$@" --ignore-existing
    fi
    if [ "$rsync_remote" -eq 1 ]; then
        set -- "$@" -e "ssh -o ConnectTimeout=5 -o BatchMode=yes"
    fi
    rsync "$@" "$rsync_source" "$rsync_destination"
}

install_pulled_streams() {
    install_root=$1
    install_now=$(date +%s) || return 1
    for install_file in "$install_root"/*/*/*; do
        [ -f "$install_file" ] || continue
        install_node=$(basename "$(dirname "$install_file")")
        install_stream=$(basename "$(dirname "$(dirname "$install_file")")")
        install_id=$(basename "$install_file")
        if ! valid_name "$install_stream" || ! valid_name "$install_node" || \
            ! validate_stream_file "$install_file" "$install_stream" "$install_node"; then
            quarantine_stream_file "$install_file" "$install_stream" "$install_node" \
                "$install_id" "잘못된 pull stream 항목" || return 1
            continue
        fi
        install_epoch=$(normalize_integer "${install_id%%.*}")
        if [ "$install_epoch" -gt "$((install_now + 86400))" ]; then
            quarantine_stream_file "$install_file" "$install_stream" "$install_node" \
                "$install_id" "하루를 넘는 미래 epoch" || return 1
            continue
        fi
        install_destination_dir=$KHALA_ROOT/streams/$install_stream/$install_node
        install_destination=$install_destination_dir/$install_id
        if ! mkdir -p "$install_destination_dir"; then
            return 1
        fi
        if [ -f "$install_destination" ]; then
            if ! cmp -s "$install_file" "$install_destination"; then
                quarantine_stream_file "$install_file" "$install_stream" "$install_node" \
                    "$install_id" "같은 Id의 digest 불일치" || return 1
            fi
            continue
        fi
        if ! atomic_copy "$install_file" "$install_destination"; then
            return 1
        fi
        if ! cmp -s "$install_file" "$install_destination"; then
            quarantine_stream_file "$install_file" "$install_stream" "$install_node" \
                "$install_id" "설치 경주 중 같은 Id의 digest 불일치" || return 1
        fi
    done
    return 0
}

pull_streams_from_endpoint() {
    stream_endpoint=$1
    stream_stage=$(mktemp -d "$TMP_DIR/streams-pull.XXXXXX") || return 1
    if ! mailbox_rsync "$stream_endpoint" pull "$stream_stage/" streams/ 0; then
        rm -rf -- "$stream_stage"
        return 1
    fi
    if ! install_pulled_streams "$stream_stage"; then
        rm -rf -- "$stream_stage"
        return 1
    fi
    rm -rf -- "$stream_stage"
    return 0
}

push_owned_streams() {
    stream_endpoint=$1
    stream_self=$2
    for stream_shard in "$KHALA_ROOT"/streams/*/"$stream_self"; do
        [ -d "$stream_shard" ] || continue
        stream_name=$(basename "$(dirname "$stream_shard")")
        spool_has_files "$stream_shard" || continue
        if ! mailbox_rsync "$stream_endpoint" push "$stream_shard/" \
            "streams/$stream_name/$stream_self/" 0 1 1; then
            return 1
        fi
    done
    return 0
}

spool_has_files() {
    spool_check_dir=$1
    for spool_check_file in "$spool_check_dir"/*; do
        [ -f "$spool_check_file" ] || continue
        return 0
    done
    return 1
}

remove_pushed_infrastructure() {
    pushed_dir=$1
    for pushed_file in "$pushed_dir"/*; do
        [ -f "$pushed_file" ] || continue
        pushed_type=$(header_value Type "$pushed_file")
        # A notice keeps its source copy until Expires: the mailbox accepting
        # bytes is not delivery (R4). The destination deduplicates repeats by
        # Id, and prune_expired_notices removes the copy once it expires.
        case "$pushed_type" in
            ack|bounce)
                if ! rm -f "$pushed_file"; then
                    sync_error "$pushed_file: push한 인프라 사본을 지우지 못했습니다"
                fi
                ;;
        esac
    done
}

exchange_with_endpoint() {
    exchange_endpoint=$1
    exchange_self=$2

    if ! mailbox_rsync "$exchange_endpoint" pull \
        "$KHALA_ROOT/spool/for/$exchange_self/" \
        "spool/for/$exchange_self/" 1; then
        return 1
    fi
    # AMBIGUOUS: the brief requires pull -> settle -> push here, while also
    # saying exchange is outside the brain lock and ack settlement is a brain
    # mutation. Keep network I/O outside, but serialize this short settlement.
    if ! settle_visible_acks "$exchange_self"; then
        return 1
    fi

    for exchange_dir in "$KHALA_ROOT"/spool/for/*; do
        [ -d "$exchange_dir" ] || continue
        exchange_node=$(basename "$exchange_dir")
        [ "$exchange_node" != "$exchange_self" ] || continue
        spool_has_files "$exchange_dir" || continue
        if ! mailbox_rsync "$exchange_endpoint" push "$exchange_dir/" \
            "spool/for/$exchange_node/" 0; then
            return 1
        fi
    done

    if ! mailbox_rsync "$exchange_endpoint" pull \
        "$KHALA_ROOT/spool/for/$exchange_self/" \
        "spool/for/$exchange_self/" 1; then
        return 1
    fi

    if ! pull_streams_from_endpoint "$exchange_endpoint"; then
        return 1
    fi
    if ! push_owned_streams "$exchange_endpoint" "$exchange_self"; then
        return 1
    fi
    if ! pull_minds_from_endpoint "$exchange_endpoint"; then
        return 1
    fi
    if ! push_owned_minds "$exchange_endpoint" "$exchange_self"; then
        return 1
    fi

    # Watching-marker deletion is intentionally not propagated: remote copies
    # become stale under the display-side freshness rule.
    for exchange_presence in "$KHALA_ROOT"/presence/*@"$exchange_self" \
        "$KHALA_ROOT"/presence/*@"$exchange_self".watching \
        "$KHALA_ROOT"/presence/*@"$exchange_self".watcher; do
        [ -f "$exchange_presence" ] || continue
        if ! mailbox_rsync "$exchange_endpoint" push "$exchange_presence" \
            presence/ 0; then
            return 1
        fi
    done
    if ! mailbox_rsync "$exchange_endpoint" pull \
        "$KHALA_ROOT/presence/" presence/ 0; then
        return 1
    fi
    for exchange_dir in "$KHALA_ROOT"/spool/for/*; do
        [ -d "$exchange_dir" ] || continue
        exchange_node=$(basename "$exchange_dir")
        [ "$exchange_node" != "$exchange_self" ] || continue
        remove_pushed_infrastructure "$exchange_dir"
    done
    return 0
}

exchange_with_mailbox() {
    exchange_mailbox_self=$1
    exchange_mailboxes=$(sed -n 's/^mailbox //p' "$CONFIG")
    exchange_succeeded=0

    for exchange_alias in $exchange_mailboxes; do
        if ! valid_name "$exchange_alias"; then
            error "잘못된 mailbox 별칭을 건너뜁니다: $exchange_alias"
            continue
        fi
        exchange_endpoints=$(sed -n "s/^peer $exchange_alias //p" "$CONFIG")
        if [ -z "$exchange_endpoints" ]; then
            error "peer 후보가 없는 mailbox를 건너뜁니다: $exchange_alias"
            continue
        fi
        for exchange_candidate in $exchange_endpoints; do
            if exchange_with_endpoint "$exchange_candidate" "$exchange_mailbox_self"; then
                exchange_succeeded=1
                break 2
            fi
            error "mailbox $exchange_alias 후보를 건너뜁니다: $exchange_candidate"
        done
    done

    if [ "$exchange_succeeded" -ne 1 ]; then
        sync_error "사용 가능한 mailbox 후보가 없습니다"
    fi
}

validate_spool_file() {
    spool_file=$1
    spool_id=$(header_value Id "$spool_file")
    if [ -z "$spool_id" ] || [ "$(basename "$spool_file")" != "$spool_id" ]; then
        sync_error "$spool_file: filename과 Id가 다릅니다"
        return 1
    fi
    return 0
}

move_old_invalid_spool_file() {
    invalid_file=$1
    if ! invalid_old=$(find "$invalid_file" -mmin +43200 -print); then
        sync_error "$invalid_file: mtime 나이를 확인하지 못했습니다"
        return
    fi
    [ -n "$invalid_old" ] || return
    invalid_dead=$KHALA_ROOT/spool/dead
    if ! mkdir -p "$invalid_dead"; then
        sync_error "$invalid_file: 파싱 불능 spool 격리 디렉터리를 만들지 못했습니다"
        return
    fi
    if ! mv "$invalid_file" "$invalid_dead/$(basename "$invalid_file")"; then
        sync_error "$invalid_file: 30일 지난 파싱 불능 spool 파일을 격리하지 못했습니다"
        return
    fi
    error "$invalid_file: 30일 지난 파싱 불능 spool 파일을 spool/dead로 옮겼습니다"
}

copy_outbox_to_spool() {
    copy_now=$(date +%s) || {
        sync_error "현재 시각을 읽지 못했습니다"
        return
    }
    for outbox_file in "$KHALA_ROOT"/outbox/new/*; do
        [ -f "$outbox_file" ] || continue
        outbox_id=$(header_value Id "$outbox_file")
        outbox_type=$(header_value Type "$outbox_file")
        outbox_to=$(header_value To "$outbox_file")
        outbox_expires=$(header_value Expires "$outbox_file")
        if [ -z "$outbox_id" ] || [ "$(basename "$outbox_file")" != "$outbox_id" ]; then
            sync_error "$outbox_file: filename과 Id가 다릅니다"
            continue
        fi
        if [ "$outbox_type" != message ]; then
            sync_error "$outbox_file: outbox/new에는 message만 둘 수 있습니다"
            continue
        fi
        if ! valid_address "$outbox_to"; then
            sync_error "$outbox_file: 잘못된 To 헤더"
            continue
        fi
        if ! positive_or_zero_integer "$outbox_expires"; then
            sync_error "$outbox_file: 잘못된 Expires 헤더"
            continue
        fi
        if [ "$outbox_expires" -le "$copy_now" ]; then
            continue
        fi
        destination_node=${outbox_to#*@}
        destination_dir=$KHALA_ROOT/spool/for/$destination_node
        if ! mkdir -p "$destination_dir"; then
            sync_error "$outbox_file: spool 디렉터리를 만들지 못했습니다"
            continue
        fi
        if ! atomic_copy "$outbox_file" "$destination_dir/$outbox_id"; then
            sync_error "$outbox_file: spool 복사에 실패했습니다"
        fi
    done
}

deliver_regular_message() {
    incoming_file=$1
    incoming_id=$(header_value Id "$incoming_file")
    incoming_from=$(header_value From "$incoming_file")
    incoming_to=$(header_value To "$incoming_file")
    incoming_expires=$(header_value Expires "$incoming_file")
    if ! valid_address "$incoming_from" || ! valid_address "$incoming_to"; then
        sync_error "$incoming_file: 잘못된 주소 헤더"
        return
    fi
    if ! positive_or_zero_integer "$incoming_expires"; then
        sync_error "$incoming_file: 잘못된 Expires 헤더"
        return
    fi
    incoming_now=$(date +%s) || {
        sync_error "$incoming_file: 현재 시각을 읽지 못했습니다"
        return
    }
    if [ "$incoming_expires" -le "$incoming_now" ]; then
        if ! rm -f "$incoming_file"; then
            sync_error "$incoming_file: 만료된 spool 사본을 지우지 못했습니다"
        fi
        return
    fi
    incoming_session=${incoming_to%@*}
    incoming_dir=$KHALA_ROOT/inbox/$incoming_session
    if ! mkdir -p "$incoming_dir/new" "$incoming_dir/cur"; then
        sync_error "$incoming_file: inbox 디렉터리를 만들지 못했습니다"
        return
    fi
    if delivered_or_inbox "$incoming_session" "$incoming_id"; then
        :
    else
        delivered_status=$?
        [ "$delivered_status" -ne 2 ] || return
        if ! atomic_copy "$incoming_file" "$incoming_dir/new/$incoming_id"; then
            sync_error "$incoming_file: inbox 배달에 실패했습니다"
            return
        fi
        if ! record_delivered "$incoming_id"; then
            sync_error "$incoming_file: dedup 기록에 실패했습니다"
            return
        fi
    fi
    if ! queue_infrastructure_message ack "$incoming_to" "$incoming_from" \
        "$incoming_id" "Acknowledged $incoming_id"; then
        sync_error "$incoming_file: ack 생성에 실패했습니다"
        return
    fi
    # AMBIGUOUS: §9.6 does not name who removes a mailbox's delivered message
    # copy; deletion-free push cannot let the remote sender remove it.
    if ! rm -f "$incoming_file"; then
        sync_error "$incoming_file: 배달한 message 사본을 소비하지 못했습니다"
    fi
}

deliver_fire_and_forget() {
    incoming_file=$1
    incoming_id=$(header_value Id "$incoming_file")
    incoming_to=$(header_value To "$incoming_file")
    incoming_type=$(header_value Type "$incoming_file")
    if ! valid_address "$incoming_to"; then
        sync_error "$incoming_file: 잘못된 To 헤더"
        return
    fi
    if [ "$incoming_type" = notice ]; then
        incoming_expires=$(header_value Expires "$incoming_file")
        if ! bounded_integer "$incoming_expires"; then
            sync_error "$incoming_file: 잘못된 notice Expires 헤더"
            return
        fi
        incoming_expires=$(normalize_integer "$incoming_expires")
        incoming_now=$(date +%s) || {
            sync_error "$incoming_file: 현재 시각을 읽지 못했습니다"
            return
        }
        if [ "$incoming_expires" -le "$incoming_now" ]; then
            if ! rm -f "$incoming_file"; then
                sync_error "$incoming_file: 만료된 notice를 지우지 못했습니다"
            fi
            return
        fi
    fi
    incoming_session=${incoming_to%@*}
    incoming_dir=$KHALA_ROOT/inbox/$incoming_session
    if ! mkdir -p "$incoming_dir/new" "$incoming_dir/cur"; then
        sync_error "$incoming_file: inbox 디렉터리를 만들지 못했습니다"
        return
    fi
    if delivered_or_inbox "$incoming_session" "$incoming_id"; then
        :
    else
        delivered_status=$?
        [ "$delivered_status" -ne 2 ] || return
        if ! atomic_copy "$incoming_file" "$incoming_dir/new/$incoming_id"; then
            sync_error "$incoming_file: inbox 배달에 실패했습니다"
            return
        fi
        if ! record_delivered "$incoming_id"; then
            sync_error "$incoming_file: dedup 기록에 실패했습니다"
            return
        fi
    fi
    if ! rm -f "$incoming_file"; then
        sync_error "$incoming_file: fire-and-forget 사본을 소비하지 못했습니다"
    fi
}

deliver_messages() {
    local_spool=$1
    for incoming_file in "$local_spool"/*; do
        [ -f "$incoming_file" ] || continue
        if ! validate_spool_file "$incoming_file"; then
            move_old_invalid_spool_file "$incoming_file"
            continue
        fi
        incoming_type=$(header_value Type "$incoming_file")
        if [ "$incoming_type" = message ]; then
            deliver_regular_message "$incoming_file"
        fi
    done
}

expire_outbox() {
    expire_self=$1
    expire_now=$(date +%s) || {
        sync_error "현재 시각을 읽지 못했습니다"
        return
    }
    for expired_file in "$KHALA_ROOT"/outbox/new/*; do
        [ -f "$expired_file" ] || continue
        expired_id=$(header_value Id "$expired_file")
        expired_from=$(header_value From "$expired_file")
        expired_to=$(header_value To "$expired_file")
        expired_at=$(header_value Expires "$expired_file")
        if [ -z "$expired_id" ] || [ "$(basename "$expired_file")" != "$expired_id" ]; then
            sync_error "$expired_file: filename과 Id가 다릅니다"
            continue
        fi
        if ! valid_address "$expired_from" || ! valid_address "$expired_to"; then
            sync_error "$expired_file: 잘못된 주소 헤더"
            continue
        fi
        if ! positive_or_zero_integer "$expired_at"; then
            sync_error "$expired_file: 잘못된 Expires 헤더"
            continue
        fi
        if [ "$expired_at" -gt "$expire_now" ]; then
            continue
        fi
        if ! queue_infrastructure_message bounce "khala@$expire_self" "$expired_from" \
            "$expired_id" "Delivery expired for $expired_to"; then
            sync_error "$expired_file: bounce 생성에 실패했습니다"
            continue
        fi
        if ! mv "$expired_file" "$KHALA_ROOT/outbox/dead/$expired_id"; then
            sync_error "$expired_file: dead-letter 이동에 실패했습니다"
            continue
        fi
        touch "$KHALA_ROOT/outbox/dead/$expired_id" 2>/dev/null || :
        expired_node=${expired_to#*@}
        if ! rm -f "$KHALA_ROOT/spool/for/$expired_node/$expired_id"; then
            sync_error "$expired_file: spool 사본 삭제에 실패했습니다"
        fi
    done
}

deliver_infrastructure() {
    local_spool=$1
    for incoming_file in "$local_spool"/*; do
        [ -f "$incoming_file" ] || continue
        if ! validate_spool_file "$incoming_file"; then
            move_old_invalid_spool_file "$incoming_file"
            continue
        fi
        incoming_type=$(header_value Type "$incoming_file")
        case "$incoming_type" in
            bounce|notice) deliver_fire_and_forget "$incoming_file" ;;
        esac
    done
}

settle_acks() {
    local_spool=$1
    for ack_file in "$local_spool"/*; do
        [ -f "$ack_file" ] || continue
        if ! validate_spool_file "$ack_file"; then
            move_old_invalid_spool_file "$ack_file"
            continue
        fi
        ack_type=$(header_value Type "$ack_file")
        [ "$ack_type" = ack ] || continue
        ack_ref=$(header_value Refs "$ack_file")
        if [ -z "$ack_ref" ]; then
            sync_error "$ack_file: Refs 헤더가 없습니다"
            continue
        fi
        original_file=$KHALA_ROOT/outbox/new/$ack_ref
        archived_file=$KHALA_ROOT/outbox/acked/$ack_ref
        reference_file=
        if [ -f "$original_file" ]; then
            if ! mv "$original_file" "$archived_file"; then
                sync_error "$ack_file: 원문을 acked로 옮기지 못했습니다"
                continue
            fi
            touch "$archived_file" 2>/dev/null || :
            reference_file=$archived_file
        elif [ -f "$archived_file" ]; then
            reference_file=$archived_file
        elif [ -f "$KHALA_ROOT/outbox/dead/$ack_ref" ]; then
            reference_file=$KHALA_ROOT/outbox/dead/$ack_ref
        fi
        if [ -n "$reference_file" ]; then
            original_to=$(header_value To "$reference_file")
            if valid_address "$original_to"; then
                original_node=${original_to#*@}
                if ! rm -f "$KHALA_ROOT/spool/for/$original_node/$ack_ref"; then
                    sync_error "$ack_file: message spool 사본을 지우지 못했습니다"
                    continue
                fi
            fi
        fi
        if ! rm -f "$ack_file"; then
            sync_error "$ack_file: ack를 소비하지 못했습니다"
        fi
    done
}

prune_delivered_log() {
    prune_now=$(date +%s) || {
        sync_error "현재 시각을 읽지 못했습니다"
        return
    }
    prune_before=$((prune_now - 5184000))
    prune_tmp=$(mktemp "$TMP_DIR/prune.XXXXXX") || {
        sync_error "dedup 로그 임시 파일을 만들지 못했습니다"
        return
    }
    while IFS=' ' read -r prune_epoch prune_id prune_extra; do
        [ -n "${prune_epoch-}" ] || continue
        if ! positive_or_zero_integer "$prune_epoch" || [ -z "${prune_id-}" ]; then
            sync_error "log/delivered에 잘못된 행이 있습니다"
            printf '%s %s%s\n' "$prune_epoch" "${prune_id-}" "${prune_extra:+ $prune_extra}" >> "$prune_tmp"
            continue
        fi
        if [ "$prune_epoch" -ge "$prune_before" ]; then
            printf '%s %s\n' "$prune_epoch" "$prune_id" >> "$prune_tmp"
        fi
    done < "$KHALA_ROOT/log/delivered"
    if cmp -s "$prune_tmp" "$KHALA_ROOT/log/delivered"; then
        rm -f "$prune_tmp"
    elif ! mv "$prune_tmp" "$KHALA_ROOT/log/delivered"; then
        rm -f "$prune_tmp"
        sync_error "dedup 로그 정리에 실패했습니다"
    fi
}

# A directory symlink under inbox/, outbox/ or spool/ would let a retention
# glob follow it out of KHALA_ROOT. Every directory between the root and the
# file must be a real directory; the file itself is checked with -L by callers.
retention_path_inside_root() {
    retention_rel=${1#"$KHALA_ROOT"/}
    [ "$retention_rel" != "$1" ] || return 1
    retention_walk=$KHALA_ROOT
    retention_rest=$retention_rel
    while [ "$retention_rest" != "${retention_rest#*/}" ]; do
        retention_walk=$retention_walk/${retention_rest%%/*}
        retention_rest=${retention_rest#*/}
        [ ! -L "$retention_walk" ] && [ -d "$retention_walk" ] || return 1
    done
    return 0
}

prune_expired_notices() {
    prune_notice_now=$(date +%s) || {
        sync_error "현재 시각을 읽지 못했습니다"
        return
    }
    for prune_notice_file in "$KHALA_ROOT"/spool/for/*/* \
        "$KHALA_ROOT"/inbox/*/new/* "$KHALA_ROOT"/inbox/*/cur/*; do
        [ -f "$prune_notice_file" ] || continue
        [ -L "$prune_notice_file" ] && continue
        retention_path_inside_root "$prune_notice_file" || continue
        [ "$(header_value Type "$prune_notice_file")" = notice ] || continue
        prune_notice_expires=$(header_value Expires "$prune_notice_file")
        bounded_integer "$prune_notice_expires" || continue
        prune_notice_expires=$(normalize_integer "$prune_notice_expires")
        if [ "$prune_notice_expires" -le "$prune_notice_now" ]; then
            if ! rm -f "$prune_notice_file"; then
                sync_error "$prune_notice_file: 만료된 notice를 지우지 못했습니다"
            fi
        fi
    done
}

prune_letter_archives() {
    prune_archive_now=$(date +%s) || {
        sync_error "현재 시각을 읽지 못했습니다"
        return
    }
    prune_archive_days=$(retain_days) || {
        sync_error "letter retention 설정을 읽지 못했습니다"
        return
    }
    prune_archive_seconds=$((prune_archive_days * 86400))
    for prune_archive_file in "$KHALA_ROOT"/inbox/*/cur/* \
        "$KHALA_ROOT"/outbox/acked/* "$KHALA_ROOT"/outbox/dead/*; do
        [ -f "$prune_archive_file" ] || continue
        [ -L "$prune_archive_file" ] && continue
        retention_path_inside_root "$prune_archive_file" || continue
        prune_archive_id=$(header_value Id "$prune_archive_file")
        valid_message_id "$prune_archive_id" || continue
        # Age = time the file entered this state (drain/ack/expiry touch its
        # mtime), never the Id epoch: a letter that waited 31 days in new/ must
        # not vanish the moment it is drained. A file whose mtime predates its
        # own Id (clock skew, restored backup) falls back to the Id epoch.
        prune_archive_epoch=$(file_mtime "$prune_archive_file") || prune_archive_epoch=
        bounded_integer "${prune_archive_id%%.*}" || continue
        prune_archive_id_epoch=$(normalize_integer "${prune_archive_id%%.*}")
        if ! bounded_integer "${prune_archive_epoch-}" || \
            [ "$prune_archive_epoch" -lt "$prune_archive_id_epoch" ]; then
            prune_archive_epoch=$prune_archive_id_epoch
        fi
        if [ "$prune_archive_epoch" -le "$prune_archive_now" ] && \
            [ "$((prune_archive_now - prune_archive_epoch))" -gt "$prune_archive_seconds" ]; then
            if ! rm -f "$prune_archive_file"; then
                sync_error "$prune_archive_file: retention 지난 letter를 지우지 못했습니다"
            fi
        fi
    done
}

watcher_deadman() {
    deadman_node=$1
    deadman_now=$(date +%s) || {
        sync_error "현재 시각을 읽지 못했습니다"
        return
    }
    for deadman_marker in "$KHALA_ROOT"/presence/*@"$deadman_node".watcher; do
        [ -f "$deadman_marker" ] || continue
        [ -L "$deadman_marker" ] && continue
        deadman_address=$(basename "$deadman_marker" .watcher)
        if ! valid_address "$deadman_address"; then
            sync_error "$deadman_marker: 잘못된 watcher marker 파일명"
            continue
        fi
        if ! read_watcher_marker "$deadman_marker"; then
            sync_error "$deadman_marker: 잘못된 watcher marker"
            continue
        fi
        [ "$WATCHER_RETIRED" -eq 0 ] || continue
        [ "$WATCHER_CADENCE" -gt 0 ] || continue
        [ "$WATCHER_L3" != - ] || continue
        deadman_transition=
        deadman_urgency=
        deadman_subject=
        deadman_next_state=
        if [ "$WATCHER_LAST_NOTIFY" -gt 0 ]; then
            deadman_anchor=$WATCHER_LAST_NOTIFY
        else
            # An event-only watcher may never have notified; its declaration
            # epoch is the explicit dead-man baseline until the first beat.
            deadman_anchor=$WATCHER_DECLARED
        fi
        if [ "$deadman_now" -ge "$deadman_anchor" ]; then
            deadman_age_seconds=$((deadman_now - deadman_anchor))
        else
            deadman_age_seconds=0
        fi
        deadman_state=${WATCHER_L5%% *}
        deadman_name=${deadman_address%@*}
        if [ "$deadman_state" = active ] && \
            [ "$deadman_age_seconds" -gt "$((2 * WATCHER_CADENCE))" ]; then
            deadman_transition=silent
            deadman_urgency=urgent
            deadman_age=$(relative_age "$deadman_anchor" "$deadman_now")
            deadman_subject="[watcher] $deadman_name silent $deadman_age (cadence ${WATCHER_CADENCE}s)"
            deadman_next_state="silent $deadman_now"
        elif [ "$deadman_state" = silent ] && \
            [ "$deadman_age_seconds" -le "$((2 * WATCHER_CADENCE))" ]; then
            deadman_transition=active
            deadman_urgency=info
            deadman_subject="[watcher] $deadman_name active again"
            deadman_next_state=active
        fi
        [ -n "$deadman_transition" ] || continue
        deadman_body=$(mktemp "$TMP_DIR/deadman-body.XXXXXX") || {
            sync_error "$deadman_marker: dead-man 본문 임시 파일을 만들지 못했습니다"
            continue
        }
        if ! printf 'watcher marker: %s\n' "$deadman_marker" > "$deadman_body"; then
            rm -f "$deadman_body"
            sync_error "$deadman_marker: dead-man 본문을 쓰지 못했습니다"
            continue
        fi
        deadman_expires=$((deadman_now + 172800))
        case "$WATCHER_L3" in
            *@*) deadman_owner=$WATCHER_L3 ;;
            *) deadman_owner=$WATCHER_L3@$deadman_node ;;
        esac
        if ! queue_notice "$deadman_address" "$deadman_owner" \
            "$deadman_urgency" "$deadman_subject" "$deadman_expires" "$deadman_body"; then
            rm -f "$deadman_body"
            sync_error "$deadman_marker: dead-man notice를 만들지 못했습니다"
            continue
        fi
        rm -f "$deadman_body"
        if ! write_watcher_marker "$deadman_marker" "$WATCHER_L1" "$WATCHER_L2" \
            "$WATCHER_L3" "$WATCHER_L4" "$deadman_next_state" "$deadman_now"; then
            rm -f "$KHALA_ROOT/spool/for/$deadman_node/$NOTICE_ID"
            sync_error "$deadman_marker: dead-man 상태를 기록하지 못했습니다"
        fi
    done
}

# Every pass: validate, quarantine garbage and future epochs. The retention
# deletion (and its preserve capture) waits for the retention interval
# ($1 = 1 when that sweep is due).
prune_stream_entries() {
    prune_stream_retention=$1
    prune_stream_now=$(date +%s) || {
        sync_error "현재 시각을 읽지 못했습니다"
        return
    }
    prune_stream_days=$(retain_days) || {
        sync_error "stream retention 설정을 읽지 못했습니다"
        return
    }
    prune_stream_seconds=$((prune_stream_days * 86400))
    for prune_stream_file in "$KHALA_ROOT"/streams/*/*/*; do
        [ -f "$prune_stream_file" ] || continue
        prune_stream_node_dir=${prune_stream_file%/*}
        prune_stream_node=${prune_stream_node_dir##*/}
        prune_stream_name_dir=${prune_stream_node_dir%/*}
        prune_stream_name=${prune_stream_name_dir##*/}
        prune_stream_id=${prune_stream_file##*/}
        if ! valid_name "$prune_stream_name" || ! valid_name "$prune_stream_node" || \
            ! validate_stream_file "$prune_stream_file" "$prune_stream_name" "$prune_stream_node"; then
            quarantine_stream_file "$prune_stream_file" "$prune_stream_name" \
                "$prune_stream_node" "$prune_stream_id" "잘못된 stream 항목" || \
                sync_error "$prune_stream_file: 잘못된 stream 항목 격리에 실패했습니다"
            continue
        fi
        prune_stream_epoch=$(normalize_integer "${prune_stream_id%%.*}")
        if [ "$prune_stream_epoch" -gt "$((prune_stream_now + 86400))" ]; then
            quarantine_stream_file "$prune_stream_file" "$prune_stream_name" \
                "$prune_stream_node" "$prune_stream_id" "하루를 넘는 미래 epoch" || \
                sync_error "$prune_stream_file: 미래 stream 항목 격리에 실패했습니다"
            continue
        fi
        [ "$prune_stream_retention" -eq 1 ] || continue
        if [ "$((prune_stream_epoch + prune_stream_seconds))" -lt "$prune_stream_now" ]; then
            if [ "$PRESERVE_CONFIG_INVALID" -eq 1 ]; then
                PRESERVER_DEGRADED=1
                sync_error "preserver degraded: preserve config 오류 때문에 만료 stream을 보존합니다"
                continue
            fi
            if preserve_stream_selected "$prune_stream_name"; then
                if [ "$PRESERVER_READY" -ne 1 ]; then
                    PRESERVER_DEGRADED=1
                    sync_error "preserver degraded: archive 기질이 준비되지 않아 $prune_stream_id live를 지우지 않습니다"
                    continue
                fi
                if ! archive_stream_file "$prune_stream_file" "$prune_stream_name" \
                    "$prune_stream_node" "$prune_stream_id"; then
                    PRESERVER_DEGRADED=1
                    sync_error "preserver degraded: $prune_stream_id 미정착 — live를 지우지 않습니다"
                    continue
                fi
            fi
            if ! rm -f "$prune_stream_file"; then
                sync_error "$prune_stream_file: retention 지난 stream 항목을 지우지 못했습니다"
            fi
        fi
    done
}

# Every pass: validate and quarantine, and collect every generation below the
# current maximum (protocol 1.2 GC — a delayed lower generation must not
# outlive the next reconcile). Only the retention deletion of the maximum
# waits for the retention interval ($1 = 1 when that sweep is due).
prune_mind_generations() {
    prune_mind_retention=$1
    prune_mind_now=$(date +%s) || {
        sync_error "현재 시각을 읽지 못했습니다"
        return
    }
    prune_mind_days=$(retain_days) || {
        sync_error "mind retention 설정을 읽지 못했습니다"
        return
    }
    prune_mind_seconds=$((prune_mind_days * 86400))
    for prune_mind_session_dir in "$KHALA_ROOT"/minds/*/*; do
        [ -d "$prune_mind_session_dir" ] || continue
        prune_mind_node_dir=${prune_mind_session_dir%/*}
        prune_mind_node=${prune_mind_node_dir##*/}
        prune_mind_session=${prune_mind_session_dir##*/}
        for prune_mind_file in "$prune_mind_session_dir"/*; do
            [ -f "$prune_mind_file" ] || continue
            prune_mind_generation=${prune_mind_file##*/}
            if ! validate_mind_file "$prune_mind_file" "$prune_mind_node" \
                "$prune_mind_session" "$prune_mind_generation"; then
                quarantine_mind_file "$prune_mind_file" "$prune_mind_node" \
                    "$prune_mind_session" "$prune_mind_generation" \
                    "잘못된 mind generation" || \
                    sync_error "$prune_mind_file: mind quarantine에 실패했습니다"
                continue
            fi
            prune_mind_epoch=$(normalize_integer "${prune_mind_generation%%.*}")
            if [ "$prune_mind_epoch" -gt "$((prune_mind_now + 86400))" ]; then
                quarantine_mind_file "$prune_mind_file" "$prune_mind_node" \
                    "$prune_mind_session" "$prune_mind_generation" \
                    "하루를 넘는 미래 epoch" || \
                    sync_error "$prune_mind_file: 미래 mind quarantine에 실패했습니다"
            fi
        done
        if ! prune_mind_current=$(current_mind_generation "$prune_mind_node" \
            "$prune_mind_session"); then
            sync_error "$prune_mind_session_dir: 현재 mind generation을 정하지 못했습니다"
            continue
        fi
        [ -n "$prune_mind_current" ] || {
            rmdir "$prune_mind_session_dir" 2>/dev/null || :
            continue
        }
        for prune_mind_file in "$prune_mind_session_dir"/*; do
            [ -f "$prune_mind_file" ] || continue
            if [ "$prune_mind_file" != "$prune_mind_current" ]; then
                if ! rm -f "$prune_mind_file"; then
                    sync_error "$prune_mind_file: 낮은 mind generation을 GC하지 못했습니다"
                fi
            fi
        done
        [ "$prune_mind_retention" -eq 1 ] || continue
        prune_mind_generation=${prune_mind_current##*/}
        prune_mind_epoch=$(normalize_integer "${prune_mind_generation%%.*}")
        if [ "$((prune_mind_epoch + prune_mind_seconds))" -lt "$prune_mind_now" ]; then
            if ! rm -f "$prune_mind_current"; then
                sync_error "$prune_mind_current: retention 지난 최대 mind generation을 지우지 못했습니다"
            fi
        fi
        rmdir "$prune_mind_session_dir" 2>/dev/null || :
    done
    for prune_mind_node_dir in "$KHALA_ROOT"/minds/*; do
        [ -d "$prune_mind_node_dir" ] || continue
        rmdir "$prune_mind_node_dir" 2>/dev/null || :
    done
}

presence_record_epoch() {
    presence_record_file=$1
    IFS=' ' read -r presence_record_first presence_record_second presence_record_extra \
        < "$presence_record_file"
    if [ "$presence_record_first" = retired ]; then
        presence_record_value=$presence_record_second
        [ -z "${presence_record_extra-}" ] || return 1
    else
        presence_record_value=$presence_record_first
        [ -z "${presence_record_second-}" ] && [ -z "${presence_record_extra-}" ] || return 1
    fi
    positive_or_zero_integer "$presence_record_value" || return 1
    normalize_integer "$presence_record_value"
}

prune_presence() {
    prune_presence_now=$(date +%s) || {
        sync_error "현재 시각을 읽지 못했습니다"
        return
    }
    prune_presence_days=$(retain_days) || {
        sync_error "presence retention 설정을 읽지 못했습니다"
        return
    }
    prune_presence_seconds=$((prune_presence_days * 86400))
    for prune_presence_file in "$KHALA_ROOT"/presence/*; do
        [ -f "$prune_presence_file" ] || continue
        case "$prune_presence_file" in
            *.watching) continue ;;
            *.watcher)
                [ -L "$prune_presence_file" ] && continue
                if ! read_watcher_marker "$prune_presence_file"; then
                    sync_error "$prune_presence_file: 잘못된 watcher marker"
                    continue
                fi
                prune_presence_declared_old=0
                prune_presence_notify_old=0
                if [ "$((WATCHER_DECLARED + prune_presence_seconds))" -lt \
                    "$prune_presence_now" ]; then
                    prune_presence_declared_old=1
                fi
                if [ "$((WATCHER_LAST_NOTIFY + prune_presence_seconds))" -lt \
                    "$prune_presence_now" ]; then
                    prune_presence_notify_old=1
                fi
                if { [ "$WATCHER_RETIRED" -eq 1 ] && \
                    [ "$prune_presence_declared_old" -eq 1 ]; } || \
                    { [ "$prune_presence_declared_old" -eq 1 ] && \
                    [ "$prune_presence_notify_old" -eq 1 ]; }; then
                    if ! rm -f "$prune_presence_file"; then
                        sync_error "$prune_presence_file: retention 지난 watcher marker를 지우지 못했습니다"
                    fi
                fi
                continue
                ;;
        esac
        if ! prune_presence_epoch=$(presence_record_epoch "$prune_presence_file"); then
            sync_error "$prune_presence_file: 잘못된 heartbeat"
            continue
        fi
        if [ "$((prune_presence_epoch + prune_presence_seconds))" -lt "$prune_presence_now" ]; then
            if ! rm -f "$prune_presence_file"; then
                sync_error "$prune_presence_file: retention 지난 heartbeat를 지우지 못했습니다"
            fi
        fi
    done
}

prune_session_stream_state() {
    state_self=$1
    for state_family in join cursor; do
        for state_session_dir in "$KHALA_ROOT/$state_family"/*; do
            [ -d "$state_session_dir" ] || continue
            state_session=$(basename "$state_session_dir")
            state_presence=$KHALA_ROOT/presence/$state_session@$state_self
            state_collect=0
            if [ ! -f "$state_presence" ]; then
                state_collect=1
            else
                IFS=' ' read -r state_presence_kind state_presence_epoch state_presence_extra \
                    < "$state_presence"
                if [ "$state_presence_kind" = retired ]; then
                    state_collect=1
                fi
            fi
            [ "$state_collect" -eq 1 ] || continue
            for state_file in "$state_session_dir"/*; do
                [ -f "$state_file" ] || continue
                if ! rm -f "$state_file"; then
                    sync_error "$state_file: 죽은 세션의 stream 상태를 지우지 못했습니다"
                fi
            done
            rmdir "$state_session_dir" 2>/dev/null || :
        done
    done
}

reconcile_cycle() {
    reconcile_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$reconcile_lock" 300 reconcile; then
        sync_error "brain lock을 얻지 못했습니다"
        return 1
    fi
    if ! reconcile_self=$(self_node); then
        sync_error "self node를 읽지 못했습니다"
    else
        copy_outbox_to_spool
        # A broken retention-interval must not silently stop the sweeps: report it
        # and sweep on this pass as if the interval were 0.
        if reconcile_interval=$(retention_interval_seconds); then
            if retention_due "$reconcile_interval"; then
                reconcile_retention=1
            else
                reconcile_retention=0
            fi
        else
            sync_error "retention-interval 설정을 읽지 못했습니다 — 이번 pass는 age-out 정리를 그냥 돌립니다"
            reconcile_retention=1
        fi
        [ "$reconcile_retention" -eq 0 ] || prune_expired_notices
        reconcile_spool=$KHALA_ROOT/spool/for/$reconcile_self
        if ! mkdir -p "$reconcile_spool"; then
            sync_error "로컬 spool 디렉터리를 만들지 못했습니다"
        else
            watcher_deadman "$reconcile_self"
            deliver_messages "$reconcile_spool"
            deliver_infrastructure "$reconcile_spool"
            settle_acks "$reconcile_spool"
        fi
        expire_outbox "$reconcile_self"
        if [ "$reconcile_retention" -eq 1 ]; then
            prune_letter_archives
            prune_delivered_log
        fi
        if ! load_preserve_config; then
            sync_error "preserver degraded: preserve config를 읽지 못했습니다"
        elif ! capture_preserved_streams; then
            sync_error "preserver degraded: 하나 이상의 live stream을 정착시키지 못했습니다"
        fi
        prune_stream_entries "$reconcile_retention"
        prune_mind_generations "$reconcile_retention"
        [ "$reconcile_retention" -eq 0 ] || prune_presence
        prune_session_stream_state "$reconcile_self"
    fi
    if ! release_lock "$reconcile_lock"; then
        sync_error "brain lock을 해제하지 못했습니다"
    fi
    [ "$SYNC_FAILED" -eq 0 ]
}

settle_visible_acks() {
    settle_self=$1
    settle_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$settle_lock" 300 exchange-settle; then
        sync_error "ack 정산용 brain lock을 얻지 못했습니다"
        return 1
    fi
    settle_acks "$KHALA_ROOT/spool/for/$settle_self"
    if ! release_lock "$settle_lock"; then
        sync_error "ack 정산용 brain lock을 해제하지 못했습니다"
        return 1
    fi
    return 0
}

exchange_cycle() {
    exchange_lock=$KHALA_ROOT/run/exchange.lock.d
    if ! acquire_lock "$exchange_lock" 120 exchange; then
        sync_error "exchange lock을 얻지 못했습니다"
        return 1
    fi
    if ! exchange_self=$(self_node); then
        sync_error "self node를 읽지 못했습니다"
    else
        exchange_mailbox_line=$(sed -n 's/^mailbox //p' "$CONFIG")
        exchange_self_is_mailbox=0
        for exchange_mailbox_node in $exchange_mailbox_line; do
            if [ "$exchange_mailbox_node" = "$exchange_self" ]; then
                exchange_self_is_mailbox=1
            fi
        done
        if [ "$exchange_self_is_mailbox" -ne 1 ]; then
            exchange_with_mailbox "$exchange_self"
        fi
    fi
    if ! release_lock "$exchange_lock"; then
        sync_error "exchange lock을 해제하지 못했습니다"
    fi
    [ "$SYNC_FAILED" -eq 0 ]
}

run_sync_cycles() {
    SYNC_FAILED=0
    reconcile_cycle || :
    exchange_cycle || :
    reconcile_cycle || :
    [ "$SYNC_FAILED" -eq 0 ]
}

cmd_init() {
    if [ "$#" -ne 1 ]; then
        usage
        return 1
    fi
    init_node=$1
    if ! valid_name "$init_node"; then
        error "잘못된 노드 별칭: $init_node"
        return 1
    fi
    if [ -e "$CONFIG" ]; then
        error "이미 초기화되어 있습니다: $KHALA_ROOT"
        return 1
    fi
    if ! mkdir -p \
        "$KHALA_ROOT/outbox/new" \
        "$KHALA_ROOT/outbox/acked" \
        "$KHALA_ROOT/outbox/dead" \
        "$KHALA_ROOT/spool/for/$init_node" \
        "$KHALA_ROOT/inbox" \
        "$KHALA_ROOT/presence" \
        "$KHALA_ROOT/streams" \
        "$KHALA_ROOT/minds" \
        "$KHALA_ROOT/join" \
        "$KHALA_ROOT/cursor" \
        "$KHALA_ROOT/log" \
        "$KHALA_ROOT/run" \
        "$KHALA_ROOT/tmp"; then
        error "디렉터리 구조를 만들지 못했습니다: $KHALA_ROOT"
        return 1
    fi
    if ! chmod 700 "$KHALA_ROOT"; then
        error "KHALA_HOME을 0700으로 설정하지 못했습니다"
        return 1
    fi
    if ! chmod 700 "$KHALA_ROOT/run"; then
        error "run 디렉터리를 0700으로 설정하지 못했습니다"
        return 1
    fi
    init_config=$(mktemp "$TMP_DIR/config.XXXXXX") || return 1
    if ! {
        printf 'self %s\n' "$init_node"
        printf 'peer %s %s\n' "$init_node" "$init_node"
        printf 'mailbox %s\n' "$init_node"
        printf 'ttl 120\n'
        printf 'retain 30\n'
    } > "$init_config"; then
        rm -f "$init_config"
        error "config를 쓰지 못했습니다"
        return 1
    fi
    init_log=$(mktemp "$TMP_DIR/delivered.XXXXXX") || {
        rm -f "$init_config"
        return 1
    }
    if ! mv "$init_log" "$KHALA_ROOT/log/delivered"; then
        rm -f "$init_log" "$init_config"
        error "dedup 로그를 만들지 못했습니다"
        return 1
    fi
    if ! mv "$init_config" "$CONFIG"; then
        rm -f "$init_config"
        error "config를 설치하지 못했습니다"
        return 1
    fi
    printf 'initialized %s at %s\n' "$init_node" "$KHALA_ROOT"
    return 0
}

invite_version_newer() {
    [ "$1" != "$2" ] || return 1
    awk -v have="$1" -v current="$2" 'BEGIN {
        have_n = split(have, have_parts, ".")
        current_n = split(current, current_parts, ".")
        count = have_n > current_n ? have_n : current_n
        for (i = 1; i <= count; i++) {
            have_part = i <= have_n ? have_parts[i] + 0 : 0
            current_part = i <= current_n ? current_parts[i] + 0 : 0
            if (have_part > current_part) exit 0
            if (have_part < current_part) exit 1
        }
        exit 1
    }'
}

invite_install_source() {
    invite_executable=$0
    case "$invite_executable" in
        */*) ;;
        *) invite_executable=$(command -v "$invite_executable" 2>/dev/null) || invite_executable= ;;
    esac
    if [ -n "$invite_executable" ]; then
        invite_executable_dir=$(CDPATH= cd -- "$(dirname -- "$invite_executable")" 2>/dev/null && pwd) || \
            invite_executable_dir=
        if [ -n "$invite_executable_dir" ] && [ -f "$invite_executable_dir/../install.sh" ]; then
            printf '%s\n' "$invite_executable_dir/../install.sh"
            return 0
        fi
    fi

    invite_cache_root=$HOME/.claude/plugins/cache/jahns-cc-marketplace/khala
    invite_best_version=
    invite_best_install=
    for invite_cache_install in "$invite_cache_root"/*/install.sh; do
        [ -f "$invite_cache_install" ] || continue
        invite_cache_version=$(basename "$(dirname "$invite_cache_install")")
        printf '%s\n' "$invite_cache_version" | grep -Eq '^[0-9][0-9.]*$' || continue
        if [ -z "$invite_best_version" ] || \
            invite_version_newer "$invite_cache_version" "$invite_best_version"; then
            invite_best_version=$invite_cache_version
            invite_best_install=$invite_cache_install
        fi
    done
    [ -n "$invite_best_install" ] || return 1
    printf '%s\n' "$invite_best_install"
}

invite_shell_quote() {
    printf "'"
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
    printf "'"
}

cmd_invite() {
    require_config || return 1
    if [ "$#" -eq 0 ]; then
        usage invite
        return 1
    fi
    invite_target=$1
    shift
    case "$invite_target" in
        ''|-*) error "잘못된 SSH 대상: $invite_target"; return 1 ;;
    esac
    invite_name=
    invite_mailbox_coord_override=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                [ "$#" -ge 2 ] || { error "--name 값이 없습니다"; return 1; }
                invite_name=$2
                shift 2
                ;;
            --mailbox-coord)
                [ "$#" -ge 2 ] || { error "--mailbox-coord 값이 없습니다"; return 1; }
                invite_mailbox_coord_override=$2
                shift 2
                ;;
            *) error "알 수 없는 invite 옵션: $1"; return 1 ;;
        esac
    done
    [ -n "$invite_name" ] || { error "--name이 필요합니다"; usage invite; return 1; }
    valid_name "$invite_name" || { error "잘못된 노드 별칭: $invite_name"; return 1; }

    invite_mailbox_line=$(sed -n 's/^mailbox //p' "$CONFIG" | head -n 1)
    set -- $invite_mailbox_line
    invite_mailbox_name=${1-}
    valid_name "$invite_mailbox_name" || {
        error "config의 mailbox 항목이 없거나 잘못되었습니다"
        return 1
    }
    if [ -n "$invite_mailbox_coord_override" ]; then
        invite_mailbox_coord=$invite_mailbox_coord_override
    else
        invite_peer_line=$(sed -n "s/^peer $invite_mailbox_name //p" "$CONFIG" | head -n 1)
        set -- $invite_peer_line
        invite_mailbox_coord=${1-}
    fi
    case "$invite_mailbox_coord" in
        *@*|/*) ;;
        '')
            # AMBIGUOUS: bootstrap config intentionally has no peer line, while
            # invite is specified for every joined node. Requiring the explicit
            # portable coordinate preserves both on-disk shapes without guessing.
            error "mailbox $invite_mailbox_name 좌표가 config에 없습니다 — --mailbox-coord <user@host>를 지정하세요"
            return 1
            ;;
        *)
            error "mailbox 좌표 '$invite_mailbox_coord'는 로컬 SSH alias로 보입니다 — --mailbox-coord <user@host>를 지정하세요"
            return 1
            ;;
    esac

    invite_install=$(invite_install_source) || {
        error "플러그인 cache나 repo checkout에서 install.sh를 찾지 못했습니다"
        return 1
    }
    invite_remote_command="sh -s -- --name $(invite_shell_quote "$invite_name") --mailbox $(invite_shell_quote "$invite_mailbox_name") $(invite_shell_quote "$invite_mailbox_coord")"
    if ! ssh "$invite_target" "$invite_remote_command" < "$invite_install"; then
        error "$invite_target 원격 설치가 실패했습니다"
        return 1
    fi

    invite_status_output=$(ssh "$invite_target" '~/.local/bin/khala status | head -1' 2>&1)
    invite_status_rc=$?
    printf 'khala invite: status: %s\n' "$invite_status_output"
    invite_sync_output=$(ssh "$invite_target" '~/.local/bin/khala sync' 2>&1)
    invite_sync_rc=$?
    printf 'khala invite: sync: %s\n' "$invite_sync_output"
    if [ "$invite_status_rc" -ne 0 ] || [ "$invite_sync_rc" -ne 0 ]; then
        error "원격 status/sync 확인 중 실패가 있었습니다"
        return 1
    fi
    printf '%s\n' 'khala invite: 설치와 status/sync 호출을 확인했습니다; presence 행은 그 노드에서 세션을 연 뒤 나타납니다'
    return 0
}

cmd_send() {
    require_config || return 1
    if [ "$#" -lt 1 ]; then
        usage
        return 1
    fi
    send_to=$1
    shift
    case "$send_to" in
        --*)
            error "알 수 없는 send 옵션: $send_to; 사용 가능: -s/--subject, -m/--message/--body, -e, --reply-to, --later, --as"
            return 1
            ;;
    esac
    if ! valid_address "$send_to"; then
        error "잘못된 주소: $send_to"
        return 1
    fi
    send_subject=
    send_ttl=2592000
    send_body=
    send_body_set=0
    send_as=
    send_as_set=0
    send_reply_to=
    send_later=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -s|--subject)
                [ "$#" -ge 2 ] || { error "$1 값이 없습니다"; return 1; }
                send_subject=$2
                shift 2
                ;;
            -e)
                [ "$#" -ge 2 ] || { error "-e 값이 없습니다"; return 1; }
                send_ttl=$2
                shift 2
                ;;
            -m|--message|--body)
                [ "$#" -ge 2 ] || { error "$1 값이 없습니다"; return 1; }
                send_body=$2
                send_body_set=1
                shift 2
                ;;
            --reply-to)
                [ "$#" -ge 2 ] || { error "--reply-to 값이 없습니다"; return 1; }
                send_reply_to=$2
                shift 2
                ;;
            --later)
                send_later=1
                shift
                ;;
            --as)
                [ "$#" -ge 2 ] || { error "--as 값이 없습니다"; return 1; }
                send_as=$2
                send_as_set=1
                shift 2
                ;;
            --*)
                error "알 수 없는 send 옵션: $1; 사용 가능: -s/--subject, -m/--message/--body, -e, --reply-to, --later, --as"
                return 1
                ;;
            *)
                error "알 수 없는 send 옵션: $1"
                return 1
                ;;
        esac
    done
    if ! bounded_integer "$send_ttl"; then
        error "만료 초는 0 이상 18자리 이하의 정수여야 합니다"
        return 1
    fi
    send_ttl=$(normalize_integer "$send_ttl")
    # The delivered-Id dedup log is kept 60 days; a letter that could still be
    # retransmitted after its dedup entry expired would be installed twice.
    if [ "$send_ttl" -gt 5097600 ]; then
        error "만료 초는 5097600(59일) 이하여야 합니다 — dedup 기록 보존(60일) 안에 들어야 합니다"
        return 1
    fi
    case "$send_subject" in
        *'
'*) error "제목에는 줄바꿈을 넣을 수 없습니다"; return 1 ;;
    esac
    if [ -n "$send_reply_to" ] && ! valid_message_id "$send_reply_to"; then
        error "잘못된 reply Id: $send_reply_to"
        return 1
    fi
    send_node=$(self_node) || return 1
    send_session=$(session_name "$send_as" "$send_as_set") || return 1
    if [ "$send_as_set" -eq 1 ]; then
        printf '%s\n' 'khala send --as: 세션이 아닌 발신자라면 khala notify를 쓰세요' >&2
    fi
    send_from=$send_session@$send_node
    send_now=$(date +%s) || { error "현재 시각을 읽지 못했습니다"; return 1; }
    send_expires=$((send_now + send_ttl))
    send_date=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || return 1
    send_id=$(new_message_id "$send_from") || return 1
    if ! heartbeat "$send_session"; then
        error "heartbeat를 갱신하지 못했습니다"
        return 1
    fi
    send_tmp=$(mktemp "$TMP_DIR/message.XXXXXX") || return 1
    if ! {
        printf 'Khala: 0.1\n'
        printf 'Id: %s\n' "$send_id"
        printf 'From: %s\n' "$send_from"
        printf 'To: %s\n' "$send_to"
        printf 'Date: %s\n' "$send_date"
        printf 'Type: message\n'
        # AMBIGUOUS: §9.6 exposes -s but does not define its on-disk header.
        if [ -n "$send_subject" ]; then
            printf 'Subject: %s\n' "$send_subject"
        fi
        if [ -n "$send_reply_to" ]; then
            printf 'In-Reply-To: %s\n' "$send_reply_to"
        fi
        if [ "$send_later" -eq 1 ]; then
            printf 'Priority: later\n'
        fi
        printf 'Expires: %s\n' "$send_expires"
        printf '\n'
        if [ "$send_body_set" -eq 1 ]; then
            printf '%s\n' "$send_body"
        else
            cat
        fi
    } > "$send_tmp"; then
        rm -f "$send_tmp"
        error "메시지를 쓰지 못했습니다"
        return 1
    fi
    send_destination=$KHALA_ROOT/outbox/new/$send_id
    if ! ln "$send_tmp" "$send_destination" 2>/dev/null; then
        rm -f "$send_tmp"
        if [ -e "$send_destination" ]; then
            error "$send_id: 이미 존재하는 Id라 발신 큐를 덮어쓰지 않습니다"
        else
            error "메시지를 발신 큐에 원자적으로 안착시키지 못했습니다"
        fi
        return 1
    fi
    rm -f "$send_tmp"
    send_destination_node=${send_to#*@}
    send_spool_dir=$KHALA_ROOT/spool/for/$send_destination_node
    if ! mkdir -p "$send_spool_dir" || \
        ! atomic_copy "$send_destination" "$send_spool_dir/$send_id"; then
        error "$send_id: 즉시 spool 물질화에 실패했습니다; 다음 reconcile에서 재시도합니다"
    fi
    printf '%s\n' "$send_id"
    return 0
}

cmd_notify() {
    require_config || return 1
    [ "$#" -ge 1 ] || { usage notify; return 1; }
    notify_to=$1
    shift
    if ! valid_address "$notify_to"; then
        error "잘못된 주소: $notify_to"
        return 1
    fi
    notify_as=
    notify_as_set=0
    notify_subject=
    notify_urgency=info
    notify_ttl=172800
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --as)
                [ "$#" -ge 2 ] || { error "--as 값이 없습니다"; return 1; }
                notify_as=$2
                notify_as_set=1
                shift 2
                ;;
            -s|--subject)
                [ "$#" -ge 2 ] || { error "$1 값이 없습니다"; return 1; }
                notify_subject=$2
                shift 2
                ;;
            --urgent)
                notify_urgency=urgent
                shift
                ;;
            -e)
                [ "$#" -ge 2 ] || { error "-e 값이 없습니다"; return 1; }
                notify_ttl=$2
                shift 2
                ;;
            *) error "알 수 없는 notify 옵션: $1"; return 1 ;;
        esac
    done
    if [ "$notify_as_set" -ne 1 ]; then
        error "notify에는 --as <watcher>가 필요합니다"
        return 1
    fi
    if ! valid_name "$notify_as"; then
        error "잘못된 watcher 이름: $notify_as"
        return 1
    fi
    if ! bounded_integer "$notify_ttl"; then
        error "만료 초는 0 이상 18자리 이하의 정수여야 합니다"
        return 1
    fi
    notify_ttl=$(normalize_integer "$notify_ttl")
    case "$notify_subject" in
        *'
'*|*'
'*) error "제목에는 줄바꿈을 넣을 수 없습니다"; return 1 ;;
    esac
    notify_body=$(mktemp "$TMP_DIR/notice-body.XXXXXX") || return 1
    if ! cat > "$notify_body"; then
        rm -f "$notify_body"
        error "notice 본문을 읽지 못했습니다"
        return 1
    fi
    notify_node=$(self_node) || { rm -f "$notify_body"; return 1; }
    notify_from=$notify_as@$notify_node
    notify_now=$(date +%s) || { rm -f "$notify_body"; return 1; }
    notify_expires=$((notify_now + notify_ttl))
    notify_marker=$KHALA_ROOT/presence/$notify_from.watcher
    notify_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$notify_lock" 300 notify; then
        rm -f "$notify_body"
        error "notify용 brain lock을 얻지 못했습니다"
        return 1
    fi
    notify_auto_declared=0
    notify_status=0
    if [ -f "$notify_marker" ]; then
        if ! read_watcher_marker "$notify_marker"; then
            error "$notify_marker: 잘못된 watcher marker"
            notify_status=1
        fi
    else
        WATCHER_L1=$notify_now
        WATCHER_L2=0
        WATCHER_L3=-
        WATCHER_L4=0
        WATCHER_L5=active
        WATCHER_L6=$notify_now
        notify_auto_declared=1
    fi
    if [ "$notify_status" -eq 0 ] && ! queue_notice "$notify_from" "$notify_to" \
        "$notify_urgency" "$notify_subject" "$notify_expires" "$notify_body"; then
        error "notice를 infrastructure spool에 넣지 못했습니다"
        notify_status=1
    fi
    if [ "$notify_status" -eq 0 ] && ! write_watcher_marker "$notify_marker" \
        "$WATCHER_L1" "$WATCHER_L2" "$WATCHER_L3" "$notify_now" "$WATCHER_L5" \
        "$WATCHER_L6"; then
        rm -f "$KHALA_ROOT/spool/for/${notify_to#*@}/$NOTICE_ID"
        error "$notify_marker: last-notify를 갱신하지 못했습니다"
        notify_status=1
    fi
    rm -f "$notify_body"
    if ! release_lock "$notify_lock"; then
        error "notify용 brain lock을 해제하지 못했습니다"
        return 1
    fi
    [ "$notify_status" -eq 0 ] || return 1
    if [ "$notify_auto_declared" -eq 1 ]; then
        printf 'khala notify: %s watcher를 cadence 0으로 자동 선언했습니다\n' "$notify_from" >&2
    fi
    # A notice for this node sits in spool/for/<self> where the link watcher
    # never looks (it only offers other nodes' spools), so nothing would run
    # reconcile until an unrelated event. Leave the brain's trigger file so its
    # 200 ms poll delivers the notice into the inbox now instead of later.
    if [ "${notify_to#*@}" = "$notify_node" ]; then
        notify_trigger_tmp=$(mktemp "$TMP_DIR/notify-trigger.XXXXXX") 2>/dev/null &&
            date +%s > "$notify_trigger_tmp" 2>/dev/null &&
            mv "$notify_trigger_tmp" "$KHALA_ROOT/run/reconcile.trigger" 2>/dev/null ||
            rm -f "${notify_trigger_tmp-}"
    fi
    printf '%s\n' "$NOTICE_ID"
    return 0
}

cmd_say() {
    require_config || return 1
    say_stream=khala
    if [ "$#" -gt 0 ]; then
        case "$1" in
            -*) ;;
            *) say_stream=$1; shift ;;
        esac
    fi
    if ! valid_name "$say_stream"; then
        error "잘못된 stream 이름: $say_stream"
        return 1
    fi
    say_subject=
    say_ref=
    say_body=
    say_body_set=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -s|--subject)
                [ "$#" -ge 2 ] || { error "$1 값이 없습니다"; return 1; }
                say_subject=$2
                shift 2
                ;;
            -r)
                [ "$#" -ge 2 ] || { error "-r 값이 없습니다"; return 1; }
                say_ref=$2
                shift 2
                ;;
            -m|--message|--body)
                [ "$#" -ge 2 ] || { error "$1 값이 없습니다"; return 1; }
                say_body=$2
                say_body_set=1
                shift 2
                ;;
            --*)
                error "알 수 없는 say 옵션: $1; 사용 가능: -s/--subject, -m/--message/--body, -r"
                return 1
                ;;
            *) error "알 수 없는 say 옵션: $1"; return 1 ;;
        esac
    done
    case "$say_subject" in
        *'
'*) error "제목에는 줄바꿈을 넣을 수 없습니다"; return 1 ;;
    esac
    if [ -n "$say_ref" ] && ! valid_message_id "$say_ref"; then
        error "잘못된 ref Id: $say_ref"
        return 1
    fi
    say_node=$(self_node) || return 1
    say_session=$(session_name "" 0) || return 1
    say_from=$say_session@$say_node
    say_date=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || return 1
    say_id=$(new_message_id "$say_from") || return 1
    say_tmp=$(mktemp "$TMP_DIR/stream-entry.XXXXXX") || return 1
    if ! {
        printf 'Khala: 0.1\n'
        printf 'Id: %s\n' "$say_id"
        printf 'From: %s\n' "$say_from"
        printf 'Stream: %s\n' "$say_stream"
        printf 'Date: %s\n' "$say_date"
        printf 'Type: entry\n'
        if [ -n "$say_ref" ]; then
            printf 'Refs: %s\n' "$say_ref"
        fi
        if [ -n "$say_subject" ]; then
            printf 'Subject: %s\n' "$say_subject"
        fi
        printf '\n'
        if [ "$say_body_set" -eq 1 ]; then
            printf '%s\n' "$say_body"
        else
            cat
        fi
    } > "$say_tmp"; then
        rm -f "$say_tmp"
        error "stream 항목을 쓰지 못했습니다"
        return 1
    fi
    say_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$say_lock" 300 say; then
        rm -f "$say_tmp"
        error "say용 brain lock을 얻지 못했습니다"
        return 1
    fi
    say_status=0
    say_shard=$KHALA_ROOT/streams/$say_stream/$say_node
    if ! heartbeat "$say_session"; then
        error "heartbeat를 갱신하지 못했습니다"
        say_status=1
    elif ! mkdir -p "$say_shard"; then
        error "$say_shard: stream shard를 만들지 못했습니다"
        say_status=1
    elif [ -e "$say_shard/$say_id" ]; then
        error "$say_id: 이미 존재하는 Id라 stream 항목을 덮어쓰지 않습니다"
        say_status=1
    elif ! mv "$say_tmp" "$say_shard/$say_id"; then
        error "$say_id: 자기 stream shard에 원자 안착시키지 못했습니다"
        say_status=1
    fi
    rm -f "$say_tmp"
    if ! release_lock "$say_lock"; then
        error "say용 brain lock을 해제하지 못했습니다"
        return 1
    fi
    [ "$say_status" -eq 0 ] || return 1
    printf '%s\n' "$say_id"
    return 0
}

cmd_join() {
    require_config || return 1
    [ "$#" -ge 1 ] || { usage; return 1; }
    join_stream=$1
    shift
    if ! valid_name "$join_stream"; then
        error "잘못된 stream 이름: $join_stream"
        return 1
    fi
    join_from_start=0
    join_state=joined
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --from-start) join_from_start=1 ;;
            --quiet) join_state=quiet ;;
            *) error "알 수 없는 join 옵션: $1"; return 1 ;;
        esac
        shift
    done
    join_session=$(session_name "" 0) || return 1
    join_now=$(date +%s) || return 1
    join_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$join_lock" 300 join; then
        error "join용 brain lock을 얻지 못했습니다"
        return 1
    fi
    join_status=0
    join_cursor=$KHALA_ROOT/cursor/$join_session/$join_stream
    if [ "$join_from_start" -eq 1 ]; then
        # AMBIGUOUS: D13 gives join files one epoch and no separate from-start
        # marker. Epoch zero is the literal start boundary without inventing a
        # second on-disk fact.
        join_boundary=0
        if ! rm -f "$join_cursor"; then
            join_status=1
        fi
    else
        join_boundary=$join_now
        if ! join_latest=$(latest_stream_id "$join_stream"); then
            join_status=1
        elif [ -n "$join_latest" ]; then
            if ! atomic_line "$join_cursor" "$join_latest" cursor; then
                join_status=1
            fi
        elif ! rm -f "$join_cursor"; then
            join_status=1
        fi
    fi
    if [ "$join_status" -eq 0 ] && ! atomic_line \
        "$KHALA_ROOT/join/$join_session/$join_stream" "$join_state $join_boundary" join; then
        join_status=1
    fi
    if ! release_lock "$join_lock"; then
        error "join용 brain lock을 해제하지 못했습니다"
        return 1
    fi
    if [ "$join_status" -ne 0 ]; then
        error "$join_stream: join 상태를 원자적으로 기록하지 못했습니다"
        return 1
    fi
    printf '%s %s\n' "$join_state" "$join_stream"
    return 0
}

cmd_leave() {
    require_config || return 1
    [ "$#" -eq 1 ] || { usage; return 1; }
    leave_stream=$1
    if ! valid_name "$leave_stream"; then
        error "잘못된 stream 이름: $leave_stream"
        return 1
    fi
    leave_session=$(session_name "" 0) || return 1
    leave_now=$(date +%s) || return 1
    leave_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$leave_lock" 300 leave; then
        error "leave용 brain lock을 얻지 못했습니다"
        return 1
    fi
    leave_status=0
    atomic_line "$KHALA_ROOT/join/$leave_session/$leave_stream" "left $leave_now" join || \
        leave_status=1
    if ! release_lock "$leave_lock"; then
        error "leave용 brain lock을 해제하지 못했습니다"
        return 1
    fi
    if [ "$leave_status" -ne 0 ]; then
        error "$leave_stream: leave 상태를 원자적으로 기록하지 못했습니다"
        return 1
    fi
    printf 'left %s\n' "$leave_stream"
    return 0
}

cmd_mind() {
    require_config || return 1
    mind_clear=0
    mind_focus=
    mind_focus_set=0
    mind_stance=
    mind_stance_set=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -m)
                [ "$#" -ge 2 ] || { error "-m 값이 없습니다"; return 1; }
                mind_focus=$2
                mind_focus_set=1
                shift 2
                ;;
            --stance)
                [ "$#" -ge 2 ] || { error "--stance 값이 없습니다"; return 1; }
                mind_stance=$2
                mind_stance_set=1
                shift 2
                ;;
            --clear)
                mind_clear=1
                shift
                ;;
            *) error "알 수 없는 mind 옵션: $1"; return 1 ;;
        esac
    done
    if [ "$mind_clear" -eq 1 ]; then
        if [ "$mind_focus_set" -eq 1 ] || [ "$mind_stance_set" -eq 1 ]; then
            error "mind --clear는 -m/--stance와 함께 쓸 수 없습니다"
            return 1
        fi
    elif [ "$mind_focus_set" -ne 1 ]; then
        error "mind에는 -m focus 또는 --clear가 필요합니다"
        return 1
    fi
    if [ "$mind_focus_set" -eq 1 ] && [ -z "$mind_focus" ]; then
        error "mind focus는 빈 줄일 수 없습니다; 철회하려면 --clear를 쓰세요"
        return 1
    fi
    if [ "$mind_stance_set" -eq 1 ] && [ -z "$mind_stance" ]; then
        error "mind stance는 빈 줄일 수 없습니다"
        return 1
    fi
    if ! valid_mind_value "$mind_focus" || ! valid_mind_value "$mind_stance"; then
        error "mind 필드는 한 줄이어야 합니다"
        return 1
    fi
    mind_session=$(session_name "" 0) || return 1
    mind_node=$(self_node) || return 1
    mind_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$mind_lock" 300 mind; then
        error "mind용 brain lock을 얻지 못했습니다"
        return 1
    fi
    reset_mind_update
    if [ "$mind_clear" -eq 1 ]; then
        MIND_SET_STATE=1
        MIND_STATE=cleared
        MIND_SET_FOCUS=1
        MIND_FOCUS=
        MIND_SET_STANCE=1
        MIND_STANCE=
    else
        MIND_SET_STATE=1
        MIND_STATE=active
        MIND_SET_FOCUS=1
        MIND_FOCUS=$mind_focus
        if [ "$mind_stance_set" -eq 1 ]; then
            MIND_SET_STANCE=1
            MIND_STANCE=$mind_stance
        fi
    fi
    mind_generation=$(write_mind_generation "$mind_session" "$mind_node")
    mind_status=$?
    if ! release_lock "$mind_lock"; then
        error "mind용 brain lock을 해제하지 못했습니다"
        return 1
    fi
    [ "$mind_status" -eq 0 ] || return 1
    printf '%s\n' "$mind_generation"
    return 0
}

cmd_profile() {
    require_config || return 1
    reset_mind_update
    profile_changed=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --model)
                [ "$#" -ge 2 ] || { error "--model 값이 없습니다"; return 1; }
                MIND_SET_MODEL=1
                MIND_MODEL=$2
                profile_changed=1
                shift 2
                ;;
            --effort)
                [ "$#" -ge 2 ] || { error "--effort 값이 없습니다"; return 1; }
                MIND_SET_EFFORT=1
                MIND_EFFORT=$2
                profile_changed=1
                shift 2
                ;;
            --role)
                [ "$#" -ge 2 ] || { error "--role 값이 없습니다"; return 1; }
                MIND_SET_ROLE=1
                MIND_ROLE=$2
                profile_changed=1
                shift 2
                ;;
            --charge)
                [ "$#" -ge 2 ] || { error "--charge 값이 없습니다"; return 1; }
                MIND_SET_CHARGE=1
                MIND_CHARGE=$2
                profile_changed=1
                shift 2
                ;;
            *) error "알 수 없는 profile 옵션: $1"; return 1 ;;
        esac
    done
    [ "$profile_changed" -eq 1 ] || {
        error "profile에는 --model/--effort/--role/--charge 중 하나가 필요합니다"
        return 1
    }
    for profile_value in "$MIND_MODEL" "$MIND_EFFORT" "$MIND_ROLE" "$MIND_CHARGE"; do
        if ! valid_mind_value "$profile_value"; then
            error "profile 필드는 한 줄이어야 합니다"
            return 1
        fi
    done
    profile_session=$(session_name "" 0) || return 1
    profile_node=$(self_node) || return 1
    profile_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$profile_lock" 300 profile; then
        error "profile용 brain lock을 얻지 못했습니다"
        return 1
    fi
    profile_generation=$(write_mind_generation "$profile_session" "$profile_node")
    profile_status=$?
    if ! release_lock "$profile_lock"; then
        error "profile용 brain lock을 해제하지 못했습니다"
        return 1
    fi
    [ "$profile_status" -eq 0 ] || return 1
    printf '%s\n' "$profile_generation"
    return 0
}

relative_age() {
    relative_declared=$1
    relative_now=$2
    if ! positive_or_zero_integer "$relative_declared" || [ "$relative_declared" -eq 0 ]; then
        printf '%s\n' '-'
        return 0
    fi
    if [ "$relative_declared" -gt "$relative_now" ]; then
        relative_seconds=0
    else
        relative_seconds=$((relative_now - relative_declared))
    fi
    if [ "$relative_seconds" -lt 60 ]; then
        printf '%ss\n' "$relative_seconds"
    elif [ "$relative_seconds" -lt 3600 ]; then
        printf '%sm\n' "$((relative_seconds / 60))"
    elif [ "$relative_seconds" -lt 86400 ]; then
        printf '%sh\n' "$((relative_seconds / 3600))"
    else
        printf '%sd\n' "$((relative_seconds / 86400))"
    fi
}

print_watcher_table() {
    watcher_table_mode=$1
    watcher_table_now=$(date +%s) || return 1
    printf 'NAME\tNODE\tOWNER\tCADENCE\tLAST\tSTATE\tSINCE\n'
    for watcher_table_file in "$KHALA_ROOT"/presence/*.watcher; do
        [ -f "$watcher_table_file" ] || continue
        watcher_table_address=$(basename "$watcher_table_file" .watcher)
        if ! valid_address "$watcher_table_address"; then
            error "$watcher_table_file: 잘못된 watcher marker 파일명"
            return 1
        fi
        if ! read_watcher_marker "$watcher_table_file"; then
            error "$watcher_table_file: 잘못된 watcher marker"
            return 1
        fi
        if [ "$watcher_table_mode" = active ] && [ "$WATCHER_RETIRED" -eq 1 ]; then
            continue
        fi
        watcher_table_name=${watcher_table_address%@*}
        watcher_table_node=${watcher_table_address#*@}
        watcher_table_last=$(relative_age "$WATCHER_LAST_NOTIFY" "$watcher_table_now")
        if [ "$WATCHER_RETIRED" -eq 1 ]; then
            watcher_table_state=retired
            watcher_table_since=$(relative_age "$WATCHER_DECLARED" "$watcher_table_now")
        else
            watcher_table_state=${WATCHER_L5%% *}
            watcher_table_since=$(relative_age "$WATCHER_STATE_SINCE" "$watcher_table_now")
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$watcher_table_name" "$watcher_table_node" \
            "$WATCHER_L3" "$WATCHER_CADENCE" "$watcher_table_last" \
            "$watcher_table_state" "$watcher_table_since"
    done
    return 0
}

have_active_watchers() {
    for watcher_active_file in "$KHALA_ROOT"/presence/*.watcher; do
        [ -f "$watcher_active_file" ] || continue
        if watcher_marker_non_retired "$watcher_active_file"; then
            return 0
        fi
    done
    return 1
}

print_watcher_section() {
    have_active_watchers || return 0
    printf '%s\n' 'watchers:'
    print_watcher_table active
}

cmd_watcher() {
    require_config || return 1
    [ "$#" -ge 1 ] || { usage watcher; return 1; }
    watcher_command=$1
    shift
    case "$watcher_command" in
        list)
            [ "$#" -eq 0 ] || { usage watcher; return 1; }
            print_watcher_table all
            return $?
            ;;
        declare)
            [ "$#" -ge 1 ] || { usage watcher; return 1; }
            watcher_name=$1
            shift
            if ! valid_name "$watcher_name"; then
                error "잘못된 watcher 이름: $watcher_name"
                return 1
            fi
            watcher_cadence=
            watcher_owner=
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --cadence)
                        [ "$#" -ge 2 ] || { error "--cadence 값이 없습니다"; return 1; }
                        watcher_cadence=$2
                        shift 2
                        ;;
                    --owner)
                        [ "$#" -ge 2 ] || { error "--owner 값이 없습니다"; return 1; }
                        watcher_owner=$2
                        shift 2
                        ;;
                    *) error "알 수 없는 watcher declare 옵션: $1"; return 1 ;;
                esac
            done
            if ! bounded_integer "$watcher_cadence"; then
                error "watcher cadence는 0 이상 18자리 이하의 정수여야 합니다"
                return 1
            fi
            if ! valid_address "$watcher_owner"; then
                if valid_name "$watcher_owner"; then
                    watcher_owner=$watcher_owner@$(self_node) || return 1
                else
                    error "잘못된 watcher owner: $watcher_owner (session@node)"
                    return 1
                fi
            fi
            watcher_cadence=$(normalize_integer "$watcher_cadence")
            watcher_node=$(self_node) || return 1
            watcher_marker=$KHALA_ROOT/presence/$watcher_name@$watcher_node.watcher
            watcher_now=$(date +%s) || return 1
            watcher_lock=$KHALA_ROOT/run/brain.lock.d
            if ! acquire_lock "$watcher_lock" 300 watcher-declare; then
                error "watcher declare용 brain lock을 얻지 못했습니다"
                return 1
            fi
            watcher_status=0
            if [ -f "$watcher_marker" ]; then
                if ! read_watcher_marker "$watcher_marker"; then
                    error "$watcher_marker: 잘못된 watcher marker"
                    watcher_status=1
                fi
            else
                WATCHER_L4=0
                WATCHER_L5=active
                WATCHER_L6=$watcher_now
            fi
            if [ "$watcher_status" -eq 0 ] && ! write_watcher_marker "$watcher_marker" \
                "$watcher_now" "$watcher_cadence" "$watcher_owner" \
                "$WATCHER_L4" "$WATCHER_L5" "$WATCHER_L6"; then
                error "$watcher_marker: watcher 선언을 기록하지 못했습니다"
                watcher_status=1
            fi
            if ! release_lock "$watcher_lock"; then
                error "watcher declare용 brain lock을 해제하지 못했습니다"
                return 1
            fi
            [ "$watcher_status" -eq 0 ] || return 1
            printf 'declared %s@%s\n' "$watcher_name" "$watcher_node"
            return 0
            ;;
        beat)
            [ "$#" -eq 1 ] || { usage watcher; return 1; }
            watcher_name=$1
            if ! valid_name "$watcher_name"; then
                error "잘못된 watcher 이름: $watcher_name"
                return 1
            fi
            watcher_node=$(self_node) || return 1
            watcher_marker=$KHALA_ROOT/presence/$watcher_name@$watcher_node.watcher
            watcher_lock=$KHALA_ROOT/run/brain.lock.d
            if ! acquire_lock "$watcher_lock" 300 watcher-beat; then
                error "watcher beat용 brain lock을 얻지 못했습니다"
                return 1
            fi
            watcher_status=0
            if [ ! -f "$watcher_marker" ]; then
                error "$watcher_name@$watcher_node: 선언된 watcher가 아닙니다"
                watcher_status=1
            elif ! read_watcher_marker "$watcher_marker"; then
                error "$watcher_marker: 잘못된 watcher marker"
                watcher_status=1
            elif [ "$WATCHER_RETIRED" -eq 1 ]; then
                error "$watcher_name@$watcher_node: retired watcher입니다"
                watcher_status=1
            else
                watcher_now=$(date +%s) || watcher_status=1
                if [ "$watcher_status" -eq 0 ] && ! write_watcher_marker "$watcher_marker" \
                    "$WATCHER_L1" "$WATCHER_L2" "$WATCHER_L3" "$watcher_now" \
                    "$WATCHER_L5" "$WATCHER_L6"; then
                    error "$watcher_marker: last-notify를 갱신하지 못했습니다"
                    watcher_status=1
                fi
            fi
            if ! release_lock "$watcher_lock"; then
                error "watcher beat용 brain lock을 해제하지 못했습니다"
                return 1
            fi
            [ "$watcher_status" -eq 0 ] || return 1
            printf 'beat %s@%s\n' "$watcher_name" "$watcher_node"
            return 0
            ;;
        retire)
            [ "$#" -eq 1 ] || { usage watcher; return 1; }
            watcher_name=$1
            if ! valid_name "$watcher_name"; then
                error "잘못된 watcher 이름: $watcher_name"
                return 1
            fi
            watcher_node=$(self_node) || return 1
            watcher_marker=$KHALA_ROOT/presence/$watcher_name@$watcher_node.watcher
            watcher_now=$(date +%s) || return 1
            watcher_lock=$KHALA_ROOT/run/brain.lock.d
            if ! acquire_lock "$watcher_lock" 300 watcher-retire; then
                error "watcher retire용 brain lock을 얻지 못했습니다"
                return 1
            fi
            watcher_status=0
            if [ ! -f "$watcher_marker" ]; then
                error "$watcher_name@$watcher_node: watcher marker가 없습니다"
                watcher_status=1
            elif ! read_watcher_marker "$watcher_marker"; then
                error "$watcher_marker: 잘못된 watcher marker"
                watcher_status=1
            elif ! write_watcher_marker "$watcher_marker" "retired $watcher_now" \
                "$WATCHER_L2" "$WATCHER_L3" "$WATCHER_L4" "$WATCHER_L5" \
                "$WATCHER_L6"; then
                error "$watcher_marker: watcher retire를 기록하지 못했습니다"
                watcher_status=1
            fi
            if ! release_lock "$watcher_lock"; then
                error "watcher retire용 brain lock을 해제하지 못했습니다"
                return 1
            fi
            [ "$watcher_status" -eq 0 ] || return 1
            printf 'retired %s@%s\n' "$watcher_name" "$watcher_node"
            return 0
            ;;
        *) error "알 수 없는 watcher 하위 명령: $watcher_command"; return 1 ;;
    esac
}

cmd_minds() {
    require_config || return 1
    [ "$#" -eq 0 ] || { usage; return 1; }
    minds_self=$(self_node) || return 1
    minds_ttl=$(sed -n 's/^ttl //p' "$CONFIG")
    [ -n "$minds_ttl" ] || minds_ttl=120
    positive_integer "$minds_ttl" || { error "config의 ttl이 양의 정수가 아닙니다"; return 1; }
    minds_ttl=$(normalize_integer "$minds_ttl")
    minds_now=$(date +%s) || return 1
    minds_addresses=$(mktemp "$TMP_DIR/minds-addresses.XXXXXX") || return 1
    minds_sorted=$(mktemp "$TMP_DIR/minds-sorted.XXXXXX") || {
        rm -f "$minds_addresses"
        return 1
    }
    : > "$minds_addresses"
    for minds_presence in "$KHALA_ROOT"/presence/*; do
        [ -f "$minds_presence" ] || continue
        minds_address=$(basename "$minds_presence")
        case "$minds_address" in
            *.watching) minds_address=${minds_address%.watching} ;;
        esac
        valid_address "$minds_address" && printf '%s\n' "$minds_address" >> "$minds_addresses"
    done
    for minds_session_dir in "$KHALA_ROOT"/minds/*/*; do
        [ -d "$minds_session_dir" ] || continue
        minds_node=$(basename "$(dirname "$minds_session_dir")")
        minds_session=$(basename "$minds_session_dir")
        if valid_name "$minds_node" && valid_name "$minds_session"; then
            printf '%s@%s\n' "$minds_session" "$minds_node" >> "$minds_addresses"
        fi
    done
    sort -u "$minds_addresses" > "$minds_sorted"
    printf 'ADDRESS\tSTATE\tWATCHING\tMODEL\tMODEL_AGE\tEFFORT\tEFFORT_AGE\tROLE\tROLE_AGE\tCHARGE\tCHARGE_AGE\tFOCUS\tFOCUS_AGE\tSTANCE\tSTANCE_AGE\tFRESHNESS\n'
    while IFS= read -r minds_address; do
        [ -n "$minds_address" ] || continue
        if watcher_marker_non_retired "$KHALA_ROOT/presence/$minds_address.watcher"; then
            continue
        fi
        minds_session=${minds_address%@*}
        minds_node=${minds_address#*@}
        minds_presence=$KHALA_ROOT/presence/$minds_address
        minds_presence_state=unknown
        minds_watching=$(watching_status "$minds_presence.watching" "$minds_now" "$minds_ttl")
        minds_retired=0
        if [ -f "$minds_presence" ]; then
            IFS=' ' read -r minds_first minds_second minds_extra < "$minds_presence"
            if [ "$minds_first" = retired ]; then
                minds_retired=1
            elif positive_or_zero_integer "$minds_first" && [ -z "${minds_second-}" ] && \
                [ -z "${minds_extra-}" ]; then
                minds_presence_epoch=$(normalize_integer "$minds_first")
                if [ "$((minds_now - minds_presence_epoch))" -le "$minds_ttl" ]; then
                    if [ "$minds_node" = "$minds_self" ]; then
                        minds_presence_state=alive-here
                    else
                        minds_presence_state=alive-elsewhere
                    fi
                else
                    minds_presence_state=asleep
                fi
            else
                error "$minds_presence: 잘못된 heartbeat"
                rm -f "$minds_addresses" "$minds_sorted"
                return 1
            fi
        fi
        [ "$minds_retired" -eq 0 ] || continue
        minds_current=$(current_mind_generation "$minds_node" "$minds_session") || {
            rm -f "$minds_addresses" "$minds_sorted"
            return 1
        }
        minds_model=-; minds_effort=-; minds_role=-; minds_charge=-
        minds_focus=-; minds_stance=-
        minds_model_age=-; minds_effort_age=-; minds_role_age=-; minds_charge_age=-
        minds_focus_age=-; minds_stance_age=-; minds_freshness=-
        if [ -n "$minds_current" ]; then
            minds_model=$(header_value Model "$minds_current"); [ -n "$minds_model" ] || minds_model=-
            minds_effort=$(header_value Effort "$minds_current"); [ -n "$minds_effort" ] || minds_effort=-
            minds_role=$(header_value Role "$minds_current"); [ -n "$minds_role" ] || minds_role=-
            minds_charge=$(header_value Charge "$minds_current"); [ -n "$minds_charge" ] || minds_charge=-
            minds_model_declared=$(header_value Declared-Model "$minds_current")
            minds_effort_declared=$(header_value Declared-Effort "$minds_current")
            minds_role_declared=$(header_value Declared-Role "$minds_current")
            minds_charge_declared=$(header_value Declared-Charge "$minds_current")
            minds_model_age=$(relative_age "$minds_model_declared" "$minds_now")
            minds_effort_age=$(relative_age "$minds_effort_declared" "$minds_now")
            minds_role_age=$(relative_age "$minds_role_declared" "$minds_now")
            minds_charge_age=$(relative_age "$minds_charge_declared" "$minds_now")
            if [ "$(header_value State "$minds_current")" = active ]; then
                minds_focus=$(header_value Focus "$minds_current"); [ -n "$minds_focus" ] || minds_focus=-
                minds_stance=$(header_value Stance "$minds_current"); [ -n "$minds_stance" ] || minds_stance=-
                minds_focus_declared=$(header_value Declared-Focus "$minds_current")
                minds_stance_declared=$(header_value Declared-Stance "$minds_current")
                minds_focus_age=$(relative_age "$minds_focus_declared" "$minds_now")
                minds_stance_age=$(relative_age "$minds_stance_declared" "$minds_now")
                if [ "$minds_focus_declared" -gt 0 ] && \
                    [ "$((minds_now - minds_focus_declared))" -gt "$MIND_FRESH_SECONDS" ]; then
                    minds_freshness=stale
                elif [ "$minds_focus_declared" -gt 0 ]; then
                    minds_freshness=fresh
                fi
            else
                minds_freshness=cleared
            fi
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$minds_address" "$minds_presence_state" "$minds_watching" \
            "$minds_model" "$minds_model_age" "$minds_effort" "$minds_effort_age" \
            "$minds_role" "$minds_role_age" "$minds_charge" "$minds_charge_age" \
            "$minds_focus" "$minds_focus_age" "$minds_stance" "$minds_stance_age" \
            "$minds_freshness"
    done < "$minds_sorted"
    rm -f "$minds_addresses" "$minds_sorted"
    return 0
}

cmd_retire() {
    require_config || return 1
    [ "$#" -eq 1 ] || { usage; return 1; }
    retire_wanted=$1
    retire_self=$(self_node) || return 1
    case "$retire_wanted" in
        *@*)
            if ! valid_address "$retire_wanted"; then
                error "잘못된 세션 명의: $retire_wanted"
                return 1
            fi
            retire_session=${retire_wanted%@*}
            retire_node=${retire_wanted#*@}
            if [ "$retire_node" != "$retire_self" ]; then
                error "타 노드 명의는 retire할 수 없습니다: $retire_wanted"
                return 1
            fi
            ;;
        *)
            retire_session=$retire_wanted
            if ! valid_name "$retire_session"; then
                error "잘못된 세션 이름: $retire_session"
                return 1
            fi
            ;;
    esac
    retire_now=$(date +%s) || return 1
    retire_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$retire_lock" 300 retire; then
        error "retire용 brain lock을 얻지 못했습니다"
        return 1
    fi
    retire_status=0
    atomic_line "$KHALA_ROOT/presence/$retire_session@$retire_self" \
        "retired $retire_now" heartbeat || retire_status=1
    reset_mind_update
    MIND_SET_STATE=1
    MIND_STATE=cleared
    MIND_SET_FOCUS=1
    MIND_FOCUS=
    MIND_SET_STANCE=1
    MIND_STANCE=
    if ! write_mind_generation "$retire_session" "$retire_self" >/dev/null; then
        retire_status=1
    fi
    if ! release_lock "$retire_lock"; then
        error "retire용 brain lock을 해제하지 못했습니다"
        return 1
    fi
    if [ "$retire_status" -ne 0 ]; then
        error "$retire_session@$retire_self: retire 상태를 기록하지 못했습니다"
        return 1
    fi
    printf 'retired %s@%s\n' "$retire_session" "$retire_self"
    return 0
}

cmd_streams() {
    require_config || return 1
    [ "$#" -eq 0 ] || { usage; return 1; }
    streams_session=$(session_name "" 0) || return 1
    streams_names=$(mktemp "$TMP_DIR/streams-names.XXXXXX") || return 1
    streams_sorted=$(mktemp "$TMP_DIR/streams-sorted.XXXXXX") || {
        rm -f "$streams_names"
        return 1
    }
    : > "$streams_names"
    for streams_dir in "$KHALA_ROOT"/streams/*; do
        [ -d "$streams_dir" ] || continue
        basename "$streams_dir" >> "$streams_names"
    done
    for streams_state_file in "$KHALA_ROOT/join/$streams_session"/*; do
        [ -f "$streams_state_file" ] || continue
        basename "$streams_state_file" >> "$streams_names"
    done
    sort -u "$streams_names" > "$streams_sorted"
    printf 'STREAM\tJOINED\tENTRIES\tLATEST\n'
    while IFS= read -r streams_name; do
        [ -n "$streams_name" ] || continue
        streams_state=-
        if [ -f "$KHALA_ROOT/join/$streams_session/$streams_name" ]; then
            streams_state=$(sed -n '1s/ .*//p' "$KHALA_ROOT/join/$streams_session/$streams_name")
        fi
        streams_list=$(mktemp "$TMP_DIR/streams-row.XXXXXX") || {
            rm -f "$streams_names" "$streams_sorted"
            return 1
        }
        if ! collect_stream_entries "$streams_name" "$streams_list"; then
            rm -f "$streams_names" "$streams_sorted" "$streams_list"
            return 1
        fi
        streams_count=$(wc -l < "$streams_list" | tr -d ' ')
        streams_latest=$(tail -n 1 "$streams_list" | cut -f 2)
        [ -n "$streams_latest" ] || streams_latest=-
        printf '%s\t%s\t%s\t%s\n' "$streams_name" "$streams_state" \
            "$streams_count" "$streams_latest"
        rm -f "$streams_list"
    done < "$streams_sorted"
    rm -f "$streams_names" "$streams_sorted"
    return 0
}

cmd_stream() {
    require_config || return 1
    [ "$#" -ge 2 ] || { usage; return 1; }
    [ "$1" = cat ] || { error "알 수 없는 stream 하위 명령: $1"; return 1; }
    shift
    cat_stream=$1
    shift
    if ! valid_name "$cat_stream"; then
        error "잘못된 stream 이름: $cat_stream"
        return 1
    fi
    cat_n=20
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -n)
                [ "$#" -ge 2 ] || { error "-n 값이 없습니다"; return 1; }
                cat_n=$2
                shift 2
                ;;
            *) error "알 수 없는 stream cat 옵션: $1"; return 1 ;;
        esac
    done
    if ! positive_or_zero_integer "$cat_n"; then
        error "stream cat 개수는 0 이상의 정수여야 합니다"
        return 1
    fi
    cat_n=$(normalize_integer "$cat_n")
    cat_list=$(mktemp "$TMP_DIR/stream-cat.XXXXXX") || return 1
    cat_selected=$(mktemp "$TMP_DIR/stream-cat-selected.XXXXXX") || {
        rm -f "$cat_list"
        return 1
    }
    if ! collect_cat_stream_entries "$cat_stream" "$cat_list" || \
        ! tail -n "$cat_n" "$cat_list" > "$cat_selected"; then
        rm -f "$cat_list" "$cat_selected"
        return 1
    fi
    while IFS="$TAB" read -r cat_epoch cat_id cat_path; do
        [ -n "${cat_epoch-}" ] || continue
        printf '%s\n' "--- stream $cat_stream $cat_id ---"
        if ! cat "$cat_path"; then
            rm -f "$cat_list" "$cat_selected"
            return 1
        fi
        printf '\n'
    done < "$cat_selected"
    rm -f "$cat_list" "$cat_selected"
    return 0
}

cmd_reconcile() {
    require_config || return 1
    if [ "$#" -ne 0 ]; then
        usage
        return 1
    fi
    SYNC_FAILED=0
    reconcile_cycle
}

cmd_sync() {
    require_config || return 1
    if [ "$#" -ne 0 ]; then
        usage
        return 1
    fi
    run_sync_cycles
}

cmd_link() {
    require_config || return 1
    if ! find_link_binary; then
        error "khala-link 바이너리가 없습니다; 예상 경로: $link_home_binary 또는 $link_sibling_binary"
        return 1
    fi
    link_script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd) || {
        error "bin/khala의 절대 경로를 확인하지 못했습니다"
        return 1
    }
    link_brain=$link_script_dir/$(basename "$0")

    export KHALA_BRAIN=$link_brain
    exec "$LINK_BINARY" "$@"
}

find_link_binary() {
    LINK_BINARY=
    link_script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd) || return 1
    link_home_binary=$KHALA_ROOT/bin/khala-link
    link_sibling_binary=$link_script_dir/khala-link
    if [ -x "$link_home_binary" ]; then
        LINK_BINARY=$link_home_binary
    elif [ -x "$link_sibling_binary" ]; then
        LINK_BINARY=$link_sibling_binary
    fi
    [ -n "$LINK_BINARY" ]
}

cmd_bind() {
    require_config || return 1
    find_link_binary || {
        error "khala bind에는 khala-link 바이너리가 필요합니다"
        return 1
    }
    if [ "$#" -ge 1 ] && [ "$1" = --register ]; then
        [ "$#" -ge 2 ] || { error "--register phase가 없습니다"; return 1; }
        bind_phase=$2
        shift 2
        bind_identity=$(session_name "" 0) || return 1
        bind_node=$(self_node) || return 1
        if watcher_marker_non_retired \
            "$KHALA_ROOT/presence/$bind_identity@$bind_node.watcher"; then
            error "$bind_identity@$bind_node: watcher 신원은 session runtime에 등록할 수 없습니다"
            return 1
        fi
        "$LINK_BINARY" runtime register --identity "$bind_identity" --phase "$bind_phase" \
            --caller-pid "$$" "$@"
        return $?
    fi
    if [ "$#" -ge 1 ] && [ "$1" = --release ]; then
        shift
        bind_identity=${KHALA_SESSION-}
        if [ -n "$bind_identity" ] && ! valid_name "$bind_identity"; then
            error "잘못된 세션 이름: $bind_identity"
            return 1
        fi
        "$LINK_BINARY" runtime release --identity "$bind_identity" --caller-pid "$$" "$@"
        return $?
    fi
    if [ "$#" -ge 1 ] && [ "$1" = --native-warning ]; then
        shift
        "$LINK_BINARY" runtime native-warning "$@"
        return $?
    fi
    bind_takeover=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --takeover) bind_takeover=1; shift ;;
            *) error "알 수 없는 bind 옵션: $1"; return 1 ;;
        esac
    done
    bind_identity=$(session_name "" 0) || return 1
    if [ "$bind_takeover" -eq 1 ]; then
        "$LINK_BINARY" runtime bind --identity "$bind_identity" --caller-pid "$$" --takeover
    else
        "$LINK_BINARY" runtime bind --identity "$bind_identity" --caller-pid "$$"
    fi
}

cmd_status() {
    require_config || return 1
    [ "$#" -eq 0 ] || { usage; return 1; }
    find_link_binary || {
        error "khala status의 conduit 상태에는 khala-link 바이너리가 필요합니다"
        return 1
    }
    "$LINK_BINARY" runtime status
}

node_accept_configured() {
    [ -n "${HOME-}" ] || return 1
    node_settings=$HOME/.claude/settings.json
    [ -f "$node_settings" ] || return 1
    grep -Eq '"crossSessionInbound"[[:space:]]*:[[:space:]]*"accept"' "$node_settings"
}

node_write_systemd_units() {
    node_unit_dir=$HOME/.config/systemd/user
    mkdir -p "$node_unit_dir" || return 1
    node_conduit_unit=$node_unit_dir/khala-conduit.service
    node_link_unit=$node_unit_dir/khala-link.service
    node_tmp=$(mktemp "$node_unit_dir/.khala-conduit.XXXXXX") || return 1
    if ! {
        printf '%s\n' '[Unit]' 'Description=Khala conduit doorbell' '' '[Service]' 'Type=simple'
        printf 'Environment="KHALA_HOME=%s"\n' "$KHALA_ROOT"
        if [ -n "${KHALA_RUNTIME_DIR-}" ]; then
            printf 'Environment="KHALA_RUNTIME_DIR=%s"\n' "$KHALA_RUNTIME_DIR"
        fi
        printf 'ExecStart="%s" conduit\n' "$LINK_BINARY"
        printf 'StandardOutput=append:%s\n' "$KHALA_ROOT/log/conduit.log"
        printf 'StandardError=append:%s\n' "$KHALA_ROOT/log/conduit.log"
        printf '%s\n' 'Restart=on-failure' '' '[Install]' 'WantedBy=default.target'
    } > "$node_tmp" || ! mv "$node_tmp" "$node_conduit_unit"; then
        rm -f "$node_tmp"
        return 1
    fi
    node_tmp=$(mktemp "$node_unit_dir/.khala-link.XXXXXX") || return 1
    if ! {
        printf '%s\n' '[Unit]' 'Description=Khala fleet link' '' '[Service]' 'Type=simple'
        printf 'Environment="KHALA_HOME=%s"\n' "$KHALA_ROOT"
        printf 'ExecStart="%s" link\n' "$KHALA_EXECUTABLE"
        printf '%s\n' 'Restart=on-failure' '' '[Install]' 'WantedBy=default.target'
    } > "$node_tmp" || ! mv "$node_tmp" "$node_link_unit"; then
        rm -f "$node_tmp"
        return 1
    fi
    systemctl --user daemon-reload >/dev/null 2>&1
}

node_write_launch_agents() {
    node_agent_dir=$HOME/Library/LaunchAgents
    mkdir -p "$node_agent_dir" || return 1
    node_conduit_plist=$node_agent_dir/dev.khala.conduit.plist
    node_tmp=$(mktemp "$node_agent_dir/.khala-conduit.XXXXXX") || return 1
    if ! {
        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' '<plist version="1.0"><dict>' '<key>Label</key><string>dev.khala.conduit</string>' '<key>ProgramArguments</key><array>'
        printf '<string>%s</string><string>conduit</string>\n' "$LINK_BINARY"
        printf '%s\n' '</array>'
        printf '<key>EnvironmentVariables</key><dict><key>KHALA_HOME</key><string>%s</string>\n' "$KHALA_ROOT"
        if [ -n "${KHALA_RUNTIME_DIR-}" ]; then
            printf '<key>KHALA_RUNTIME_DIR</key><string>%s</string>\n' "$KHALA_RUNTIME_DIR"
        fi
        printf '%s\n' '</dict>'
        printf '<key>StandardOutPath</key><string>%s</string>\n' "$KHALA_ROOT/log/conduit.log"
        printf '<key>StandardErrorPath</key><string>%s</string>\n' "$KHALA_ROOT/log/conduit.log"
        printf '%s\n' '<key>KeepAlive</key><true/><key>RunAtLoad</key><true/></dict></plist>'
    } > "$node_tmp" || ! mv "$node_tmp" "$node_conduit_plist"; then
        rm -f "$node_tmp"
        return 1
    fi
    node_link_plist=$node_agent_dir/dev.khala.link.plist
    node_tmp=$(mktemp "$node_agent_dir/.khala-link.XXXXXX") || return 1
    if ! {
        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' '<plist version="1.0"><dict>' '<key>Label</key><string>dev.khala.link</string>' '<key>ProgramArguments</key><array>'
        printf '<string>%s</string><string>link</string>\n' "$KHALA_EXECUTABLE"
        printf '%s\n' '</array>'
        printf '<key>EnvironmentVariables</key><dict><key>KHALA_HOME</key><string>%s</string></dict>\n' "$KHALA_ROOT"
        printf '%s\n' '<key>KeepAlive</key><true/><key>RunAtLoad</key><true/></dict></plist>'
    } > "$node_tmp" || ! mv "$node_tmp" "$node_link_plist"; then
        rm -f "$node_tmp"
        return 1
    fi
    return 0
}

node_start_detached() {
    node_daemon=$1
    node_log=$2
    case "$node_daemon" in
        conduit)
            setsid sh -c 'KHALA_HOME=$1; export KHALA_HOME; "$2" conduit </dev/null >>"$3" 2>&1 &' \
                sh "$KHALA_ROOT" "$LINK_BINARY" "$node_log" </dev/null >/dev/null 2>&1 &
            ;;
        link)
            setsid sh -c 'KHALA_HOME=$1; export KHALA_HOME; "$2" link </dev/null >>"$3" 2>&1 &' \
                sh "$KHALA_ROOT" "$KHALA_EXECUTABLE" "$node_log" </dev/null >/dev/null 2>&1 &
            ;;
    esac
}

cmd_node() {
    require_config || return 1
    [ "$#" -eq 1 ] && [ "$1" = ensure ] || { error "node 하위 명령은 ensure입니다"; return 1; }
    find_link_binary || {
        error "khala node ensure에는 khala-link 바이너리가 필요합니다"
        return 1
    }
    KHALA_EXECUTABLE=$(CDPATH= cd -- "$(dirname "$0")" && pwd)/$(basename "$0")
    mkdir -p "$KHALA_ROOT/log" || return 1
    node_started=
    node_conduit_live=0
    "$LINK_BINARY" runtime daemon-status >/dev/null 2>&1 && node_conduit_live=1
    node_link_live=0
    node_link_pid=$(sed -n 's/^pid \([0-9][0-9]*\)$/\1/p' "$KHALA_ROOT/run/link.status" 2>/dev/null)
    if positive_integer "$node_link_pid" && kill -0 "$node_link_pid" 2>/dev/null; then
        node_link_live=1
    fi
    # A mailbox node still needs the dial-side singleton when it has no remote
    # endpoint: that process is the sole owner of periodic local reconcile.
    node_need_link=1

    if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
        node_write_systemd_units || { error "systemd user unit 설치 실패"; return 1; }
        if [ "$node_conduit_live" -eq 0 ]; then
            systemctl --user enable --now khala-conduit.service >/dev/null 2>&1 || return 1
            node_started=conduit
        fi
        if [ "$node_need_link" -eq 1 ] && [ "$node_link_live" -eq 0 ]; then
            systemctl --user enable --now khala-link.service >/dev/null 2>&1 || return 1
            node_started=${node_started:+$node_started,}link
        fi
    elif [ "$(uname -s 2>/dev/null)" = Darwin ] && command -v launchctl >/dev/null 2>&1; then
        node_write_launch_agents || { error "LaunchAgent 설치 실패"; return 1; }
        if [ "$node_conduit_live" -eq 0 ]; then
            launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.khala.conduit.plist" >/dev/null 2>&1 || \
                launchctl kickstart -k "gui/$(id -u)/dev.khala.conduit" >/dev/null 2>&1 || return 1
            node_started=conduit
        fi
        if [ "$node_need_link" -eq 1 ] && [ "$node_link_live" -eq 0 ]; then
            launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.khala.link.plist" >/dev/null 2>&1 || \
                launchctl kickstart -k "gui/$(id -u)/dev.khala.link" >/dev/null 2>&1 || return 1
            node_started=${node_started:+$node_started,}link
        fi
    else
        command -v setsid >/dev/null 2>&1 || {
            error "systemd user bus나 LaunchAgent가 없고 setsid도 없습니다"
            return 1
        }
        if [ "$node_conduit_live" -eq 0 ]; then
            node_start_detached conduit "$KHALA_ROOT/log/conduit.log"
            node_started=conduit
        fi
        if [ "$node_need_link" -eq 1 ] && [ "$node_link_live" -eq 0 ]; then
            node_start_detached link "$KHALA_ROOT/log/link.log"
            node_started=${node_started:+$node_started,}link
        fi
    fi
    if [ -n "$node_started" ]; then
        printf 'khala: node ensure started %s\n' "$node_started"
    fi
    if ! node_accept_configured; then
        printf '%s\n' 'khala: crossSessionInbound가 accept가 아닙니다 — `claude config set crossSessionInbound accept` 또는 `/config`의 해당 행에서 accept로 설정하세요' >&2
    fi
    return 0
}

collect_watch_stream_rows() {
    watch_rows_session=$1
    watch_rows_output=$2
    : > "$watch_rows_output" || return 1
    for watch_rows_state_file in "$KHALA_ROOT/join/$watch_rows_session"/*; do
        [ -f "$watch_rows_state_file" ] || continue
        IFS=' ' read -r watch_rows_state watch_rows_epoch watch_rows_extra \
            < "$watch_rows_state_file"
        [ "$watch_rows_state" = joined ] || continue
        watch_rows_stream=$(basename "$watch_rows_state_file")
        watch_rows_unread=$(mktemp "$TMP_DIR/watch-stream.XXXXXX") || return 1
        if ! build_unread_stream_entries "$watch_rows_session" "$watch_rows_stream" \
            "$watch_rows_unread"; then
            rm -f "$watch_rows_unread"
            return 1
        fi
        while IFS="$TAB" read -r watch_rows_item_epoch watch_rows_id watch_rows_path; do
            [ -n "${watch_rows_item_epoch-}" ] || continue
            watch_rows_from=$(header_value From "$watch_rows_path")
            printf '%s\t%s\tstream:%s\n' "$watch_rows_id" "$watch_rows_from" \
                "$watch_rows_stream" >> "$watch_rows_output" || {
                rm -f "$watch_rows_unread"
                return 1
            }
        done < "$watch_rows_unread"
        rm -f "$watch_rows_unread"
    done
    return 0
}

cmd_watch() {
    require_config || return 1
    watch_session=
    watch_session_set=0
    watch_interval=30
    watch_max_wait=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --session)
                [ "$#" -ge 2 ] || { error "--session 값이 없습니다"; return 1; }
                watch_session=$2
                watch_session_set=1
                shift 2
                ;;
            --interval)
                [ "$#" -ge 2 ] || { error "--interval 값이 없습니다"; return 1; }
                watch_interval=$2
                shift 2
                ;;
            --max-wait)
                [ "$#" -ge 2 ] || { error "--max-wait 값이 없습니다"; return 1; }
                watch_max_wait=$2
                shift 2
                ;;
            *) error "알 수 없는 watch 옵션: $1"; return 1 ;;
        esac
    done
    if ! positive_integer "$watch_interval"; then
        error "watch 간격은 양의 정수여야 합니다"
        return 1
    fi
    if ! positive_or_zero_integer "$watch_max_wait"; then
        error "watch 최대 대기는 0 이상의 정수여야 합니다"
        return 1
    fi
    watch_interval=$(normalize_integer "$watch_interval")
    watch_max_wait=$(normalize_integer "$watch_max_wait")
    watch_session=$(session_name "$watch_session" "$watch_session_set") || return 1
    if find_link_binary; then
        watch_ready_error=$("$LINK_BINARY" runtime watch-ready --identity "$watch_session" \
            --instance "${KHALA_SESSION_INSTANCE-}" \
            --session-id "${KHALA_CLAUDE_SESSION_ID-${CLAUDE_CODE_SESSION_ID-}}" \
            --caller-pid "$$" 2>&1)
        if [ "$?" -eq 0 ]; then
            printf '%s\n' 'conduit has the ear'
            return 0
        fi
        case "$watch_ready_error" in
            *'conduit path unverified'*)
                printf '%s\n' 'watch: conduit path unverified; watching directly' >&2
                ;;
        esac
    fi
    watch_self=$(self_node) || {
        error "설정을 확인하거나 khala init 먼저 실행하세요."
        return 1
    }
    watch_mailboxes=$(sed -n 's/^mailbox //p' "$CONFIG")
    if [ -z "$watch_mailboxes" ]; then
        error "config의 mailbox 항목이 없습니다; khala init 먼저 실행하세요."
        return 1
    fi
    for watch_mailbox in $watch_mailboxes; do
        if ! valid_name "$watch_mailbox"; then
            error "config의 mailbox 항목이 잘못되었습니다; khala init 먼저 실행하세요."
            return 1
        fi
        watch_endpoints=$(sed -n "s/^peer $watch_mailbox //p" "$CONFIG")
        if [ -z "$watch_endpoints" ]; then
            error "mailbox의 peer 후보가 없습니다; khala init 먼저 실행하세요."
            return 1
        fi
    done
    watch_ttl=$(sed -n 's/^ttl //p' "$CONFIG")
    if [ -z "$watch_ttl" ]; then
        watch_ttl=120
    fi
    if ! positive_integer "$watch_ttl"; then
        error "config의 ttl이 양의 정수가 아닙니다"
        return 1
    fi
    watch_ttl=$(normalize_integer "$watch_ttl")
    watch_started=$(date +%s) || {
        error "현재 시각을 읽지 못했습니다"
        return 1
    }
    watch_inbox_dir=$KHALA_ROOT/inbox/$watch_session/new
    watch_marker=$KHALA_ROOT/presence/$watch_session@$watch_self.watching
    watch_lock=$KHALA_ROOT/run/watch.$watch_session.lock.d
    if acquire_watch_lock; then
        :
    else
        watch_lock_status=$?
        [ "$watch_lock_status" -ne 2 ] || return 0
        return 1
    fi
    trap 'watch_marker_cleanup EXIT' EXIT
    trap 'watch_marker_cleanup INT' INT
    trap 'watch_marker_cleanup TERM' TERM

    watch_marker_refreshed=0
    while :; do
        watch_now=$(date +%s) || {
            error "현재 시각을 읽지 못했습니다"
            return 1
        }
        # Marker refresh rides interval cadence, not loop cadence: in link
        # mode the loop runs at 1s and the nerve fans out every content
        # change fleet-wide (measured 1Hz presence noise, 57/60s). The
        # freshness rule (interval + ttl) needs one refresh per interval.
        if [ "$watch_marker_refreshed" -eq 0 ] || \
            [ "$((watch_now - watch_marker_refreshed))" -ge "$watch_interval" ]; then
            if refresh_watching_marker; then
                watch_marker_refreshed=$watch_now
            else
                error "$watch_marker: watching marker를 갱신하지 못했습니다; watch를 계속합니다"
            fi
        fi
        if ! refresh_watch_lock; then
            error "$watch_lock: watch lock owner를 갱신하지 못했습니다; watch를 계속합니다"
        fi
        watch_link_fresh=0
        watch_link_mtime=$(file_mtime "$KHALA_ROOT/run/link.fresh") || watch_link_mtime=
        if positive_or_zero_integer "$watch_link_mtime" && \
            [ "$watch_now" -ge "$watch_link_mtime" ] && \
            [ "$((watch_now - watch_link_mtime))" -lt "$TTL_LINK" ]; then
            watch_link_fresh=1
        fi
        if [ "$watch_link_fresh" -eq 1 ]; then
            SYNC_FAILED=0
            if ! reconcile_cycle; then
                error "reconcile 실패; watch를 계속합니다"
            fi
        elif ! run_sync_cycles; then
            error "sync 실패; watch를 계속합니다"
        fi

        watch_count=0
        for watch_file in "$watch_inbox_dir"/*; do
            [ -f "$watch_file" ] || continue
            watch_count=$((watch_count + 1))
        done
        watch_stream_rows=$(mktemp "$TMP_DIR/watch-rows.XXXXXX") || {
            error "watch stream 목록 임시 파일을 만들지 못했습니다"
            return 1
        }
        if ! collect_watch_stream_rows "$watch_session" "$watch_stream_rows"; then
            rm -f "$watch_stream_rows"
            error "watch stream 목록을 만들지 못했습니다"
            return 1
        fi
        watch_stream_count=$(wc -l < "$watch_stream_rows" | tr -d ' ')
        watch_total=$((watch_count + watch_stream_count))
        if [ "$watch_total" -gt 0 ]; then
            if [ "$watch_count" -gt 0 ]; then
                printf '%s\n' 'wake: delivery'
            else
                printf '%s\n' 'wake: stream'
            fi
            printf '%s\n' "$watch_total"
            for watch_file in "$watch_inbox_dir"/*; do
                [ -f "$watch_file" ] || continue
                watch_id=$(header_value Id "$watch_file")
                watch_from=$(header_value From "$watch_file")
                printf '%s\t%s\n' "$watch_id" "$watch_from"
            done
            cat "$watch_stream_rows"
            rm -f "$watch_stream_rows"
            return 0
        fi
        rm -f "$watch_stream_rows"

        if [ "$watch_link_fresh" -eq 1 ]; then
            watch_sleep=1
        else
            watch_sleep=$watch_interval
        fi
        if [ "$watch_max_wait" -gt 0 ]; then
            watch_now=$(date +%s) || {
                error "현재 시각을 읽지 못했습니다"
                return 1
            }
            watch_remaining=$((watch_max_wait - (watch_now - watch_started)))
            if [ "$watch_remaining" -le 0 ]; then
                error "기한 내 새 편지 없음"
                return 3
            fi
            if [ "$watch_remaining" -lt "$watch_sleep" ]; then
                watch_sleep=$watch_remaining
            fi
        fi
        sleep "$watch_sleep"
    done
}

cmd_inbox() {
    require_config || return 1
    inbox_mode=summary
    # AMBIGUOUS: §9.6 requires drain bounds but does not specify their defaults.
    max_n=20
    max_bytes=65536
    max_notices=10
    max_notice_bytes=16384
    inbox_drain_selection=all
    if [ "$#" -gt 0 ]; then
        case "$1" in
            --drain)
                inbox_mode=drain
                shift
                while [ "$#" -gt 0 ]; do
                    case "$1" in
                        --max-n)
                            [ "$#" -ge 2 ] || { error "--max-n 값이 없습니다"; return 1; }
                            max_n=$2
                            shift 2
                            ;;
                        --max-bytes)
                            [ "$#" -ge 2 ] || { error "--max-bytes 값이 없습니다"; return 1; }
                            max_bytes=$2
                            shift 2
                            ;;
                        --max-notices)
                            [ "$#" -ge 2 ] || { error "--max-notices 값이 없습니다"; return 1; }
                            max_notices=$2
                            shift 2
                            ;;
                        --max-notice-bytes)
                            [ "$#" -ge 2 ] || { error "--max-notice-bytes 값이 없습니다"; return 1; }
                            max_notice_bytes=$2
                            shift 2
                            ;;
                        --mail-only)
                            [ "$inbox_drain_selection" != notices ] || {
                                error "--mail-only와 --notices-only는 함께 쓸 수 없습니다"
                                return 1
                            }
                            inbox_drain_selection=mail
                            shift
                            ;;
                        --notices-only)
                            [ "$inbox_drain_selection" != mail ] || {
                                error "--mail-only와 --notices-only는 함께 쓸 수 없습니다"
                                return 1
                            }
                            inbox_drain_selection=notices
                            shift
                            ;;
                        *) error "알 수 없는 inbox 옵션: $1"; return 1 ;;
                    esac
                done
                ;;
            list)
                [ "$#" -eq 1 ] || { error "inbox list는 인자를 받지 않습니다"; return 1; }
                inbox_mode=list
                ;;
            read)
                [ "$#" -eq 2 ] || { error "사용법: khala inbox read <Id>"; return 1; }
                inbox_mode=read
                inbox_read_id=$2
                if ! valid_message_id "$inbox_read_id"; then
                    error "잘못된 편지 Id: $inbox_read_id"
                    return 1
                fi
                ;;
            *) error "알 수 없는 inbox 모드: $1; 사용 가능: list, read <Id>, --drain"; return 1 ;;
        esac
    fi
    if [ "$inbox_mode" = drain ] && \
        { ! positive_integer "$max_n" || ! positive_integer "$max_bytes" || \
        ! positive_integer "$max_notices" || ! positive_integer "$max_notice_bytes"; }; then
        error "drain 상한은 양의 정수여야 합니다"
        return 1
    fi
    if [ "$inbox_mode" = drain ]; then
        max_n=$(normalize_integer "$max_n")
        max_bytes=$(normalize_integer "$max_bytes")
        max_notices=$(normalize_integer "$max_notices")
        max_notice_bytes=$(normalize_integer "$max_notice_bytes")
    fi
    inbox_session=$(session_name "" 0) || return 1
    if ! heartbeat "$inbox_session"; then
        error "heartbeat를 갱신하지 못했습니다"
        return 1
    fi
    inbox_dir=$KHALA_ROOT/inbox/$inbox_session
    if ! mkdir -p "$inbox_dir/new" "$inbox_dir/cur"; then
        error "inbox 디렉터리를 만들지 못했습니다"
        return 1
    fi
    if [ "$inbox_mode" = summary ]; then
        for inbox_file in "$inbox_dir"/new/*; do
            [ -f "$inbox_file" ] || continue
            list_id=$(header_value Id "$inbox_file")
            list_from=$(header_value From "$inbox_file")
            list_type=$(header_value Type "$inbox_file")
            printf '%s\t%s\t%s\n' "$list_id" "$list_from" "$list_type"
        done
        return 0
    fi
    if [ "$inbox_mode" = list ]; then
        inbox_list_tmp=$(mktemp "$TMP_DIR/inbox-list.XXXXXX") || return 1
        for inbox_list_state in new cur; do
            : > "$inbox_list_tmp" || { rm -f "$inbox_list_tmp"; return 1; }
            for inbox_file in "$inbox_dir/$inbox_list_state"/*; do
                [ -f "$inbox_file" ] || continue
                list_id=$(header_value Id "$inbox_file")
                printf '%s\t%s\n' "${list_id%%.*}" "$inbox_file" >> "$inbox_list_tmp" || {
                    rm -f "$inbox_list_tmp"
                    return 1
                }
            done
            sort -n -k1,1 -k2,2 "$inbox_list_tmp" | \
                while IFS="$TAB" read -r list_epoch inbox_file; do
                    [ -n "${inbox_file-}" ] || continue
                    list_id=$(header_value Id "$inbox_file")
                    list_from=$(header_value From "$inbox_file")
                    list_subject=$(header_value Subject "$inbox_file")
                    list_date=$(header_value Date "$inbox_file")
                    printf '%s\t%s\t%s\t%s\n' "$list_id" "$list_from" \
                        "$list_subject" "$list_date"
                done || { rm -f "$inbox_list_tmp"; return 1; }
        done
        rm -f "$inbox_list_tmp"
        return 0
    fi
    if [ "$inbox_mode" = read ]; then
        if [ -f "$inbox_dir/cur/$inbox_read_id" ]; then
            inbox_read_file=$inbox_dir/cur/$inbox_read_id
        elif [ -f "$inbox_dir/new/$inbox_read_id" ]; then
            inbox_read_file=$inbox_dir/new/$inbox_read_id
        else
            error "$inbox_read_id: 편지를 찾지 못했습니다"
            return 1
        fi
        cat "$inbox_read_file"
        return $?
    fi
    inbox_lock=$KHALA_ROOT/run/brain.lock.d
    if ! acquire_lock "$inbox_lock" 300 inbox-drain; then
        error "inbox drain용 brain lock을 얻지 못했습니다"
        return 1
    fi
    inbox_drain_status=0
    trap '' PIPE
    if [ "$inbox_drain_selection" != notices ]; then
        # A drain prunes streams unconditionally so that it never prints or
        # advances the cursor over an entry retention would already have
        # removed; drains are rare compared with the link's reconcile passes.
        prune_stream_entries 1
    fi
    drained_n=0
    drained_bytes=0
    drained_letters=0
    drained_notices=0
    drained_notice_bytes=0
    drained_streams=0
    remaining_n=0
    remaining_senders=
    if [ "$inbox_drain_selection" != notices ]; then
        for inbox_file in "$inbox_dir"/new/*; do
            [ -f "$inbox_file" ] || continue
            [ "$(header_value Type "$inbox_file")" != notice ] || continue
            file_bytes=$(wc -c < "$inbox_file" | tr -d ' ')
            if [ "$drained_n" -lt "$max_n" ] && \
                [ "$((drained_bytes + file_bytes))" -le "$max_bytes" ]; then
                inbox_basename=$(basename "$inbox_file")
                inbox_cur_file=$inbox_dir/cur/$inbox_basename
                if ! mv "$inbox_file" "$inbox_cur_file"; then
                    error "$inbox_file: cur 이동에 실패했습니다"
                    inbox_drain_status=1
                    break
                fi
                touch "$inbox_cur_file" 2>/dev/null || :
                drained_n=$((drained_n + 1))
                drained_letters=$((drained_letters + 1))
                drained_bytes=$((drained_bytes + file_bytes))
                printf '%s\n' "--- letter $inbox_basename ---" 2>/dev/null || :
                cat "$inbox_cur_file" 2>/dev/null || :
                printf '\n' 2>/dev/null || :
            else
                remaining_n=$((remaining_n + 1))
                remaining_from=$(header_value From "$inbox_file")
                case " $remaining_senders " in
                    *" $remaining_from "*) ;;
                    *)
                        if [ -n "$remaining_senders" ]; then
                            remaining_senders="$remaining_senders, $remaining_from"
                        else
                            remaining_senders=$remaining_from
                        fi
                        ;;
                esac
            fi
        done
    fi
    if [ "$remaining_n" -gt 0 ]; then
        printf '%s건 더 (%s)\n' "$remaining_n" "$remaining_senders"
    fi
    notice_output=$(mktemp "$TMP_DIR/inbox-notices.XXXXXX") || inbox_drain_status=1
    notice_remaining_senders=$(mktemp "$TMP_DIR/inbox-notice-senders.XXXXXX") || \
        inbox_drain_status=1
    if [ "$inbox_drain_status" -eq 0 ]; then
        : > "$notice_output"
        : > "$notice_remaining_senders"
    fi
    notice_remaining_n=0
    if [ "$inbox_drain_status" -eq 0 ] && \
        [ "$inbox_drain_selection" != mail ]; then
        for inbox_file in "$inbox_dir"/new/*; do
            [ -f "$inbox_file" ] || continue
            [ "$(header_value Type "$inbox_file")" = notice ] || continue
            file_bytes=$(wc -c < "$inbox_file" | tr -d ' ')
            if [ "$drained_notices" -lt "$max_notices" ] && \
                [ "$((drained_notice_bytes + file_bytes))" -le "$max_notice_bytes" ]; then
                inbox_basename=$(basename "$inbox_file")
                inbox_cur_file=$inbox_dir/cur/$inbox_basename
                if ! mv "$inbox_file" "$inbox_cur_file"; then
                    error "$inbox_file: cur 이동에 실패했습니다"
                    inbox_drain_status=1
                    break
                fi
                touch "$inbox_cur_file" 2>/dev/null || :
                notice_from=$(header_value From "$inbox_cur_file")
                notice_subject=$(header_value Subject "$inbox_cur_file")
                notice_urgency=$(header_value Urgency "$inbox_cur_file")
                [ "$notice_urgency" = info ] || notice_urgency=urgent
                if ! {
                    printf '%s\n' "--- notice $inbox_basename --- $notice_from · $notice_urgency · $notice_subject"
                    cat "$inbox_cur_file"
                    printf '\n'
                } >> "$notice_output"; then
                    error "$inbox_cur_file: notice 출력 준비에 실패했습니다"
                    inbox_drain_status=1
                    break
                fi
                drained_notices=$((drained_notices + 1))
                drained_notice_bytes=$((drained_notice_bytes + file_bytes))
            else
                notice_remaining_n=$((notice_remaining_n + 1))
                notice_remaining_from=$(header_value From "$inbox_file")
                printf '%s\n' "$notice_remaining_from" >> "$notice_remaining_senders"
            fi
        done
    fi
    if [ "$drained_notices" -gt 0 ]; then
        printf '=== notices (%s) ===\n' "$drained_notices"
        cat "$notice_output"
    fi
    if [ "$notice_remaining_n" -gt 0 ]; then
        notice_remaining_groups=$(sort "$notice_remaining_senders" | uniq -c | \
            sort -k1,1nr -k2,2 | awk '{ if (shown++) printf ", "; printf "%s %s", $2, $1 }')
        printf '알림 %s건 더 (%s)\n' "$notice_remaining_n" "$notice_remaining_groups"
    fi
    rm -f "${notice_output-}" "${notice_remaining_senders-}"
    inbox_retain_days=$(retain_days) || inbox_drain_status=1
    inbox_now=$(date +%s) || inbox_drain_status=1
    if [ "$inbox_drain_status" -eq 0 ] && \
        [ "$inbox_drain_selection" != notices ]; then
        inbox_retain_seconds=$((inbox_retain_days * 86400))
        for inbox_join_file in "$KHALA_ROOT/join/$inbox_session"/*; do
            [ -f "$inbox_join_file" ] || continue
            inbox_stream=$(basename "$inbox_join_file")
            IFS=' ' read -r inbox_join_state inbox_join_epoch inbox_join_extra \
                < "$inbox_join_file"
            case "$inbox_join_state" in
                joined|quiet) ;;
                *) continue ;;
            esac
            if ! positive_or_zero_integer "$inbox_join_epoch" || \
                [ -n "${inbox_join_extra-}" ]; then
                error "$inbox_join_file: 잘못된 join 상태"
                inbox_drain_status=1
                break
            fi
            inbox_cursor_file=$KHALA_ROOT/cursor/$inbox_session/$inbox_stream
            if [ -f "$inbox_cursor_file" ]; then
                inbox_cursor_id=$(sed -n '1p' "$inbox_cursor_file")
                if ! valid_message_id "$inbox_cursor_id"; then
                    error "$inbox_cursor_file: 잘못된 stream cursor"
                    inbox_drain_status=1
                    break
                fi
                inbox_cursor_epoch=$(normalize_integer "${inbox_cursor_id%%.*}")
                if [ "$((inbox_cursor_epoch + inbox_retain_seconds))" -lt "$inbox_now" ]; then
                    printf 'stream %s: 커서 이전 항목들이 retention을 지나 소멸했습니다\n' \
                        "$inbox_stream"
                fi
            fi
            inbox_unread=$(mktemp "$TMP_DIR/inbox-stream.XXXXXX") || {
                inbox_drain_status=1
                break
            }
            if ! build_unread_stream_entries "$inbox_session" "$inbox_stream" "$inbox_unread"; then
                rm -f "$inbox_unread"
                inbox_drain_status=1
                break
            fi
            inbox_stream_remaining=0
            while IFS="$TAB" read -r inbox_stream_epoch inbox_stream_id inbox_stream_path; do
                [ -n "${inbox_stream_epoch-}" ] || continue
                file_bytes=$(wc -c < "$inbox_stream_path" | tr -d ' ')
                if [ "$drained_n" -lt "$max_n" ] && \
                    [ "$((drained_bytes + file_bytes))" -le "$max_bytes" ]; then
                    printf '%s\n' "--- stream $inbox_stream $inbox_stream_id ---"
                    if ! cat "$inbox_stream_path"; then
                        error "$inbox_stream_path: 읽기에 실패했습니다"
                        inbox_drain_status=1
                        break
                    fi
                    printf '\n'
                    if ! atomic_line "$inbox_cursor_file" "$inbox_stream_id" cursor; then
                        error "$inbox_cursor_file: stream cursor 전진에 실패했습니다"
                        inbox_drain_status=1
                        break
                    fi
                    drained_n=$((drained_n + 1))
                    drained_streams=$((drained_streams + 1))
                    drained_bytes=$((drained_bytes + file_bytes))
                else
                    inbox_stream_remaining=$((inbox_stream_remaining + 1))
                fi
            done < "$inbox_unread"
            rm -f "$inbox_unread"
            if [ "$inbox_stream_remaining" -gt 0 ]; then
                printf 'stream %s: %s건 더\n' "$inbox_stream" "$inbox_stream_remaining"
            fi
            [ "$inbox_drain_status" -eq 0 ] || break
        done
    fi
    if ! release_lock "$inbox_lock"; then
        trap - PIPE
        error "inbox drain용 brain lock을 해제하지 못했습니다"
        return 1
    fi
    trap - PIPE
    printf 'drained: letters %s, notices %s, streams %s\n' \
        "$drained_letters" "$drained_notices" "$drained_streams"
    return "$inbox_drain_status"
}

cmd_presence() {
    require_config || return 1
    presence_watchers_only=0
    if [ "$#" -eq 1 ] && [ "$1" = --watchers ]; then
        presence_watchers_only=1
    elif [ "$#" -ne 0 ]; then
        usage
        return 1
    fi
    if [ "$presence_watchers_only" -eq 1 ]; then
        print_watcher_section
        return $?
    fi
    presence_self=$(self_node) || return 1
    presence_ttl=$(sed -n 's/^ttl //p' "$CONFIG")
    if [ -z "$presence_ttl" ]; then
        presence_ttl=120
    fi
    if ! positive_integer "$presence_ttl"; then
        error "config의 ttl이 양의 정수가 아닙니다"
        return 1
    fi
    presence_ttl=$(normalize_integer "$presence_ttl")
    presence_now=$(date +%s) || return 1
    printf 'ADDRESS\tSTATE\tLAST_SEEN\tWATCHING\n'
    for presence_file in "$KHALA_ROOT"/presence/*; do
        [ -f "$presence_file" ] || continue
        presence_address=$(basename "$presence_file")
        case "$presence_address" in
            *.watching|*.watcher) continue ;;
        esac
        if ! valid_address "$presence_address"; then
            error "$presence_file: 잘못된 heartbeat 파일명"
            return 1
        fi
        if watcher_marker_non_retired "$presence_file.watcher"; then
            continue
        fi
        presence_session=${presence_address%@*}
        presence_node=${presence_address#*@}
        IFS=' ' read -r presence_first presence_second presence_extra < "$presence_file"
        if [ "$presence_first" = retired ]; then
            if ! positive_or_zero_integer "$presence_second" || [ -n "${presence_extra-}" ]; then
                error "$presence_file: 잘못된 retired heartbeat"
                return 1
            fi
            continue
        fi
        presence_epoch=$presence_first
        if ! positive_or_zero_integer "$presence_epoch" || \
            [ -n "${presence_second-}" ] || [ -n "${presence_extra-}" ]; then
            error "$presence_file: 잘못된 heartbeat"
            return 1
        fi
        presence_epoch=$(normalize_integer "$presence_epoch")
        if [ "$((presence_now - presence_epoch))" -le "$presence_ttl" ]; then
            if [ "$presence_node" = "$presence_self" ]; then
                presence_state=alive-here
            else
                presence_state=alive-elsewhere
            fi
        else
            presence_state=asleep
        fi
        presence_watching=$(watching_status "$presence_file.watching" \
            "$presence_now" "$presence_ttl")
        printf '%s@%s\t%s\t%s\t%s\n' "$presence_session" "$presence_node" \
            "$presence_state" "$presence_epoch" "$presence_watching"
    done
    for presence_marker in "$KHALA_ROOT"/presence/*.watching; do
        [ -f "$presence_marker" ] || continue
        presence_address=$(basename "$presence_marker" .watching)
        if ! valid_address "$presence_address"; then
            error "$presence_marker: 잘못된 watching marker 파일명"
            continue
        fi
        if watcher_marker_non_retired \
            "$KHALA_ROOT/presence/$presence_address.watcher"; then
            continue
        fi
        [ ! -f "$KHALA_ROOT/presence/$presence_address" ] || continue
        presence_watching=$(watching_status "$presence_marker" \
            "$presence_now" "$presence_ttl")
        printf '%s\tunknown\t-\t%s\n' "$presence_address" "$presence_watching"
    done
    printf '%s\n' 'asleep = 칼라 활동 없음 (세션 죽음 아님); watching = 귀 열림 (armed watch)'
    print_watcher_section
    return 0
}

if [ "$#" -lt 1 ]; then
    usage
    exit 1
fi

command_name=$1
shift
case "$command_name" in
    version|init|invite|send|notify|say|join|leave|streams|stream|mind|profile|minds|watcher|retire|reconcile|sync|link|watch|inbox|presence)
        if [ "$#" -eq 1 ] && [ "$1" = --help ]; then
            usage "$command_name"
            exit 0
        fi
        ;;
    --help|-h)
        [ "$#" -eq 0 ] || { usage; exit 1; }
        usage 2>&1
        exit 0
        ;;
esac
case "$command_name" in
    version)
        [ "$#" -eq 0 ] || { usage; exit 1; }
        printf 'khala %s\n' "$KHALA_VERSION"
        ;;
    init) cmd_init "$@" ;;
    invite) cmd_invite "$@" ;;
    send) cmd_send "$@" ;;
    notify) cmd_notify "$@" ;;
    say) cmd_say "$@" ;;
    join) cmd_join "$@" ;;
    leave) cmd_leave "$@" ;;
    streams) cmd_streams "$@" ;;
    stream) cmd_stream "$@" ;;
    mind) cmd_mind "$@" ;;
    profile) cmd_profile "$@" ;;
    minds) cmd_minds "$@" ;;
    watcher) cmd_watcher "$@" ;;
    retire) cmd_retire "$@" ;;
    reconcile) cmd_reconcile "$@" ;;
    sync) cmd_sync "$@" ;;
    link) cmd_link "$@" ;;
    node) cmd_node "$@" ;;
    bind) cmd_bind "$@" ;;
    status) cmd_status "$@" ;;
    watch) cmd_watch "$@" ;;
    inbox) cmd_inbox "$@" ;;
    presence) cmd_presence "$@" ;;
    *) usage; exit 1 ;;
esac
